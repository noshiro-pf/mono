{
  "name": "@noshiro/syncflow-react-hooks",
  "version": "1.0.3",
  "private": false,
  "license": "MIT",
  "author": "noshiro-pf <noshiro.pf@gmail.com>",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./esm/index.d.mts",
        "default": "./esm/index.mjs"
      }
    }
  },
  "files": [
    "src",
    "esm"
  ],
  "scripts": {
    "build": "wireit",
    "build:script": "tsc -p ./configs/tsconfig.scripts.json",
    "clean": "run-p clean:**",
    "clean:build": "rimraf esm",
    "clean:wireit": "rimraf .wireit/**",
    "fmt": "pnpm run zz:prettier .",
    "gen:re-export": "wireit",
    "gen:re-export:fmt": "pnpm run zz:prettier src/syncflow.mts",
    "gen:re-export:script": "zx ./scripts/generate-re-export-script.mjs",
    "gi": "bash ../../../scripts/bash/index_ts_generator.sh ./src --min-depth 0 --ext .mts",
    "lint": "pnpm run zz:eslint:src",
    "lint:fix": "pnpm run zz:eslint:src --fix",
    "pub": "pnpm run zz:publish",
    "test": "pnpm run zz:vitest run",
    "testw": "pnpm run zz:vitest watch",
    "tsc": "pnpm run type-check",
    "tscw": "tsc --noEmit --watch",
    "type-check": "tsc --noEmit",
    "zz:eslint": "ESLINT_USE_FLAT_CONFIG=true TIMING=1 eslint",
    "zz:eslint:print-config": "pnpm run zz:eslint --print-config src/index.mts",
    "zz:eslint:src": "pnpm run zz:eslint --config eslint.config.js './src/**/*'",
    "zz:prettier": "prettier --cache --cache-strategy content --ignore-path ../../../.prettierignore --write",
    "zz:publish": "pnpm publish --access public --no-git-checks",
    "zz:vitest": "vitest --config ./configs/vitest.config.ts"
  },
  "dependencies": {
    "@noshiro/react-utils": "*",
    "@noshiro/syncflow": "*",
    "@noshiro/ts-utils": "*",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@noshiro/eslint-configs": "*",
    "@noshiro/mono-utils": "*",
    "@noshiro/ts-type-utils": "*"
  },
  "peerDependencies": {
    "react": "^18.2.0"
  },
  "wireit": {
    "pre-build": {
      "command": "run-s clean:build gi type-check gen:re-export"
    },
    "build": {
      "dependencies": [
        "pre-build"
      ],
      "command": "rollup --config ./configs/rollup.config.ts --configPlugin typescript --configImportAttributesKey with"
    },
    "gen:re-export": {
      "command": "run-s build:script gen:re-export:script gen:re-export:fmt"
    }
  }
}
