{
  "name": "@noshiro/template-ts-playground",
  "version": "1.0.0",
  "private": false,
  "license": "MIT",
  "author": "noshiro-pf <noshiro.pf@gmail.com>",
  "sideEffects": true,
  "type": "module",
  "scripts": {
    "build": "wireit",
    "clean": "run-p clean:**",
    "clean:build": "rimraf esm",
    "clean:wireit": "rimraf .wireit/**",
    "fmt": "pnpm run zz:prettier .",
    "lint": "pnpm run zz:eslint:src",
    "lint:fix": "pnpm run zz:eslint:src --fix",
    "start": "wireit",
    "test": "pnpm run zz:vitest run",
    "testw": "pnpm run zz:vitest watch",
    "tsc": "pnpm run type-check",
    "tscw": "tsc --noEmit --watch",
    "type-check": "tsc --noEmit",
    "zz:eslint": "ESLINT_USE_FLAT_CONFIG=true TIMING=1 eslint",
    "zz:eslint:print-config": "pnpm run zz:eslint --print-config src/index.mts",
    "zz:eslint:src": "pnpm run zz:eslint --config eslint.config.js './src/**/*'",
    "zz:prettier": "prettier --cache --cache-strategy content --ignore-path ../../../.prettierignore --write",
    "zz:vitest": "vitest --config ./configs/vitest.config.ts"
  },
  "dependencies": {
    "@noshiro/ts-utils": "*"
  },
  "devDependencies": {
    "@noshiro/eslint-configs": "*",
    "@noshiro/mono-utils": "*",
    "@noshiro/ts-type-utils": "*"
  },
  "wireit": {
    "pre-build": {
      "command": "run-s clean:build type-check"
    },
    "build": {
      "dependencies": [
        "pre-build"
      ],
      "command": "rollup --config ./configs/rollup.config.ts --configPlugin typescript --configImportAttributesKey with"
    },
    "start": {
      "dependencies": [
        "build"
      ],
      "command": "node ./esm/index.mjs"
    }
  }
}
