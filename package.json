{
  "name": "mono",
  "version": "0.0.0",
  "private": true,
  "description": "monorepo for TypeScript projects",
  "keywords": [
    "typescript",
    "monorepo"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/noshiro-pf/mono.git"
  },
  "license": "Apache-2.0",
  "author": "noshiro-pf <noshiro.pf@gmail.com>",
  "sideEffects": false,
  "type": "module",
  "workspaces": [
    "libs/*",
    "apps/*",
    "tools/*",
    "strict-lib/scripts-common",
    "strict-lib/v*",
    "strict-lib/v*/output/lib"
  ],
  "scripts": {
    "build:pages-site": "tsx --tsconfig ./tools/configs/tsconfig.tsx.json ./tools/scripts/cmd/build-pages-site.mts",
    "changeset:publish": "pnpm run ws:build && pnpm changeset publish",
    "changeset:version-packages": "pnpm changeset version && pnpm run strict-lib:fmt && pnpm run strict-lib:gen:packages && pnpm install --no-frozen-lockfile",
    "check:root": "pnpm run '/check:root:.*/'",
    "check:root:lint": "pnpm run z:eslint ./tools/{scripts,configs}/**/*.mts --fix",
    "check:root:lockfile": "tsx --tsconfig ./tools/configs/tsconfig.tsx.json ./tools/scripts/cmd/check-lockfile-tarballs.mts",
    "check:root:strict-lib-links": "tsx --tsconfig ./tools/configs/tsconfig.tsx.json ./tools/scripts/cmd/check-strict-lib-links.mts",
    "check:root:type": "tsc -p ./tsconfig.json --noEmit",
    "check-all": "tsx --tsconfig ./tools/configs/tsconfig.tsx.json ./tools/scripts/cmd/check-all.mts",
    "clean:node_modules": "find . -name 'node_modules' -type d -prune -exec rm -rf '{}' +",
    "codemod": "pnpm run z:ts-codemod --uncommitted --transformer append-as-const --transformer convert-to-readonly '{libs,apps,tools}/*/{src,scripts,samples,test}/**/*.{ts,mts,tsx}' --exclude 'libs/ts-type-forge/{src,samples,scripts}/**' --exclude 'libs/eslint-plugin-ts-type-forge/{src,samples}/**' && pnpm run fmt",
    "codemod:diff": "pnpm run z:ts-codemod --diff-from origin/main --transformer append-as-const --transformer convert-to-readonly '{libs,apps,tools}/*/{src,scripts,samples,test}/**/*.{ts,mts,tsx}' --exclude 'libs/ts-type-forge/{src,samples,scripts}/**' --exclude 'libs/eslint-plugin-ts-type-forge/{src,samples}/**' && pnpm run fmt",
    "codemod:full": "pnpm run z:ts-codemod --transformer append-as-const --transformer convert-to-readonly '{libs,apps,tools}/*/{src,scripts,samples,test}/**/*.{ts,mts,tsx}' --exclude 'libs/ts-type-forge/{src,samples,scripts}/**' --exclude 'libs/eslint-plugin-ts-type-forge/{src,samples}/**' && pnpm run fmt",
    "coverage:normalize-paths": "tsx --tsconfig ./tools/configs/tsconfig.tsx.json ./tools/scripts/cmd/normalize-coverage-paths.mts",
    "cspell": "cspell \"{**,.changeset/**/*,.github/**/*}\" --gitignore --gitignore-root ./ --no-progress",
    "docs:deps": "tsx --tsconfig ./tools/configs/tsconfig.tsx.json ./tools/scripts/cmd/gen-dependency-graph.mts",
    "fmt": "pnpm run z:format-uncommitted",
    "fmt:diff": "pnpm run z:format-diff-from origin/main",
    "fmt:full": "prettier --ignore-unknown --no-error-on-unmatched-pattern --write .",
    "knip": "knip --no-progress --no-config-hints --include dependencies,unlisted,binaries,unresolved,catalog,catalogReferences",
    "lint:published-deps": "pnpm run z:eslint --config ./tools/configs/eslint.published-deps.mts --no-config-lookup '{libs,apps}/*/src/**/*.{mts,ts,tsx}' './eslint.config.mts' '{libs,apps}/*/eslint.config.mts' --quiet",
    "md": "markdownlint-cli2",
    "prepare": "pnpm run z:link-strict-lib",
    "repo-settings:apply": "pnpm run z:repo-settings apply",
    "repo-settings:backup": "pnpm run z:repo-settings backup",
    "strict-lib:fmt": "oxfmt --ignore-path=./.gitignore --ignore-path=./strict-lib/.oxfmtignore --config=./strict-lib/.oxfmtrc.json ./strict-lib",
    "strict-lib:gen": "tsx --tsconfig \"$PWD/tools/configs/tsconfig.tsx.json\" ./strict-lib/scripts/cmd/ws-gen-stages.mts",
    "strict-lib:gen:full": "tsx --tsconfig \"$PWD/tools/configs/tsconfig.tsx.json\" ./strict-lib/scripts/cmd/ws-gen-full-stages.mts",
    "strict-lib:gen:packages": "tsx --tsconfig \"$PWD/tools/configs/tsconfig.tsx.json\" ./strict-lib/scripts/cmd/ws-gen-packages-stages.mts",
    "strict-lib:gen:version-diff": "tsx --tsconfig \"$PWD/tools/configs/tsconfig.tsx.json\" ./strict-lib/scripts/cmd/gen-version-diff.mts",
    "strict-lib:gen:with-codemod-fixed": "tsx --tsconfig \"$PWD/tools/configs/tsconfig.tsx.json\" ./strict-lib/scripts/cmd/ws-gen-with-codemod-fixed-stages.mts",
    "strict-lib:lint": "pnpm run z:eslint --config ./strict-lib/eslint.config.mts './strict-lib/**/*.mts'",
    "strict-lib:publish": "tsx --tsconfig \"$PWD/tools/configs/tsconfig.tsx.json\" ./strict-lib/scripts/cmd/dist-npm-publish.mts",
    "strict-lib:type-check": "tsc -p ./strict-lib/tsconfig.tooling.json --noEmit",
    "update-actions": "pnpm update --recursive --include-github-actions \"*/*\"",
    "update-packages": "pnpm update --latest --recursive --filter '!./strict-lib/v*/output/lib'",
    "verify:npm-packages": "tsx --tsconfig ./tools/configs/tsconfig.tsx.json ./tools/scripts/cmd/verify-npm-packages.mts",
    "verify:npm-packages:published": "pnpm run verify:npm-packages --published",
    "verify:npm-packages:published:update": "pnpm run verify:npm-packages --published --update",
    "ws:build": "tsx --tsconfig ./tools/configs/tsconfig.tsx.json ./tools/scripts/cmd/ws-build-stages.mts",
    "ws:build:min": "tsx --tsconfig ./tools/configs/tsconfig.tsx.json ./tools/scripts/cmd/ws-build-min-stages.mts",
    "ws:check:ext": "pnpm run --recursive --if-present check:ext",
    "ws:doc": "pnpm run --recursive --workspace-concurrency=1 --if-present doc",
    "ws:doc:embed": "pnpm run --recursive --workspace-concurrency=1 --if-present doc:embed",
    "ws:doc:embed:jsdoc": "pnpm run --recursive --workspace-concurrency=1 --if-present doc:embed:jsdoc",
    "ws:gi": "pnpm run --recursive --workspace-concurrency=1 --if-present gi",
    "ws:lint": "pnpm run --recursive --if-present lint",
    "ws:lint:fix": "pnpm run --recursive --if-present lint:fix",
    "ws:test": "pnpm run --recursive --workspace-concurrency=1 --if-present test",
    "ws:test:browser": "pnpm run --recursive --workspace-concurrency=1 --if-present test:browser",
    "ws:test:cov": "run-s ws:test:cov:run coverage:normalize-paths",
    "ws:test:cov:run": "pnpm run --recursive --workspace-concurrency=1 --if-present test:cov",
    "ws:tsc": "pnpm run --recursive --if-present tsc",
    "ws:type-check": "pnpm run --recursive --if-present type-check",
    "z:assert-repo-is-clean": "tsx --tsconfig ./tools/configs/tsconfig.tsx.json ./libs/ts-repo-utils/src/cmd/assert-repo-is-clean.mts",
    "z:check-should-run": "tsx --tsconfig ./tools/configs/tsconfig.tsx.json ./libs/ts-repo-utils/src/cmd/check-should-run.mts",
    "z:check-should-run:code-checks": "pnpm run z:check-should-run --paths-ignore 'experimental/' --paths-ignore 'docs/' --paths-ignore 'LICENSE' --paths-ignore '.editorconfig' --paths-ignore '.gitignore' --paths-ignore '.prettierrc' --paths-ignore '.prettierignore' --paths-ignore '.cspell.config.yaml' --paths-ignore '**/cspell.config.yaml' --paths-ignore '.markdownlint-cli2.mjs' --paths-ignore '**.md' --paths-ignore '**.txt'",
    "z:check-should-run:style-checks": "pnpm run z:check-should-run --paths-ignore 'experimental/'",
    "z:eslint": "NODE_OPTIONS='--max-old-space-size=6144' TIMING=1 eslint",
    "z:format-diff-from": "tsx --tsconfig ./tools/configs/tsconfig.tsx.json ./libs/ts-repo-utils/src/cmd/format-diff-from.mts",
    "z:format-uncommitted": "tsx --tsconfig ./tools/configs/tsconfig.tsx.json ./libs/ts-repo-utils/src/cmd/format-uncommitted.mts",
    "z:link-strict-lib": "strict-ts-lib-v7.0-link",
    "z:repo-settings": "tsx --tsconfig ./tools/configs/tsconfig.tsx.json ./libs/github-settings-as-code/src/cmd/repo-settings.mts",
    "z:ts-codemod": "tsx --tsconfig ./tools/configs/tsconfig.tsx.json ./libs/ts-codemod-cli/src/cmd/ts-codemod.mts"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.0",
    "@rollup/plugin-replace": "catalog:",
    "@rollup/plugin-strip": "catalog:",
    "@types/node": "catalog:",
    "@typescript-eslint/parser": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "@vitest/ui": "catalog:",
    "cspell": "catalog:",
    "esbuild": "catalog:",
    "eslint": "catalog:",
    "eslint-config-typed": "workspace:*",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-ts-data-forge": "workspace:*",
    "eslint-plugin-ts-fortress": "workspace:*",
    "eslint-plugin-ts-type-forge": "workspace:*",
    "jiti": "catalog:",
    "knip": "6.32.2",
    "markdownlint": "catalog:",
    "markdownlint-cli2": "catalog:",
    "npm-run-all2": "catalog:",
    "oxfmt": "catalog:",
    "playwright": "catalog:",
    "prettier": "catalog:",
    "prettier-plugin-organize-imports": "catalog:",
    "prettier-plugin-packagejson": "catalog:",
    "rollup": "catalog:",
    "rollup-plugin-esbuild": "catalog:",
    "strict-ts-lib-v7.0": "workspace:*",
    "ts-data-forge": "workspace:*",
    "ts-fortress": "workspace:*",
    "ts-repo-utils": "workspace:*",
    "ts-type-forge": "workspace:*",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "typescript-native": "npm:typescript@7.0.2",
    "vite": "catalog:",
    "vitest": "catalog:",
    "zenn-cli": "^0.5.2"
  },
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=22.22.2",
    "pnpm": ">=9.0.0"
  },
  "volta": {
    "node": "25.9.0"
  }
}
