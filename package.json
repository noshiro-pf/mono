{
  "name": "mono",
  "version": "0.0.0",
  "private": true,
  "description": "monorepo for TypeScript projects",
  "keywords": [
    "typescript",
    "monorepo"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/noshiro-pf/mono.git"
  },
  "license": "Apache-2.0",
  "author": "noshiro-pf <noshiro.pf@gmail.com>",
  "sideEffects": false,
  "type": "module",
  "workspaces": [
    "libs/*",
    "apps/*",
    "tools/*",
    "languages/*/*",
    "strict-lib/scripts-common",
    "strict-lib/v*",
    "strict-lib/v*/output/lib"
  ],
  "scripts": {
    "build:marp-slides": "pnpm dlx @marp-team/marp-cli@4.5.1 docs/marp-slides/*/slides.md",
    "build:pages-site": "tsx --tsconfig ./tools/configs/tsconfig.tsx.json ./tools/scripts/cmd/build-pages-site.mts",
    "changeset:publish": "pnpm changeset publish",
    "changeset:version-packages": "pnpm changeset version && pnpm run strict-lib:fix:fmt && pnpm run strict-lib:gen:packages && pnpm install --no-frozen-lockfile && pnpm run gen:deps-graph && pnpm run gen:verify-npm-packages && pnpm run --filter=pr-merge-queue gen:plugin-version",
    "check:cspell": "cspell \"{**,.github/**/*}\" --gitignore --gitignore-root ./ --no-progress && pnpm run check:cspell:changeset",
    "check:cspell:changeset": "tsx --tsconfig ./tools/configs/tsconfig.tsx.json ./tools/scripts/cmd/cspell-changeset.mts",
    "check:knip": "node ./tools/scripts/cmd/assert-deps-built.mts --workspace && knip --no-progress --no-config-hints --include dependencies,unlisted,binaries,unresolved,catalog,catalogReferences",
    "check:md": "markdownlint-cli2",
    "check:prose": "pnpm run '/check:prose:.*/'",
    "check:prose:claude-md-references": "tsx --tsconfig ./tools/configs/tsconfig.tsx.json ./tools/scripts/cmd/check-claude-md-references.mts",
    "check:prose:claude-md-size": "tsx --tsconfig ./tools/configs/tsconfig.tsx.json ./tools/scripts/cmd/check-claude-md-size.mts",
    "check:prose:dependent-releases": "tsx --tsconfig ./tools/configs/tsconfig.tsx.json ./tools/scripts/cmd/check-dependent-releases.mts",
    "check:prose:doc-paths": "tsx --tsconfig ./tools/configs/tsconfig.tsx.json ./tools/scripts/cmd/check-doc-paths.mts",
    "check:prose:japanese-parentheses": "tsx --tsconfig ./tools/configs/tsconfig.tsx.json ./tools/scripts/cmd/check-japanese-parentheses.mts",
    "check:prose:linked-releases": "tsx --tsconfig ./tools/configs/tsconfig.tsx.json ./tools/scripts/cmd/check-linked-releases.mts",
    "check:prose:markdownlint-config": "tsx --tsconfig ./tools/configs/tsconfig.tsx.json ./tools/scripts/cmd/check-markdownlint-config.mts",
    "check:prose:mono-links": "tsx --tsconfig ./tools/configs/tsconfig.tsx.json ./tools/scripts/cmd/check-mono-links.mts",
    "check:prose:next-major": "tsx --tsconfig ./tools/configs/tsconfig.tsx.json ./tools/scripts/cmd/check-next-major.mts",
    "check:prose:readme-sample-coverage": "tsx --tsconfig ./tools/configs/tsconfig.tsx.json ./tools/scripts/cmd/check-readme-sample-coverage.mts",
    "check:published-deps": "node ./tools/scripts/cmd/assert-deps-built.mts && pnpm run z:eslint --config ./tools/configs/eslint.published-deps.mts --no-config-lookup '{libs,apps}/*/src/**/*.{mts,ts,tsx}' './eslint.config.mts' '{libs,apps}/*/eslint.config.mts' --quiet",
    "check:root": "pnpm run '/check:root:.*/'",
    "check:root:actionlint": "NODE_USE_ENV_PROXY=1 NODE_OPTIONS='--disable-warning=UNDICI-EHPA' tsx --tsconfig ./tools/configs/tsconfig.tsx.json ./tools/scripts/cmd/check-actionlint/main.mts",
    "check:root:app-head": "tsx --tsconfig ./tools/configs/tsconfig.tsx.json ./tools/scripts/cmd/check-app-head.mts",
    "check:root:ci-commands": "tsx --tsconfig ./tools/configs/tsconfig.tsx.json ./tools/scripts/cmd/check-ci-commands.mts",
    "check:root:deps-built-guard": "tsx --tsconfig ./tools/configs/tsconfig.tsx.json ./tools/scripts/cmd/check-deps-built-guard.mts",
    "check:root:dist-lib-replacement": "node ./tools/scripts/cmd/assert-deps-built.mts --workspace && tsx --tsconfig ./tools/configs/tsconfig.tsx.json ./tools/scripts/cmd/check-dist-lib-replacement.mts",
    "check:root:example-coverage": "tsx --tsconfig ./tools/configs/tsconfig.tsx.json ./tools/scripts/cmd/check-example-coverage.mts",
    "check:root:firebase-redirects": "tsx --tsconfig ./tools/configs/tsconfig.tsx.json ./tools/scripts/cmd/check-firebase-redirects.mts",
    "check:root:knip-config": "tsx --tsconfig ./tools/configs/tsconfig.tsx.json ./tools/scripts/cmd/check-knip-config.mts",
    "check:root:licenses": "tsx --tsconfig ./tools/configs/tsconfig.tsx.json ./tools/scripts/cmd/check-licenses.mts",
    "check:root:lint": "node ./tools/scripts/cmd/assert-deps-built.mts && pnpm run z:eslint './tools/{scripts,configs}/**/*.mts' --fix",
    "check:root:lockfile": "tsx --tsconfig ./tools/configs/tsconfig.tsx.json ./tools/scripts/cmd/check-lockfile-tarballs.mts",
    "check:root:lockfile-integrity": "tsx --tsconfig ./tools/configs/tsconfig.tsx.json ./tools/scripts/cmd/check-lockfile-integrity.mts",
    "check:root:minimum-release-age": "tsx --tsconfig ./tools/configs/tsconfig.tsx.json ./tools/scripts/cmd/check-minimum-release-age.mts",
    "check:root:node-support": "tsx --tsconfig ./tools/configs/tsconfig.tsx.json ./tools/scripts/cmd/check-node-support.mts",
    "check:root:oxlint-rules": "tsx --tsconfig ./tools/configs/tsconfig.tsx.json ./tools/scripts/cmd/check-oxlint-rules.mts",
    "check:root:package-manager": "tsx --tsconfig ./tools/configs/tsconfig.tsx.json ./tools/scripts/cmd/check-package-manager.mts",
    "check:root:strict-lib-links": "tsx --tsconfig ./tools/configs/tsconfig.tsx.json ./tools/scripts/cmd/check-strict-lib-links.mts",
    "check:root:test": "node ./tools/scripts/cmd/assert-deps-built.mts && vitest run --config ./tools/configs/vitest.tools.config.mts",
    "check:root:tsconfig-lib-replacement": "tsx --tsconfig ./tools/configs/tsconfig.tsx.json ./tools/scripts/cmd/check-tsconfig-lib-replacement.mts",
    "check:root:tsconfig-paths": "tsx --tsconfig ./tools/configs/tsconfig.tsx.json ./tools/scripts/cmd/check-tsconfig-paths.mts",
    "check:root:types": "node ./tools/scripts/cmd/assert-deps-built.mts && tsc -p ./tsconfig.json --noEmit",
    "check:root:workflow-event-name": "tsx --tsconfig ./tools/configs/tsconfig.tsx.json ./tools/scripts/cmd/check-workflow-event-name.mts",
    "check-all": "tsx --tsconfig ./tools/configs/tsconfig.tsx.json ./tools/scripts/cmd/check-all.mts",
    "check-changed": "tsx --tsconfig ./tools/configs/tsconfig.tsx.json ./tools/scripts/cmd/check-changed/main.mts",
    "claim-pr": "NODE_USE_ENV_PROXY=1 NODE_OPTIONS='--disable-warning=UNDICI-EHPA' tsx --tsconfig ./tools/configs/tsconfig.tsx.json ./libs/pr-merge-queue/src/cmd/claim-pr.mts",
    "clean:node_modules": "find . -name 'node_modules' -type d -prune -exec rm -rf '{}' +",
    "coverage:normalize-paths": "tsx --tsconfig ./tools/configs/tsconfig.tsx.json ./tools/scripts/cmd/normalize-coverage-paths.mts",
    "fix:codemod": "pnpm run z:ts-codemod --uncommitted && pnpm run fix:fmt",
    "fix:codemod:diff": "pnpm run z:ts-codemod --diff-from origin/main && pnpm run fix:fmt",
    "fix:codemod:full": "pnpm run z:ts-codemod && pnpm run fix:fmt",
    "fix:fmt": "pnpm run z:format-uncommitted",
    "fix:fmt:diff": "pnpm run z:format-diff-from origin/main",
    "fix:fmt:full": "prettier --ignore-unknown --no-error-on-unmatched-pattern --write .",
    "fix:japanese-parentheses": "tsx --tsconfig ./tools/configs/tsconfig.tsx.json ./tools/scripts/cmd/check-japanese-parentheses.mts --fix",
    "fmt": "pnpm run fix:fmt",
    "fmt:diff": "pnpm run fix:fmt:diff",
    "fmt:full": "pnpm run fix:fmt:full",
    "gen:app-images": "tsx --tsconfig ./tools/configs/tsconfig.tsx.json ./tools/scripts/cmd/gen-app-images.mts",
    "gen:deps-graph": "tsx --tsconfig ./tools/configs/tsconfig.tsx.json ./tools/scripts/cmd/gen-dependency-graph.mts",
    "gen:license-files": "tsx --tsconfig ./tools/configs/tsconfig.tsx.json ./tools/scripts/cmd/gen-license-files.mts",
    "gen:verify-npm-packages": "tsx --tsconfig ./tools/configs/tsconfig.tsx.json ./tools/scripts/cmd/verify-npm-packages.mts --gen",
    "licenses": "tsx --tsconfig ./tools/configs/tsconfig.tsx.json ./tools/scripts/cmd/check-licenses.mts --report",
    "node-support:update": "tsx --tsconfig ./tools/configs/tsconfig.tsx.json ./tools/scripts/cmd/update-node-support.mts",
    "npm-trusted-publishers": "tsx --tsconfig ./tools/configs/tsconfig.tsx.json ./tools/scripts/cmd/report-npm-trusted-publishers.mts",
    "open-pr": "NODE_USE_ENV_PROXY=1 NODE_OPTIONS='--disable-warning=UNDICI-EHPA' tsx --tsconfig ./tools/configs/tsconfig.tsx.json ./libs/pr-merge-queue/src/cmd/open-pr.mts",
    "pr-report": "tsx --tsconfig ./tools/configs/tsconfig.tsx.json ./libs/pr-merge-queue/src/cmd/pr-report.mts",
    "pr-screenshots": "NODE_USE_ENV_PROXY=1 NODE_OPTIONS='--disable-warning=UNDICI-EHPA' tsx --tsconfig ./tools/configs/tsconfig.tsx.json ./tools/scripts/cmd/pr-screenshots.mts",
    "prepare": "pnpm run z:link-strict-lib",
    "push-fixed-pr": "NODE_USE_ENV_PROXY=1 NODE_OPTIONS='--disable-warning=UNDICI-EHPA' tsx --tsconfig ./tools/configs/tsconfig.tsx.json ./libs/pr-merge-queue/src/cmd/push-fixed-pr.mts",
    "rebuild-pnpm-update": "NODE_USE_ENV_PROXY=1 NODE_OPTIONS='--disable-warning=UNDICI-EHPA' tsx --tsconfig ./tools/configs/tsconfig.tsx.json ./tools/scripts/cmd/rebuild-pnpm-update.mts",
    "repo-settings:apply": "pnpm run z:repo-settings apply",
    "repo-settings:backup": "pnpm run z:repo-settings backup",
    "report-unowned-prs": "NODE_USE_ENV_PROXY=1 NODE_OPTIONS='--disable-warning=UNDICI-EHPA' tsx --tsconfig ./tools/configs/tsconfig.tsx.json ./libs/pr-merge-queue/src/cmd/report-unowned-prs.mts",
    "review-findings-digest": "NODE_USE_ENV_PROXY=1 NODE_OPTIONS='--disable-warning=UNDICI-EHPA' tsx --tsconfig ./tools/configs/tsconfig.tsx.json ./tools/scripts/cmd/review-findings-digest/main.mts",
    "start-issue": "NODE_USE_ENV_PROXY=1 NODE_OPTIONS='--disable-warning=UNDICI-EHPA' tsx --tsconfig ./tools/configs/tsconfig.tsx.json ./libs/pr-merge-queue/src/cmd/start-issue.mts",
    "strict-lib:check:lint": "pnpm run z:eslint --config ./strict-lib/eslint.config.mts './strict-lib/**/*.mts'",
    "strict-lib:check:types": "tsc -p ./strict-lib/tsconfig.tooling.json --noEmit",
    "strict-lib:fix:fmt": "oxfmt --ignore-path=./.gitignore --ignore-path=./strict-lib/.oxfmtignore --config=./strict-lib/.oxfmtrc.json ./strict-lib",
    "strict-lib:gen": "tsx --tsconfig \"$PWD/tools/configs/tsconfig.tsx.json\" ./strict-lib/scripts/cmd/ws-gen-stages.mts",
    "strict-lib:gen:full": "tsx --tsconfig \"$PWD/tools/configs/tsconfig.tsx.json\" ./strict-lib/scripts/cmd/ws-gen-full-stages.mts",
    "strict-lib:gen:packages": "tsx --tsconfig \"$PWD/tools/configs/tsconfig.tsx.json\" ./strict-lib/scripts/cmd/ws-gen-packages-stages.mts",
    "strict-lib:gen:version-diff": "tsx --tsconfig \"$PWD/tools/configs/tsconfig.tsx.json\" ./strict-lib/scripts/cmd/gen-version-diff.mts",
    "strict-lib:gen:with-codemod-fixed": "tsx --tsconfig \"$PWD/tools/configs/tsconfig.tsx.json\" ./strict-lib/scripts/cmd/ws-gen-with-codemod-fixed-stages.mts",
    "strict-lib:publish": "tsx --tsconfig \"$PWD/tools/configs/tsconfig.tsx.json\" ./strict-lib/scripts/cmd/dist-npm-publish.mts",
    "unblock-prs": "tsx --tsconfig ./tools/configs/tsconfig.tsx.json ./libs/pr-merge-queue/src/cmd/unblock-prs.mts",
    "update-actions": "node ./tools/scripts/cmd/mature-updates.mts actions",
    "update-changeset": "tsx --tsconfig ./tools/configs/tsconfig.tsx.json ./tools/scripts/cmd/changeset-for-dependency-update.mts",
    "update-github-graphql-schema": "curl -fsSL https://raw.githubusercontent.com/github/docs/main/src/graphql/data/fpt/schema.docs.graphql -o tools/configs/github-graphql/schema.docs.graphql",
    "update-packages": "pnpm update --latest --recursive --filter '!./strict-lib/v*/output/lib'",
    "update-release-binaries": "node ./tools/scripts/cmd/mature-updates.mts release-binaries",
    "verify:npm-packages": "tsx --tsconfig ./tools/configs/tsconfig.tsx.json ./tools/scripts/cmd/verify-npm-packages.mts",
    "verify:npm-packages:published": "pnpm run verify:npm-packages --published",
    "verify:npm-packages:published:update": "pnpm run verify:npm-packages --published --update",
    "ws:build": "tsx --tsconfig ./tools/configs/tsconfig.tsx.json ./tools/scripts/cmd/ws-build-stages.mts",
    "ws:build:deps": "tsx --tsconfig ./tools/configs/tsconfig.tsx.json ./tools/scripts/cmd/ws-build-deps-stages.mts",
    "ws:check:dist": "node ./tools/scripts/cmd/assert-deps-built.mts --workspace && pnpm run --recursive --if-present \"/^check:dist/\"",
    "ws:check:e2e": "node ./tools/scripts/cmd/assert-deps-built.mts --workspace && pnpm run --recursive --workspace-concurrency=1 --if-present check:e2e",
    "ws:check:ext": "pnpm run --recursive --if-present check:ext",
    "ws:check:lint": "node ./tools/scripts/cmd/assert-deps-built.mts --workspace && pnpm run --recursive --if-present check:lint",
    "ws:check:sumi": "pnpm run --recursive --if-present check:sumi",
    "ws:check:test": "node ./tools/scripts/cmd/assert-deps-built.mts --workspace && pnpm run --recursive --workspace-concurrency=1 --if-present check:test",
    "ws:check:test:browser": "node ./tools/scripts/cmd/assert-deps-built.mts --workspace && pnpm run --recursive --workspace-concurrency=1 --if-present check:test:browser",
    "ws:check:test:cov": "run-s ws:check:test:cov:run coverage:normalize-paths",
    "ws:check:test:cov:run": "node ./tools/scripts/cmd/assert-deps-built.mts --workspace && pnpm run --recursive --workspace-concurrency=1 --if-present check:test:cov",
    "ws:check:test:cov:shard-1": "node ./tools/scripts/cmd/assert-deps-built.mts --workspace && pnpm run --recursive --workspace-concurrency=1 --if-present --filter=eslint-config-typed --filter=eslint-plugin-ts-std-forge --filter=eslint-plugin-ts-fortress --filter=eslint-rule-forge check:test:cov && pnpm run coverage:normalize-paths",
    "ws:check:test:cov:shard-2": "node ./tools/scripts/cmd/assert-deps-built.mts --workspace && pnpm run --recursive --workspace-concurrency=1 --if-present --filter=eslint-plugin-ts-data-forge --filter=ts-data-forge check:test:cov && pnpm run coverage:normalize-paths",
    "ws:check:test:cov:shard-3": "node ./tools/scripts/cmd/assert-deps-built.mts --workspace && pnpm run --recursive --workspace-concurrency=1 --if-present --filter=!eslint-config-typed --filter=!eslint-plugin-ts-std-forge --filter=!eslint-plugin-ts-fortress --filter=!eslint-rule-forge --filter=!eslint-plugin-ts-data-forge --filter=!ts-data-forge check:test:cov && pnpm run coverage:normalize-paths",
    "ws:check:types": "node ./tools/scripts/cmd/assert-deps-built.mts --workspace && pnpm run --recursive --if-present check:types",
    "ws:doc": "node ./tools/scripts/cmd/assert-deps-built.mts --workspace && pnpm run --recursive --if-present doc",
    "ws:fix:lint": "node ./tools/scripts/cmd/assert-deps-built.mts --workspace && pnpm run --recursive --if-present fix:lint",
    "ws:fix:lint:apps": "node ./tools/scripts/cmd/assert-deps-built.mts --workspace && pnpm run --recursive --no-sort --if-present --filter='./apps/**' fix:lint",
    "ws:fix:lint:non-apps": "node ./tools/scripts/cmd/assert-deps-built.mts --workspace && pnpm run --recursive --no-sort --if-present --filter='!./apps/**' fix:lint",
    "ws:gen": "node ./tools/scripts/cmd/assert-deps-built.mts --workspace && pnpm run --recursive --if-present gen",
    "ws:gen:jsdoc": "node ./tools/scripts/cmd/assert-deps-built.mts --workspace && pnpm run --recursive --if-present gen:jsdoc",
    "ws:gen:readme": "node ./tools/scripts/cmd/assert-deps-built.mts --workspace && pnpm run --recursive --if-present gen:readme",
    "z:assert-repo-is-clean": "tsx --tsconfig ./tools/configs/tsconfig.tsx.json ./libs/ts-repo-utils/src/cmd/assert-repo-is-clean.mts",
    "z:check-should-run": "tsx --tsconfig ./tools/configs/tsconfig.tsx.json ./libs/ts-repo-utils/src/cmd/check-should-run.mts",
    "z:check-should-run:code-checks": "pnpm run z:check-should-run --paths-ignore 'experimental/' --paths-ignore 'docs/' --paths-ignore 'LICENSE' --paths-ignore '.editorconfig' --paths-ignore '.gitignore' --paths-ignore '.prettierrc' --paths-ignore '.prettierignore' --paths-ignore '.cspell.config.yaml' --paths-ignore '**/cspell.config.yaml' --paths-ignore '.markdownlint-cli2.mjs' --paths-ignore '**.md' --paths-ignore '**.txt'",
    "z:check-should-run:strict-lib-checks": "pnpm run z:check-should-run --paths-ignore 'experimental/' --paths-ignore 'docs/' --paths-ignore 'articles/' --paths-ignore 'books/' --paths-ignore 'apps/' --paths-ignore 'languages/' --paths-ignore 'verify-npm-packages/' --paths-ignore 'repo-settings/' --paths-ignore '.changeset/' --paths-ignore 'LICENSE' --paths-ignore '.editorconfig' --paths-ignore '.prettierrc' --paths-ignore '.prettierignore' --paths-ignore '.cspell.config.yaml' --paths-ignore '**/cspell.config.yaml' --paths-ignore '.markdownlint-cli2.mjs' --paths-ignore '*.md' --paths-ignore 'libs/**/*.md'",
    "z:check-should-run:style-checks": "pnpm run z:check-should-run --paths-ignore 'experimental/'",
    "z:eslint": "NODE_OPTIONS='--max-old-space-size=6144' TIMING=1 eslint",
    "z:format-diff-from": "tsx --tsconfig ./tools/configs/tsconfig.tsx.json ./libs/ts-repo-utils/src/cmd/format-diff-from.mts",
    "z:format-uncommitted": "tsx --tsconfig ./tools/configs/tsconfig.tsx.json ./libs/ts-repo-utils/src/cmd/format-uncommitted.mts",
    "z:link-strict-lib": "strict-ts-lib-v7.0-link",
    "z:next-major-reminder": "tsx --tsconfig ./tools/configs/tsconfig.tsx.json ./tools/scripts/cmd/next-major-reminder.mts",
    "z:repo-settings": "tsx --tsconfig ./tools/configs/tsconfig.tsx.json ./libs/github-settings-as-code/src/cmd/repo-settings.mts",
    "z:ts-codemod": "pnpm run z:ts-codemod:cmd --transformer append-as-const --transformer convert-to-readonly '{tools,{libs,apps,languages}/**/{src,scripts,samples,test}}/**/*.{ts,mts,tsx}' --exclude 'libs/ts-type-forge/{src,samples,scripts}/**' --exclude 'libs/eslint-plugin-ts-type-forge/{src,samples}/**'",
    "z:ts-codemod:cmd": "tsx --tsconfig ./tools/configs/tsconfig.tsx.json ./libs/ts-codemod-cli/src/cmd/ts-codemod.mts"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@playwright/test": "catalog:",
    "@types/node": "catalog:",
    "@typescript-eslint/parser": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "@vitest/ui": "catalog:",
    "cspell": "catalog:",
    "dedent": "catalog:",
    "esbuild": "catalog:",
    "eslint": "catalog:",
    "eslint-config-typed": "workspace:*",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-ts-data-forge": "workspace:*",
    "eslint-plugin-ts-fortress": "workspace:*",
    "eslint-plugin-ts-type-forge": "workspace:*",
    "jiti": "catalog:",
    "knip": "6.42.1",
    "markdownlint": "catalog:",
    "markdownlint-cli2": "catalog:",
    "npm-run-all2": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "playwright": "catalog:",
    "pr-merge-queue": "workspace:*",
    "pr-report-core": "workspace:*",
    "prettier": "catalog:",
    "prettier-plugin-organize-imports": "catalog:",
    "prettier-plugin-packagejson": "catalog:",
    "strict-ts-lib-v7.0": "workspace:*",
    "ts-data-forge": "workspace:*",
    "ts-fortress": "workspace:*",
    "ts-repo-utils": "workspace:*",
    "ts-std-forge": "workspace:*",
    "ts-type-forge": "workspace:*",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "typescript-native": "npm:typescript@7.0.2",
    "vite": "catalog:",
    "vitest": "catalog:",
    "zenn-cli": "^0.5.7"
  },
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=22.23.4",
    "pnpm": ">=9.0.0"
  },
  "volta": {
    "node": "26.12.1"
  }
}
