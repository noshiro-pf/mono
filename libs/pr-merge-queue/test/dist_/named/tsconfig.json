{
  // Type-checks the built `dist/` output through the real package.json
  // `exports` map, via named imports
  // (`import { X } from 'pr-merge-queue'`): `scripts/cmd/check-dist.mts`
  // materializes a minimal `test/dist_/node_modules/pr-merge-queue`
  // package (package.json + dist), so module resolution here behaves exactly
  // like an external consumer's, and runs the native compiler on this file.
  //
  // Deliberately self-contained (no `extends`, no test-library dependencies).
  // `skipLibCheck` stays off: what is under test is the package's `.d.mts`,
  // which is what that option skips (`check:root:dist-test-lib-check`).
  // `types` is empty: the package does not depend on `@types/node`, so a
  // consumer may not have it, and a declaration reachable from the entry point
  // that names Node's types (`node:util`, `NodeJS.*`, `Buffer`) fails here as
  // it would for them. A `/// <reference types="node" />` that tsc writes into
  // a declaration still loads them here; `check:dist-type-references` is what
  // catches that. `DOM` stays in `lib` for the `AbortSignal` that `pause`
  // names, which no ES lib declares; a consumer has it from that lib,
  // TypeScript's default, or from Node's (`DOM_LIB_PACKAGES` in
  // `check:root:dist-test-lib-check`, and the README, say so).
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ESNext",
    "lib": ["ESNext", "DOM"],
    "types": [],
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": false
  },
  "include": ["./*.mts"]
}
