{
  // Type-checks the built `dist/` output through the real package.json
  // `exports` map, via named imports
  // (`import { X } from 'pr-merge-queue'`): `scripts/cmd/check-dist.mts`
  // materializes a minimal `test/dist_/node_modules/pr-merge-queue`
  // package (package.json + dist), so module resolution here behaves exactly
  // like an external consumer's, and runs the native compiler on this file.
  //
  // Deliberately self-contained (no `extends`, no test-library dependencies).
  // `skipLibCheck` stays off: what is under test is the package's `.d.mts`,
  // which is what that option skips (`check:root:dist-test-lib-check`).
  // `types` names `node` and nothing else: the package's own declarations
  // import Node's (`dist/lib/cli-args.d.mts` reads `node:util`), and they are
  // type-checked here, so Node's types have to resolve; everything else under
  // node_modules/@types stays out.
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ESNext",
    "lib": ["ESNext", "DOM"],
    "types": ["node"],
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": false
  },
  "include": ["./*.mts"]
}
