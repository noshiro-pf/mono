{
  "extends": [
    "../../tools/configs/tsconfig/tsconfig.type-check.json",
    "../../tools/configs/tsconfig/tsconfig.vite.json"
  ],
  "compilerOptions": {
    // Opted into the strict standard library. TypeScript 7 defaults
    // `libReplacement` to false, so the `paths` entry below does nothing
    // without it. Set per package while the repository migrates one at a
    // time; it moves to the shared config once every package passes. See
    // docs/strict-typescript-lib-integration.md.
    "libReplacement": true,

    "paths": {
      "ts-fortress": ["./src/entry-point.mts"]
    }
  },
  "include": ["./src", "./test", "./samples", "./scripts", "./configs"]
}
