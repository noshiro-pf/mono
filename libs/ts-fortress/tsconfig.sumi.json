{
  // The Sumi lint check of this package (`pnpm run check:sumi`, D-46): the
  // locked compilerOptions come from the base config, the free ones are
  // this package's. Sumi dogfood target since 2026-09-30.
  "extends": "@sumi-lang/cli/tsconfig.base.json",
  "compilerOptions": {
    // `URL` (the `uri` validator) is a web API that Node also provides; the
    // DOM lib is where TypeScript declares it.
    "lib": ["esnext", "dom"],
    // In-source tests (`import.meta.vitest`) and colocated `*.test.mts` live
    // under src/, so the check needs the vitest globals.
    "types": ["vitest/importMeta", "eslint-config-typed/vitest-globals"]
  },
  "include": ["./src"]
}
