{
  "extends": [
    "../../tools/configs/tsconfig/tsconfig.type-check.json",
    "../../tools/configs/tsconfig/tsconfig.vite.json"
  ],
  "compilerOptions": {
    "libReplacement": true,

    // `samples/` imports this package by its own name, the way a consumer
    // does, and is embedded into the JSDoc of `src/` verbatim. Mapped to the
    // source so that a sample is checked against the code being edited rather
    // than against the last build. See docs/workspace-package-linking.md.
    "paths": {
      "ts-std-forge": ["./src/entry-point.mts"]
    }
  },
  "include": ["./src", "./test", "./samples", "./scripts", "./configs"]
}
