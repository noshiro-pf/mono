export type SvgTagName = (typeof svgTagNames)[number];

const svgTagNameSet: ReadonlySet<string> = new Set<string>(svgTagNames);

/** Whether `tag` is one of `svgTagNames`. */
export const isSvgOnlyTag = (tag: string): boolean => svgTagNameSet.has(tag);

