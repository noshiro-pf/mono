{
  "name": "@synstate/react-router-example",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "check:ext": "tsx ./scripts/cmd/check-ext.mts",
    "check-all": "tsx ./scripts/cmd/check-all.mts",
    "codemod": "convert-to-readonly 'src/**/*.{mts,tsx}'",
    "dev": "vite",
    "fmt": "format-uncommitted",
    "fmt:full": "pnpm run z:prettier .",
    "gi": "run-s gi:src fmt",
    "gi:src": "gen-index-ts ./src --index-ext .mts --export-ext .mjs --target-ext .mts --target-ext .tsx --exclude entry-point.mts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "preview": "vite preview",
    "tsc": "tsc --noEmit",
    "tscw": "tsc --noEmit --watch",
    "type-check": "tsc --noEmit",
    "z:prettier": "prettier --config ../../.prettierrc --ignore-path ../../.prettierignore --ignore-path ../../.gitignore --ignore-unknown --no-error-on-unmatched-pattern --write"
  },
  "dependencies": {
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "synstate": "workspace:*",
    "synstate-react-hooks": "workspace:*",
    "synstate-react-router": "workspace:*"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.5.2",
    "vite": "^8.0.2"
  }
}
