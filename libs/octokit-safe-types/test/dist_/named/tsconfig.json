{
  // Type-checks the built `dist/` output through the real package.json
  // `exports` map, via named imports
  // (`import { X } from 'octokit-safe-types'`): `scripts/cmd/check-dist.mts`
  // materializes a minimal `test/dist_/node_modules/octokit-safe-types`
  // package (package.json + dist), so module resolution here behaves exactly
  // like an external consumer's, and runs the native compiler on this file.
  //
  // Deliberately self-contained (no `extends`, no test-library dependencies).
  // `skipLibCheck` stays off: what is under test is the package's `.d.mts`,
  // which is what that option skips (`check:root:dist-test-lib-check`).
  // `types: []` keeps node_modules/@types out: a consumer has only what the
  // package declares.
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ESNext",
    "lib": ["ESNext", "DOM"],
    "types": [],
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": false
  },
  "include": ["./*.mts"]
}
