{
  "name": "github-settings-as-code",
  "version": "2.1.0",
  "private": false,
  "keywords": [
    "github",
    "octokit"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/noshiro-pf/github-settings-as-code.git"
  },
  "license": "Apache-2.0",
  "author": "noshiro-pf <noshiro.pf@gmail.com>",
  "sideEffects": false,
  "type": "module",
  "bin": {
    "repo-settings": "./dist/cmd/repo-settings.mjs"
  },
  "files": [
    "src",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "agents:gen": "tsx ./scripts/cmd/gen-agents-md.mts",
    "agents:sync": "tsx ./scripts/cmd/sync-agent-config.mts",
    "build": "tsx ./scripts/cmd/build.mts",
    "build:min": "tsx ./scripts/cmd/build.mts --skip-check",
    "check:ext": "tsx ./scripts/cmd/check-ext.mts",
    "check-all": "tsx ./scripts/cmd/check-all.mts",
    "codemod": "run-s codemod:uncommitted:as-const fmt codemod:uncommitted:readonly fmt",
    "codemod:diff": "run-s codemod:diff:as-const fmt codemod:diff:readonly fmt",
    "codemod:diff:as-const": "append-as-const --diff-from origin/main '{src,scripts,samples}/**/*.mts'",
    "codemod:diff:readonly": "convert-to-readonly --diff-from origin/main '{src,scripts,samples}/**/*.mts'",
    "codemod:full": "run-s codemod:full:as-const fmt codemod:full:readonly fmt",
    "codemod:full:as-const": "append-as-const '{src,scripts,samples}/**/*.mts'",
    "codemod:full:readonly": "convert-to-readonly '{src,scripts,samples}/**/*.mts'",
    "codemod:uncommitted:as-const": "append-as-const --uncommitted '{src,scripts,samples}/**/*.mts'",
    "codemod:uncommitted:readonly": "convert-to-readonly --uncommitted '{src,scripts,samples}/**/*.mts'",
    "cspell": "cspell \"{**,.changeset/**/*,.github/**/*}\" --gitignore --gitignore-root ./ --no-progress",
    "doc": "tsx ./scripts/cmd/gen-docs.mts",
    "fmt": "format-uncommitted",
    "fmt:diff": "format-diff-from origin/main",
    "fmt:full": "prettier --write .",
    "gi": "run-s gi:src fmt",
    "gi:src": "gen-index-ts ./src/github --index-ext .mts --export-ext .mjs --target-ext .mts --exclude cmd --exclude octokit.mts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "md": "markdownlint-cli2",
    "repo-settings:apply": "tsx ./src/cmd/repo-settings.mts apply",
    "repo-settings:backup": "tsx ./src/cmd/repo-settings.mts backup",
    "test": "pnpm run z:vitest:node run",
    "test:cov": "pnpm run z:vitest:node run --coverage",
    "test:cov:ui": "vite preview --outDir ./coverage",
    "test:ui": "pnpm run z:vitest:node --ui",
    "testw": "pnpm run z:vitest:node watch",
    "tsc": "node ./node_modules/typescript-native/bin/tsc --noEmit",
    "tscw": "node ./node_modules/typescript-native/bin/tsc --noEmit --watch -p ./tsconfig.json",
    "type-check": "node ./node_modules/typescript-native/bin/tsc --noEmit",
    "z:vitest": "vitest --config ./configs/vitest.config.mts",
    "z:vitest:node": "pnpm run z:vitest --project='Node.js'"
  },
  "dependencies": {
    "@octokit/core": "^7.0.7",
    "dotenv": "^17.4.2",
    "octokit-safe-types": "^1.2.24",
    "ts-data-forge": "^14.1.0",
    "ts-fortress": "^12.0.0",
    "ts-type-forge": "^9.1.3"
  },
  "devDependencies": {
    "@semantic-release/changelog": "7.0.0",
    "@semantic-release/commit-analyzer": "13.0.1",
    "@semantic-release/exec": "7.1.0",
    "@semantic-release/git": "11.0.1",
    "@semantic-release/github": "12.0.9",
    "@semantic-release/npm": "13.1.5",
    "@semantic-release/release-notes-generator": "14.1.1",
    "@types/node": "26.2.0",
    "@vitest/coverage-v8": "4.1.10",
    "@vitest/ui": "4.1.10",
    "conventional-changelog-conventionalcommits": "10.2.1",
    "cspell": "10.0.1",
    "eslint": "10.8.0",
    "eslint-config-typed": "5.8.4",
    "eslint-plugin-ts-data-forge": "0.4.2",
    "eslint-plugin-ts-fortress": "1.0.0",
    "eslint-plugin-ts-type-forge": "0.6.1",
    "jiti": "2.7.0",
    "markdownlint": "0.41.1",
    "markdownlint-cli2": "0.23.2",
    "npm-run-all2": "9.0.3",
    "playwright": "1.62.1",
    "prettier": "3.9.6",
    "prettier-plugin-organize-imports": "4.3.0",
    "prettier-plugin-packagejson": "3.0.2",
    "semantic-release": "25.0.8",
    "ts-codemod-lib": "2.2.4",
    "ts-repo-utils": "10.1.7",
    "tsx": "4.23.4",
    "typedoc": "0.28.20",
    "typedoc-github-theme": "0.4.0",
    "typescript": "6.0.3",
    "typescript-native": "npm:typescript@7.0.2",
    "vitest": "4.1.10"
  },
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=22.22.2",
    "pnpm": ">=9.0.0"
  },
  "volta": {
    "node": "26.3.1"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
