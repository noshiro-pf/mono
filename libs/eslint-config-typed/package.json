{
  "name": "eslint-config-typed",
  "version": "5.9.5",
  "private": false,
  "keywords": [
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/noshiro-pf/mono.git",
    "directory": "libs/eslint-config-typed"
  },
  "license": "Apache-2.0",
  "author": "noshiro-pf <noshiro.pf@gmail.com>",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/types.d.mts",
        "default": "./dist/entry-point.mjs"
      },
      "default": {
        "types": "./dist/types.d.mts",
        "default": "./dist/entry-point.mjs"
      }
    },
    "./vitest-globals": {
      "types": "./vitest-globals.d.ts"
    }
  },
  "module": "./dist/entry-point.mjs",
  "types": "./dist/types.d.mts",
  "files": [
    "src",
    "dist",
    "README.md",
    "LICENSE",
    "vitest-globals.d.ts"
  ],
  "scripts": {
    "apply-type-transformations": "tsx --tsconfig ../../tools/configs/tsconfig.tsx.json ./scripts/gen-eslint-rules/codemod/apply-type-transformations.mts",
    "build": "tsx --tsconfig ../../tools/configs/tsconfig.tsx.json ./scripts/cmd/build.mts",
    "build:min": "tsx --tsconfig ../../tools/configs/tsconfig.tsx.json ./scripts/cmd/build.mts --skip-check",
    "check-all": "tsx --tsconfig ../../tools/configs/tsconfig.tsx.json ./scripts/cmd/check-all.mts",
    "check:ext": "tsx --tsconfig ../../tools/configs/tsconfig.tsx.json ./scripts/cmd/check-ext.mts",
    "codemod": "run-s codemod:uncommitted:* fmt",
    "codemod:diff": "run-s codemod:diff:* fmt",
    "codemod:diff:any-to-unknown": "tsx --tsconfig ../../tools/configs/tsconfig.tsx.json ../../libs/ts-codemod-cli/src/cmd/ts-codemod.mts --diff-from origin/main --transformer replace-any-with-unknown '{src,scripts,samples}/**/*.{mts,tsx}'",
    "codemod:diff:others": "tsx --tsconfig ../../tools/configs/tsconfig.tsx.json ../../libs/ts-codemod-cli/src/cmd/ts-codemod.mts --diff-from origin/main --transformer append-as-const --transformer convert-interface-to-type --transformer convert-to-readonly --transformer replace-record-with-unknown-record '{src,scripts,samples,test}/**/*.{mts,tsx}'",
    "codemod:full": "run-s codemod:full:* fmt",
    "codemod:full:any-to-unknown": "tsx --tsconfig ../../tools/configs/tsconfig.tsx.json ../../libs/ts-codemod-cli/src/cmd/ts-codemod.mts --transformer replace-any-with-unknown '{src,scripts,samples}/**/*.{mts,tsx}'",
    "codemod:full:others": "tsx --tsconfig ../../tools/configs/tsconfig.tsx.json ../../libs/ts-codemod-cli/src/cmd/ts-codemod.mts --transformer append-as-const --transformer convert-interface-to-type --transformer convert-to-readonly --transformer replace-record-with-unknown-record '{src,scripts,samples,test}/**/*.{mts,tsx}'",
    "codemod:uncommitted:any-to-unknown": "tsx --tsconfig ../../tools/configs/tsconfig.tsx.json ../../libs/ts-codemod-cli/src/cmd/ts-codemod.mts --uncommitted --transformer replace-any-with-unknown '{src,scripts,samples}/**/*.{mts,tsx}'",
    "codemod:uncommitted:others": "tsx --tsconfig ../../tools/configs/tsconfig.tsx.json ../../libs/ts-codemod-cli/src/cmd/ts-codemod.mts --uncommitted --transformer append-as-const --transformer convert-interface-to-type --transformer convert-to-readonly --transformer replace-record-with-unknown-record '{src,scripts,samples,test}/**/*.{mts,tsx}'",
    "cspell": "cspell \"**\" --gitignore --gitignore-root ../../ --no-progress",
    "doc": "tsx --tsconfig ../../tools/configs/tsconfig.tsx.json ./scripts/cmd/gen-docs.mts",
    "doc:embed": "tsx --tsconfig ../../tools/configs/tsconfig.tsx.json ./scripts/cmd/embed-examples.mts",
    "fmt": "tsx --tsconfig ../../tools/configs/tsconfig.tsx.json ../../libs/ts-repo-utils/src/cmd/format-uncommitted.mts --cwd .",
    "fmt:diff": "tsx --tsconfig ../../tools/configs/tsconfig.tsx.json ../../libs/ts-repo-utils/src/cmd/format-diff-from.mts origin/main --cwd .",
    "fmt:full": "prettier --write .",
    "gen-rule-type": "tsx --tsconfig ../../tools/configs/tsconfig.tsx.json ./scripts/gen-eslint-rules/main.mts",
    "gi": "run-s gi:src fmt",
    "gi:src": "tsx --tsconfig ../../tools/configs/tsconfig.tsx.json scripts/cmd/gen-index.mts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "pnpm run z:vitest:node run",
    "test:cov": "pnpm run z:vitest:node run --coverage",
    "test:cov:ui": "vite preview --outDir ./coverage",
    "test:ui": "pnpm run z:vitest:node --ui",
    "testw": "pnpm run z:vitest:node watch",
    "tsc": "node ../../node_modules/typescript-native/bin/tsc --noEmit",
    "tscw": "node ../../node_modules/typescript-native/bin/tsc --noEmit --watch -p ./tsconfig.json",
    "type-check": "node ../../node_modules/typescript-native/bin/tsc --noEmit",
    "z:vitest": "vitest --config ./configs/vitest.config.mts",
    "z:vitest:node": "pnpm run z:vitest --project='Node.js'"
  },
  "dependencies": {
    "@eslint/core": "^1.2.1",
    "@sindresorhus/is": "^8.1.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/estree": "^1.0.9",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "@typescript-eslint/type-utils": "^8.67.0",
    "@typescript-eslint/utils": "^8.67.0",
    "@vitest/eslint-plugin": "^1.6.27",
    "eslint": "^10.8.1",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-array-func": "^5.1.1",
    "eslint-plugin-cypress": "^7.0.0",
    "eslint-plugin-eslint-plugin": "^7.6.2",
    "eslint-plugin-functional": "^10.0.0",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jest": "^29.16.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-math": "^0.13.1",
    "eslint-plugin-n": "^18.3.0",
    "eslint-plugin-playwright": "^2.11.0",
    "eslint-plugin-prefer-arrow-functions": "^3.10.2",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-perf": "^3.3.3",
    "eslint-plugin-react-refresh": "^0.5.4",
    "eslint-plugin-security": "^4.0.1",
    "eslint-plugin-sort-destructure-keys": "^3.0.0",
    "eslint-plugin-testing-library": "^7.16.2",
    "eslint-plugin-unicorn": "^73.0.0",
    "globals": "^17.11.0",
    "is-glob": "^4.0.3",
    "is-immutable-type": "^5.0.4",
    "micromatch": "^4.0.8",
    "ts-data-forge": "workspace:^",
    "ts-type-forge": "workspace:^",
    "tsutils": "^3.21.0"
  },
  "devDependencies": {
    "@rollup/plugin-replace": "catalog:",
    "@rollup/plugin-strip": "catalog:",
    "@rollup/plugin-typescript": "catalog:",
    "@types/is-glob": "4.0.4",
    "@types/json-schema": "7.0.15",
    "@types/micromatch": "4.0.10",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@typescript-eslint/rule-tester": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "@vitest/ui": "catalog:",
    "cspell": "catalog:",
    "dedent": "catalog:",
    "eslint-config-typed": "workspace:*",
    "eslint-plugin-ts-data-forge": "workspace:*",
    "eslint-plugin-ts-fortress": "workspace:*",
    "eslint-plugin-ts-type-forge": "workspace:*",
    "immer": "catalog:",
    "jiti": "catalog:",
    "json-schema": "0.4.0",
    "json-schema-to-typescript": "15.0.4",
    "npm-run-all2": "catalog:",
    "prettier": "catalog:",
    "prettier-plugin-organize-imports": "catalog:",
    "prettier-plugin-packagejson": "catalog:",
    "react": "catalog:",
    "rollup": "catalog:",
    "ts-codemod-lib": "workspace:*",
    "ts-repo-utils": "workspace:*",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "typescript-native": "npm:typescript@7.0.2",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "eslint": ">=9.0.0",
    "typescript": ">=5.0.0 <7.0.0"
  },
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=22.22.2",
    "pnpm": ">=9.0.0"
  },
  "volta": {
    "node": "26.3.1"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
