{
  "extends": [
    "../../tools/configs/tsconfig/tsconfig.type-check.json",
    "../../tools/configs/tsconfig/tsconfig.vite.json",
    "../../tools/configs/tsconfig/tsconfig.node-only.json"
  ],
  "compilerOptions": {
    // `samples/` imports this package by its own name, the way a consumer
    // does, and is embedded into the README verbatim. Mapped to the source so
    // that a sample is checked against the code being edited rather than
    // against the last build. See docs/workspace-package-linking.md.
    "paths": {
      "eslint-config-typed": ["./src/entry-point.mts"]
    }
  },
  "include": [
    "./src",
    "./test",
    "./samples",
    "./scripts",
    "./configs",
    "./.markdownlint-cli2.mjs",
    "vitest-globals.d.ts"
  ]
}
