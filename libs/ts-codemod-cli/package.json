{
  "name": "ts-codemod-cli",
  "version": "2.1.1",
  "private": false,
  "description": "Command line interface for ts-codemod-lib.",
  "keywords": [
    "typescript",
    "codemod",
    "cli",
    "readonly",
    "immutable"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/noshiro-pf/mono.git",
    "directory": "libs/ts-codemod-cli"
  },
  "license": "Apache-2.0",
  "author": "noshiro-pf <noshiro.pf@gmail.com>",
  "sideEffects": [
    "./dist/cmd/*.mjs"
  ],
  "type": "module",
  "bin": {
    "ts-codemod": "./dist/cmd/ts-codemod.mjs"
  },
  "files": [
    "src",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsx --tsconfig ../../tools/configs/tsconfig.tsx.json ./scripts/cmd/build.mts",
    "check:cspell": "cspell \"**\" --gitignore --gitignore-root ../../ --no-progress",
    "check:ext": "tsx --tsconfig ../../tools/configs/tsconfig.tsx.json ./scripts/cmd/check-ext.mts",
    "check:lint": "eslint .",
    "check:types": "node ../../node_modules/typescript-native/bin/tsc --noEmit",
    "clean": "pnpm run /clean:.*/",
    "clean:logs": "npx rimraf ./*.log",
    "fix:fmt": "tsx --tsconfig ../../tools/configs/tsconfig.tsx.json ../../libs/ts-repo-utils/src/cmd/format-uncommitted.mts --cwd .",
    "fix:fmt:diff": "tsx --tsconfig ../../tools/configs/tsconfig.tsx.json ../../libs/ts-repo-utils/src/cmd/format-diff-from.mts origin/main --cwd .",
    "fix:fmt:full": "prettier --write .",
    "fix:lint": "eslint . --fix",
    "fmt": "pnpm run fix:fmt"
  },
  "dependencies": {
    "cmd-ts": "^0.15.0",
    "dedent": "^1.7.2",
    "ts-codemod-lib": "workspace:^",
    "ts-data-forge": "workspace:^",
    "ts-repo-utils": "workspace:^"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "cspell": "catalog:",
    "eslint": "catalog:",
    "eslint-config-typed": "workspace:*",
    "eslint-plugin-ts-data-forge": "workspace:*",
    "eslint-plugin-ts-fortress": "workspace:*",
    "eslint-plugin-ts-type-forge": "workspace:*",
    "jiti": "catalog:",
    "prettier": "catalog:",
    "prettier-plugin-organize-imports": "catalog:",
    "prettier-plugin-packagejson": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "typescript-native": "npm:typescript@7.0.2"
  },
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=22.22.2",
    "pnpm": ">=9.0.0"
  },
  "volta": {
    "node": "26.9.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
