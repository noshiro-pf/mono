---
import Default from '@astrojs/starlight/components/Head.astro';

const route = Astro.locals.starlightRoute;

// Derive OG image slug from the content collection entry ID.
// This ensures the slug matches exactly what getStaticPaths generates
// in src/pages/og/[...slug].png.mts (which also uses entry.id).
// e.g. entry.id = "ja/guides/why-synstate" → /synstate/og/ja/guides/why-synstate.png
//      entry.id = "index"                  → /synstate/og/index.png
//      entry.id = "ja/index"               → /synstate/og/ja/index.png
const ogSlug = route.entry.id;
const ogImageUrl = new URL(`${import.meta.env.BASE_URL}og/${ogSlug}.png`, Astro.site);

const imageAlt = route.entry.data.description ?? `${route.entry.data.title} — SynState`;
---

<Default><slot /></Default>
<meta property="og:image" content={ogImageUrl.href} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:type" content="image/png" />
<meta property="og:image:alt" content={imageAlt} />
<meta name="twitter:image" content={ogImageUrl.href} />
<meta name="twitter:image:alt" content={imageAlt} />
