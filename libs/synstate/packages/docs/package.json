{
  "name": "@synstate/docs",
  "version": "0.0.3",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "run-s doc type-check build:astro",
    "build:astro": "astro build",
    "dev": "astro dev",
    "doc": "run-s doc:embed:bundle-size doc:embed:jsdoc-examples doc:embed:jsdoc doc:embed fmt",
    "doc:embed": "tsx ./scripts/embed-examples.mts",
    "doc:embed:benchmark": "tsx ./scripts/embed-benchmark.mts",
    "doc:embed:bundle-size": "tsx ./scripts/embed-bundle-size.mts",
    "doc:embed:jsdoc": "tsx ./scripts/embed-jsdoc-descriptions.mts",
    "doc:embed:jsdoc-examples": "tsx ./scripts/embed-jsdoc-examples.mts",
    "fmt": "format-uncommitted",
    "fmt:full": "pnpm run z:prettier .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "preview": "astro preview",
    "tsc": "tsc --noEmit",
    "tscw": "tsc --noEmit --watch",
    "type-check": "tsc --noEmit",
    "update-packages": "pnpm update --latest",
    "z:prettier": "prettier --config ../../.prettierrc --ignore-path ../../.prettierignore --ignore-path ../../.gitignore --ignore-unknown --no-error-on-unmatched-pattern --write"
  },
  "dependencies": {
    "@astrojs/preact": "^5.0.2",
    "@astrojs/react": "^5.0.1",
    "@astrojs/starlight": "^0.38.2",
    "@fontsource/noto-sans-jp": "^5.2.9",
    "@preact/signals": "^2.8.2",
    "@resvg/resvg-js": "^2.6.2",
    "astro": "^6.0.8",
    "preact": "^10.29.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "satori": "^0.26.0"
  },
  "devDependencies": {
    "@reduxjs/toolkit": "^2.11.2",
    "@types/argparse": "^2.0.17",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "argparse": "^2.0.1",
    "esbuild": "^0.27.4",
    "jotai": "^2.19.0",
    "mobx": "^6.15.0",
    "rxjs": "^7.8.2",
    "synstate": "workspace:*",
    "synstate-preact-hooks": "workspace:*",
    "synstate-preact-signals": "workspace:*",
    "synstate-react-hooks": "workspace:*",
    "valtio": "^2.3.1",
    "zustand": "^5.0.12"
  }
}
