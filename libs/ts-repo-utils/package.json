{
  "name": "ts-repo-utils",
  "version": "10.1.8",
  "private": false,
  "keywords": [
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/noshiro-pf/ts-repo-utils.git"
  },
  "license": "Apache-2.0",
  "author": "noshiro-pf <noshiro.pf@gmail.com>",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/types.d.mts",
        "default": "./dist/entry-point.mjs"
      },
      "default": {
        "types": "./dist/types.d.mts",
        "default": "./dist/entry-point.mjs"
      }
    }
  },
  "module": "./dist/entry-point.mjs",
  "types": "./dist/types.d.mts",
  "bin": {
    "assert-repo-is-clean": "./dist/cmd/assert-repo-is-clean.mjs",
    "check-should-run-type-checks": "./dist/cmd/check-should-run-type-checks.mjs",
    "format-diff-from": "./dist/cmd/format-diff-from.mjs",
    "format-uncommitted": "./dist/cmd/format-uncommitted.mjs",
    "gen-index-ts": "./dist/cmd/gen-index-ts.mjs"
  },
  "files": [
    "src",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "agents:gen": "tsx ./scripts/cmd/gen-agents-md.mts",
    "agents:sync": "tsx ./scripts/cmd/sync-agent-config.mts",
    "build": "tsx ./scripts/cmd/build.mts",
    "build:min": "tsx ./scripts/cmd/build.mts --skip-check",
    "check:ext": "tsx ./scripts/cmd/check-ext.mts",
    "check-all": "tsx ./scripts/cmd/check-all.mts",
    "codemod": "run-s codemod:uncommitted:as-const fmt codemod:uncommitted:readonly fmt",
    "codemod:diff": "run-s codemod:diff:as-const fmt codemod:diff:readonly fmt",
    "codemod:diff:as-const": "append-as-const --diff-from origin/main '{src,scripts,samples}/**/*.mts'",
    "codemod:diff:readonly": "convert-to-readonly --diff-from origin/main '{src,scripts,samples}/**/*.mts'",
    "codemod:full": "run-s codemod:full:as-const fmt codemod:full:readonly fmt",
    "codemod:full:as-const": "append-as-const '{src,scripts,samples}/**/*.mts'",
    "codemod:full:readonly": "convert-to-readonly '{src,scripts,samples}/**/*.mts'",
    "codemod:uncommitted:as-const": "append-as-const --uncommitted '{src,scripts,samples}/**/*.mts'",
    "codemod:uncommitted:readonly": "convert-to-readonly --uncommitted '{src,scripts,samples}/**/*.mts'",
    "cspell": "cspell \"{**,.changeset/**/*,.github/**/*}\" --gitignore --gitignore-root ./ --no-progress",
    "doc": "tsx ./scripts/cmd/gen-docs.mts",
    "doc:embed": "tsx ./scripts/cmd/embed-examples.mts",
    "doc:preview": "vite preview --config ./configs/vite.doc.config.mts",
    "doc:watch": "typedoc --options ./configs/typedoc.config.mjs --watch",
    "fmt": "pnpm run z:format-uncommitted",
    "fmt:diff": "pnpm run z:format-diff-from origin/main",
    "fmt:full": "prettier --write .",
    "gi": "run-s gi:src fmt",
    "gi:src": "pnpm run z:gen-index-ts ./src --index-ext .mts --export-ext .mjs --target-ext .mts --target-ext .tsx --exclude entry-point.mts --exclude cmd",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "md": "markdownlint-cli2",
    "prepare-release": "run-s sync-cli-versions fmt build doc",
    "repo-settings:apply": "repo-settings apply",
    "repo-settings:backup": "repo-settings backup",
    "sync-cli-versions": "tsx scripts/cmd/sync-cli-versions.mts",
    "test": "pnpm run z:vitest:node run",
    "test:cov": "pnpm run z:vitest:node run --coverage",
    "test:cov:ui": "vite preview --outDir ./coverage",
    "test:ui": "pnpm run z:vitest:node --ui",
    "testw": "pnpm run z:vitest:node watch",
    "tsc": "node ./node_modules/typescript-native/bin/tsc --noEmit",
    "tscw": "node ./node_modules/typescript-native/bin/tsc --noEmit --watch -p ./tsconfig.json",
    "type-check": "node ./node_modules/typescript-native/bin/tsc --noEmit",
    "z:assert-repo-is-clean": "tsx ./src/cmd/assert-repo-is-clean.mts",
    "z:check-should-run-type-checks": "tsx ./src/cmd/check-should-run-type-checks.mts",
    "z:format-diff-from": "tsx ./src/cmd/format-diff-from.mts",
    "z:format-uncommitted": "tsx ./src/cmd/format-uncommitted.mts",
    "z:gen-index-ts": "tsx ./src/cmd/gen-index-ts.mts",
    "z:vitest": "vitest --config ./configs/vitest.config.mts",
    "z:vitest:node": "pnpm run z:vitest --project='Node.js'"
  },
  "dependencies": {
    "@nodelib/fs.walk": "^3.0.1",
    "@sindresorhus/is": "^8.1.0",
    "@types/micromatch": "^4.0.10",
    "cmd-ts": "^0.15.0",
    "fast-glob": "^3.3.3",
    "micromatch": "^4.0.8",
    "ts-data-forge": "^14.1.0",
    "ts-type-forge": "^9.1.3",
    "tsx": "^4.23.4"
  },
  "devDependencies": {
    "@rollup/plugin-replace": "6.0.3",
    "@rollup/plugin-strip": "3.0.4",
    "@semantic-release/changelog": "7.0.0",
    "@semantic-release/commit-analyzer": "13.0.1",
    "@semantic-release/exec": "7.1.0",
    "@semantic-release/git": "11.0.1",
    "@semantic-release/github": "12.0.9",
    "@semantic-release/npm": "13.1.5",
    "@semantic-release/release-notes-generator": "14.1.1",
    "@types/node": "26.2.0",
    "@vitest/coverage-v8": "4.1.10",
    "@vitest/ui": "4.1.10",
    "conventional-changelog-conventionalcommits": "10.2.1",
    "cspell": "10.0.1",
    "dedent": "1.7.2",
    "esbuild": "0.28.1",
    "eslint": "10.8.0",
    "eslint-config-typed": "5.8.4",
    "eslint-plugin-ts-data-forge": "0.4.2",
    "eslint-plugin-ts-fortress": "1.0.0",
    "eslint-plugin-ts-type-forge": "0.6.1",
    "github-settings-as-code": "2.1.0",
    "jiti": "2.7.0",
    "markdownlint": "0.41.1",
    "markdownlint-cli2": "0.23.2",
    "npm-run-all2": "9.0.3",
    "prettier": "3.9.6",
    "prettier-plugin-organize-imports": "4.3.0",
    "prettier-plugin-packagejson": "3.0.2",
    "rollup": "4.62.4",
    "rollup-plugin-esbuild": "6.2.1",
    "semantic-release": "25.0.8",
    "ts-codemod-lib": "2.2.4",
    "ts-repo-utils": "10.1.7",
    "typedoc": "0.28.20",
    "typedoc-github-theme": "0.4.0",
    "typescript": "6.0.3",
    "typescript-native": "npm:typescript@7.0.2",
    "vite": "8.2.0",
    "vitest": "4.1.10"
  },
  "peerDependencies": {
    "prettier": ">=3.0.0"
  },
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=22.22.2",
    "pnpm": ">=8.0.0"
  },
  "volta": {
    "node": "26.3.1"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
