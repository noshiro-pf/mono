{
  "extends": [
    "../../tools/configs/tsconfig/tsconfig.type-check.json",
    "../../tools/configs/tsconfig/tsconfig.vite.json",
    "../../tools/configs/tsconfig/tsconfig.node-only.json"
  ],
  "compilerOptions": {
    // Opted into the strict standard library. TypeScript 7 defaults
    // `libReplacement` to false, so the `@typescript/lib-*` packages declared
    // at the root do nothing without it. Set per package while the repository
    // migrates one at a time; it moves to the shared config once every package
    // passes. See docs/strict-typescript-lib-integration.md.
    "libReplacement": true,

    "paths": {
      // The strict standard library. Every built-in library lives inside the
      // one `strict-ts-lib-v7.0` package, so this wildcard is what points
      // `libReplacement` at it. `paths` is replaced — not merged — by a config
      // that `extends` another, so a package defining any `paths` of its own
      // has to repeat this one; `check:root:tsconfig-lib-paths` enforces that,
      // because a missing entry disables the replacement with no diagnostic.
      "@typescript/lib-*": ["../../node_modules/strict-ts-lib-v7.0/libs/*"],
      "ts-repo-utils": ["./src/entry-point.mts"]
    }
  },
  "include": [
    "./src",
    "./test",
    "./samples",
    "./scripts",
    "./configs",
    "./release.config.js",
    "./.markdownlint-cli2.mjs"
  ]
}
