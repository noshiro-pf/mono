import { Arr } from 'ts-data-forge';
import type { BrandedNumberConfig } from './config.mjs';
import { methodProse, type MethodProse } from './prose.mjs';

/**
 * Renders a complete branded-number module from its config.
 *
 * `is<T>` and `as<T>` are written out in the module, and the namespace object
 * imports every other operator from the module `renderOperatorsModule` writes.
 * Neither esbuild nor Rolldown drops a module-level call, and one
 * `operatorsFor*` call keeps `RefinedNumberUtils`, `Num` and ts-std-forge's
 * `Optional` and `Result`; this way a bundle that calls only `is<T>` or `as<T>`
 * reaches none. The imports are named: Rolldown keeps a module imported with
 * `import * as` when a member is read in an object literal, even one it drops
 * (a call such as `Num.clamp(…)` through `import * as` is tree-shaken).
 */
export const renderModule = (config: BrandedNumberConfig): string =>
  config.enumSpec !== undefined
    ? renderEnumModule(config, config.enumSpec)
    : renderBrandedModule(config);

/**
 * The module with the `operatorsFor*` call, `src/number/operators/<name>.mts`.
 * Only the branded-number module imports it; `gen:index:src` leaves the
 * directory out of the barrels, whose `export *` would collide on `add`.
 */
export const renderOperatorsModule = (config: BrandedNumberConfig): string => {
  const elementType = config.enumSpec?.wideBase ?? config.ttfType;

  const generics =
    config.enumSpec !== undefined
      ? ([elementType, config.minValueExpr, config.maxValueExpr] as const)
      : config.generics.map((g) => (g === 'ElementType' ? elementType : g));

  const valueText = [
    ...generics,
    config.minValueExpr,
    config.maxValueExpr,
  ].join(' ');

  const typeNames = [
    elementType,
    ...['SafeInt', 'SafeUint'].filter(
      (t) => t !== elementType && valueText.split(/\W+/u).includes(t),
    ),
  ] as const;

  return [
    renderJsDoc(
      {
        description: `The operators of \`${config.pascalName}\` other than \`is${config.pascalName}\` and \`as${config.pascalName}\`, which \`../${config.dir}/${config.kebabName}.mts\` reads. Generated by \`gen:branded-number\`; \`renderModule\` in \`scripts/gen-branded-number/render.mts\` says why they are in a module of their own.`,
        hasExample: false,
        params: [],
        returns: undefined,
      },
      0,
      false,
    ),
    ...typeNames.map((t) => `import type { ${t} } from 'ts-type-forge';`),
    "import { TsDataForgeInternals } from '../refined-number-utils.mjs';",
    '',
    'export const {',
    // `is` only for `test/branded-number-guards.test.mts`, which checks that
    // the `is<T>` written out in the module agrees with it.
    ...['is', ...operatorImports(config).map(({ exported }) => exported)]
      // eslint-disable-next-line unicorn/prefer-simple-sort-comparator
      .toSorted((a, b) => (a < b ? -1 : 1))
      .map((name) => `  ${name},`),
    `} = TsDataForgeInternals.RefinedNumberUtils.${config.factory}<`,
    generics.map((g) => `  ${g}`).join(',\n'),
    '>({',
    ...(config.integerOrSafeInteger !== undefined
      ? [`  integerOrSafeInteger: '${config.integerOrSafeInteger}',`]
      : []),
    ...(config.nonZero ? ['  nonZero: true,'] : []),
    ...(config.minValueComment !== undefined
      ? [`  ${config.minValueComment}`]
      : []),
    `  MIN_VALUE: ${config.minValueExpr},`,
    ...(config.maxValueComment !== undefined
      ? [`  ${config.maxValueComment}`]
      : []),
    `  MAX_VALUE: ${config.maxValueExpr},`,
    `  typeNameInMessage: '${config.typeNameInMessage}',`,
    '} as const);',
    '',
  ].join('\n');
};

const internalsTypeImport =
  "import type { TsDataForgeInternals } from '../refined-number-utils.mjs';";

/**
 * Whether a (non-enum) module's code names `identifier`: only the custom
 * constants and the type assertions can, and not every module has those.
 */
const brandedModuleUses = (
  config: BrandedNumberConfig,
  identifier: 'ElementType' | 'TsDataForgeInternals',
): boolean =>
  config.numberClassParams !== undefined ||
  [config.customConsts, config.leadingExpectType].some(
    (code) => code?.includes(identifier) === true,
  );

const namespaceLocalName = (key: string): string =>
  key === 'min' ? 'min_' : key === 'max' ? 'max_' : key;

/**
 * What the module imports from its operators module, and under which name: the
 * namespace keys that are neither `is` (written out) nor defined in the module
 * itself. `min` and `max` are renamed so as not to shadow the parameters of
 * `random`; the enum modules wrap what they import. Sorted in code-unit (ASCII)
 * order; `localeCompare` would reorder the upper-case constants.
 */
const operatorImports = (
  config: BrandedNumberConfig,
): readonly Readonly<{ exported: string; local: string }>[] => {
  if (config.enumSpec !== undefined) {
    return [
      { exported: 'MAX_VALUE', local: 'MAX_VALUE' },
      { exported: 'MIN_VALUE', local: 'MIN_VALUE' },
      { exported: 'castType', local: 'castTypeImpl' },
      { exported: 'fromNumber', local: 'fromNumberImpl' },
      { exported: 'random', local: 'randomImpl' },
    ];
  }

  const customKeys = new Set<string>(config.customKeys);

  const imports = config.namespaceKeys
    .filter((key: string) => key !== 'is' && !customKeys.has(key))
    .map((key: string) => ({
      exported:
        key === 'random' && config.randomNonZero === true
          ? 'randomNonZero'
          : key,
      local: namespaceLocalName(key),
    }));

  // eslint-disable-next-line unicorn/prefer-simple-sort-comparator
  return imports.toSorted((a, b) => (a.exported < b.exported ? -1 : 1));
};

const operatorsImport = (config: BrandedNumberConfig): string =>
  [
    'import {',
    ...operatorImports(config).map(({ exported, local }) =>
      exported === local ? `  ${exported},` : `  ${exported} as ${local},`,
    ),
    `} from '../operators/${config.kebabName}.mjs';`,
  ].join('\n');

/** Computes a member's prose, applying any per-member override from config. */
const resolveProse = (
  key: string,
  config: BrandedNumberConfig,
): MethodProse => {
  const base = methodProse(key, config);

  const override = config.proseOverrides?.[key];

  return override === undefined ? base : { ...base, ...override };
};

const renderImports = (config: BrandedNumberConfig): string =>
  [
    `import type { ${config.ttfType} as TtfImported_${config.ttfType} } from 'ts-type-forge';`,
    // Emitted as separate statements; `prettier-plugin-organize-imports` merges
    // and sorts them into the single `ts-type-forge` import.
    ...[
      ...(config.extraTtfTypes ?? []),
      ...(config.absType === undefined ? [] : [config.absType]),
    ].map((t) => `import type { ${t} } from 'ts-type-forge';`),
    ...(config.extraImports ?? []),
    ...(config.numberClassParams !== undefined
      ? ["import { expectType } from '../../expect-type.mjs';"]
      : []),
    ...(brandedModuleUses(config, 'TsDataForgeInternals')
      ? [internalsTypeImport]
      : []),
    operatorsImport(config),
  ].join('\n');

/**
 * The condition `operatorsFor*`'s `is` checks, written out. A bound that the
 * first check already implies is left out, and so is `value !== 0` where a
 * bound excludes zero. `test/branded-number-guards.test.mts` checks the result
 * against the factory.
 */
const guardConditions = (config: BrandedNumberConfig): readonly string[] => {
  const integerCheck =
    config.factory === 'operatorsForFloat'
      ? 'Number.isFinite(value)'
      : config.integerOrSafeInteger === 'Integer'
        ? 'Number.isInteger(value)'
        : 'Number.isSafeInteger(value)';

  const implied = new Set<string>([
    '-Number.MAX_VALUE',
    'Number.MAX_VALUE',
    ...(integerCheck === 'Number.isSafeInteger(value)'
      ? ['Number.MIN_SAFE_INTEGER', 'Number.MAX_SAFE_INTEGER']
      : []),
  ]);

  const bound = (expr: string): string | undefined => {
    const value = expr.replace(/ as \w+$/u, '');

    return implied.has(value) ? undefined : value;
  };

  const lower = bound(config.minValueExpr);

  const upper = bound(config.maxValueExpr);

  // `1 <= value` or `value <= -1` leaves out zero already.
  const boundExcludesZero =
    /^(?:[1-9]|Number\.MIN_VALUE$)/u.test(config.minValueExpr) ||
    /^-(?:[1-9]|Number\.MIN_VALUE$)/u.test(config.maxValueExpr);

  return [
    integerCheck,
    ...(!boundExcludesZero && config.nonZero ? ['value !== 0'] : []),
    ...(lower === undefined
      ? []
      : [upper === undefined ? `value >= ${lower}` : `${lower} <= value`]),
    ...(upper === undefined ? [] : [`value <= ${upper}`]),
  ];
};

// ---------------------------------------------------------------------------
// JSDoc rendering with prose wrapping
// ---------------------------------------------------------------------------

const wrapText = (text: string, width: number): readonly string[] => {
  const words = text.split(' ');

  const { lines, current } = words.reduce<
    Readonly<{
      lines: readonly string[];
      current: string;
    }>
  >(
    (acc, word) => {
      if (acc.current === '') {
        return { lines: acc.lines, current: word };
      }

      const candidate = `${acc.current} ${word}` as const;

      return candidate.length <= width
        ? { lines: acc.lines, current: candidate }
        : { lines: [...acc.lines, acc.current], current: word };
    },
    { lines: [], current: '' },
  );

  return current === '' ? lines : [...lines, current];
};

const renderJsDoc = (
  prose: MethodProse,
  indentLevel: number,
  withExample: boolean,
): string => {
  const indent = '  '.repeat(indentLevel);

  const textWidth = 80 - indent.length - 3; // account for ` * `

  const descriptionLines = prose.description
    .split('\n\n')
    .map((para) => (para === '' ? [''] : wrapText(para, textWidth)))
    .reduce<readonly string[]>(
      (acc, para, index) => (index === 0 ? para : [...acc, '', ...para]),
      [],
    );

  const tagLines = [
    ...prose.params.map((p) => `@param ${p.name} - ${p.desc}`),
    ...(prose.returns !== undefined
      ? ([`@returns ${prose.returns}`] as const)
      : ([] as const)),
    ...(prose.throws !== undefined
      ? ([`@throws ${prose.throws}`] as const)
      : ([] as const)),
    ...(prose.see !== undefined
      ? ([`@see ${prose.see}`] as const)
      : ([] as const)),
  ] as const;

  const body: readonly string[] = [
    ...descriptionLines,
    ...(withExample
      ? (['', '@example', '', '```ts', '```'] as const)
      : ([] as const)),
    ...(Arr.isNonEmpty(tagLines) ? ([''] as const) : ([] as const)),
    ...tagLines,
  ] as const;

  return [
    `${indent}/**`,
    ...body.map((line) =>
      line === '' ? `${indent} *` : `${indent} * ${line}`,
    ),
    `${indent} */`,
  ].join('\n');
};

// ---------------------------------------------------------------------------
// Top-level functions and the namespace
// ---------------------------------------------------------------------------

const renderTopLevel = (
  config: BrandedNumberConfig,
  which: 'guard' | 'cast',
): string => {
  const prose = resolveProse(
    which === 'guard' ? 'topGuard' : 'topCast',
    config,
  );

  const t = config.pascalName;

  const decl =
    which === 'guard'
      ? [
          `export const is${t} = (value: number): value is ${t} =>`,
          `  ${guardConditions(config).join(' && ')};`,
        ].join('\n')
      : [
          config.enumSpec === undefined
            ? `export const as${t} = <N extends number>(value: N): ${t} & N => {`
            : `export const as${t} = (value: number): ${t} => {`,
          `  if (!is${t}(value)) {`,
          // eslint-disable-next-line no-template-curly-in-string -- source text of the generated module, interpolated there
          '    throw new TypeError(`Expected ${typeNameInMessage}, got: ${value}`);',
          '  }',
          '',
          '  return value;',
          '};',
        ].join('\n');

  return [
    renderJsDoc(prose, 0, config.hasExamples && prose.hasExample),
    decl,
  ].join('\n');
};

/** What a namespace key holds: `is<T>`, or a constant of the module. */
const namespaceMemberValue = (
  key: string,
  config: BrandedNumberConfig,
): string =>
  key === 'is' ? (`is${config.pascalName}` as const) : namespaceLocalName(key);

const renderNamespace = (config: BrandedNumberConfig): string => {
  const members = config.namespaceKeys
    .map((key: string) => {
      const prose = resolveProse(key, config);

      const value = namespaceMemberValue(key, config);

      const member =
        value === key
          ? (`  ${key},` as const)
          : (`  ${key}: ${value},` as const);

      return [
        renderJsDoc(prose, 1, config.hasExamples && prose.hasExample),
        member,
      ].join('\n');
    })
    .join('\n\n');

  return [
    renderJsDoc(resolveProse('namespace', config), 0, false),
    `export const ${config.pascalName} = {`,
    members,
    '} as const;',
  ].join('\n');
};

const renderExpectType = (config: BrandedNumberConfig): readonly string[] => {
  if (config.numberClassParams === undefined) {
    return [];
  }

  const numberClass = [
    'TsDataForgeInternals.RefinedNumberUtils.NumberClass<',
    '    ElementType,',
    `    ${config.numberClassParams}`,
    '  >',
  ].join('\n');

  return [
    ...(config.trailingExpectTypeExtra !== undefined
      ? ['', config.trailingExpectTypeExtra]
      : []),
    ...(config.absType !== undefined
      ? [
          '',
          `expectType<ReturnType<typeof ${config.pascalName}.abs>, ${config.absType}>('=');`,
        ]
      : []),
    '',
    `expectType<keyof typeof ${config.pascalName}, keyof ${numberClass}>('=');`,
    '',
    `expectType<typeof ${config.pascalName}, ${numberClass}>('<=');`,
  ];
};

const renderBrandedModule = (config: BrandedNumberConfig): string =>
  [
    renderImports(config),
    '',
    `export type ${config.pascalName} = TtfImported_${config.ttfType};`,
    '',
    ...(brandedModuleUses(config, 'ElementType')
      ? [`type ElementType = ${config.elementTypeRhs};`, '']
      : []),
    `const typeNameInMessage = '${config.typeNameInMessage}';`,
    ...(config.customConsts !== undefined ? ['', config.customConsts] : []),
    ...(config.leadingExpectType !== undefined
      ? ['', config.leadingExpectType]
      : []),
    '',
    renderTopLevel(config, 'guard'),
    '',
    renderTopLevel(config, 'cast'),
    '',
    renderNamespace(config),
    ...renderExpectType(config),
    '',
  ].join('\n');

// ---------------------------------------------------------------------------
// Enum modules (int8 / uint8): hand-wrapped around a wider base type
// ---------------------------------------------------------------------------

type EnumSpec = Readonly<{ wideBase: string; hasAbs: boolean }>;

const renderEnumImports = (
  config: BrandedNumberConfig,
  enumSpec: EnumSpec,
): string =>
  [
    `import type { ${config.ttfType} as TtfImported_${config.ttfType} } from 'ts-type-forge';`,
    `import type { ${enumSpec.wideBase} } from 'ts-type-forge';`,
    "import type { StrictExclude } from 'ts-type-forge';",
    ...(enumSpec.hasAbs
      ? ["import type { AbsoluteValue } from 'ts-type-forge';"]
      : []),
    "import { expectType } from '../../expect-type.mjs';",
    internalsTypeImport,
    operatorsImport(config),
  ].join('\n');

const renderEnumWrappers = (
  config: BrandedNumberConfig,
  enumSpec: EnumSpec,
): string => {
  const t = config.pascalName;

  const absConst = [
    `const abs = <N extends ${t}>(x: N): AbsoluteValue<N> =>`,
    '  // eslint-disable-next-line total-functions/no-unsafe-type-assertion, @typescript-eslint/no-unnecessary-type-assertion -- unnecessary only under the strict standard library; the stock one types `Math.abs` as returning `number`',
    '  Math.abs(x) as unknown as AbsoluteValue<N>;',
  ].join('\n');

  // The imported operators work on `wideBase`; each wrapper narrows back.
  const castType = `as${t}` as const;

  return [
    `const fromNumber = (a: number): ${t} => ${castType}(fromNumberImpl(a));`,
    ...(enumSpec.hasAbs ? [absConst] : []),
    `const min_ = (...values: readonly ${t}[]): ${t} =>\n  ${castType}(Math.min(...values));`,
    `const max_ = (...values: readonly ${t}[]): ${t} =>\n  ${castType}(Math.max(...values));`,
    `const pow = (x: ${t}, y: ${t}): ${t} => fromNumber(x ** y);`,
    `const add = (x: ${t}, y: ${t}): ${t} => fromNumber(x + y);`,
    `const sub = (x: ${t}, y: ${t}): ${t} => fromNumber(x - y);`,
    `const mul = (x: ${t}, y: ${t}): ${t} => fromNumber(x * y);`,
    `const div = (x: ${t}, y: StrictExclude<${t}, 0>): ${t} => fromNumber(Math.floor(x / y));`,
    `const random = (min: ${t}, max: ${t}): ${t} =>\n  ${castType}(randomImpl(castTypeImpl(min), castTypeImpl(max)));`,
  ].join('\n\n');
};

const renderEnumExpectType = (
  config: BrandedNumberConfig,
  enumSpec: EnumSpec,
): string =>
  [
    'expectType<',
    `  keyof typeof ${config.pascalName},`,
    '  keyof TsDataForgeInternals.RefinedNumberUtils.NumberClass<',
    `    ${enumSpec.wideBase},`,
    `    ${config.numberClassParams}`,
    '  >',
    ">('=');",
  ].join('\n');

const renderEnumModule = (
  config: BrandedNumberConfig,
  enumSpec: EnumSpec,
): string =>
  [
    renderEnumImports(config, enumSpec),
    '',
    `export type ${config.pascalName} = TtfImported_${config.ttfType};`,
    '',
    `const typeNameInMessage = '${config.typeNameInMessage}';`,
    '',
    renderTopLevel(config, 'guard'),
    '',
    renderTopLevel(config, 'cast'),
    '',
    renderEnumWrappers(config, enumSpec),
    '',
    renderNamespace(config),
    '',
    renderEnumExpectType(config, enumSpec),
    '',
  ].join('\n');
