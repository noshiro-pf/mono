{
  "name": "ts-type-forge",
  "version": "6.0.0",
  "private": false,
  "keywords": [
    "typescript",
    "utility",
    "types",
    "static-typing",
    "mapped-types"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/noshiro-pf/ts-type-forge.git"
  },
  "license": "Apache-2.0",
  "author": "noshiro-pf <noshiro.pf@gmail.com>",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts"
      }
    },
    "./global": {
      "import": {
        "types": "./dist/global.d.mts"
      }
    }
  },
  "types": "./dist/index.d.mts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsx ./scripts/cmd/build.mts",
    "build:min": "tsx ./scripts/cmd/build.mts --skip-check",
    "check:ext": "tsx ./scripts/cmd/check-ext.mts",
    "check-all": "tsx ./scripts/cmd/check-all.mts",
    "codemod": "run-s codemod:uncommitted:as-const fmt codemod:uncommitted:readonly fmt",
    "codemod:full": "run-s codemod:full:as-const fmt codemod:full:readonly fmt",
    "codemod:full:as-const": "append-as-const '{scripts,test}/**/*.{mts,tsx}'",
    "codemod:full:readonly": "convert-to-readonly '{scripts,test}/**/*.{mts,tsx}'",
    "codemod:uncommitted:as-const": "append-as-const --uncommitted '{scripts,test}/**/*.{mts,tsx}'",
    "codemod:uncommitted:readonly": "convert-to-readonly --uncommitted '{scripts,test}/**/*.{mts,tsx}'",
    "cspell": "cspell \"**\" --gitignore --gitignore-root ./ --no-progress",
    "doc": "tsx ./scripts/cmd/gen-docs.mts",
    "doc:embed": "tsx ./scripts/cmd/embed-examples.mts",
    "doc:embed:jsdoc": "tsx ./scripts/cmd/embed-examples-in-jsdoc.mts",
    "doc:preview": "vite preview --config ./configs/vite.doc.config.mts",
    "doc:watch": "typedoc --options ./configs/typedoc.config.mjs --watch",
    "fmt": "format-uncommitted",
    "fmt:diff": "format-diff-from origin/main",
    "fmt:full": "prettier --write .",
    "gh:apply-all": "gh-apply-all",
    "gh:apply-repository-settings": "gh-apply-repository-settings",
    "gh:apply-rulesets": "gh-apply-rulesets",
    "gh:apply-variables": "gh-apply-variables",
    "gh:backup-all": "gh-backup-all",
    "gh:backup-repository-settings": "gh-backup-repository-settings",
    "gh:backup-rulesets": "gh-backup-rulesets",
    "gi": "run-s gi:src fmt",
    "gi:src": "gen-index-ts ./src --index-ext .mts --export-ext .mjs --target-ext .mts --exclude '*.test.mts' --exclude global.mts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "md": "markdownlint-cli2",
    "test": "run-p test:*",
    "test:ambient": "node ./node_modules/typescript-native/bin/tsc --noEmit -p ./test/imports/tsconfig.ambient.json",
    "test:named": "node ./node_modules/typescript-native/bin/tsc --noEmit -p ./test/imports/tsconfig.named.json",
    "test:src": "node ./node_modules/typescript-native/bin/tsc --noEmit -p ./tsconfig.json",
    "tsc": "run-p test:*",
    "tscw": "node ./node_modules/typescript-native/bin/tsc --noEmit --watch -p ./tsconfig.json",
    "type-check": "node ./node_modules/typescript-native/bin/tsc --noEmit"
  },
  "devDependencies": {
    "@semantic-release/changelog": "6.0.3",
    "@semantic-release/commit-analyzer": "13.0.1",
    "@semantic-release/exec": "7.1.0",
    "@semantic-release/git": "10.0.1",
    "@semantic-release/github": "12.0.9",
    "@semantic-release/npm": "13.1.5",
    "@semantic-release/release-notes-generator": "14.1.1",
    "@types/node": "26.1.1",
    "cmd-ts": "0.15.0",
    "conventional-changelog-conventionalcommits": "10.2.1",
    "cspell": "10.0.1",
    "dedent": "1.7.2",
    "eslint": "10.6.0",
    "eslint-config-typed": "5.4.0",
    "github-settings-as-code": "1.2.9",
    "jiti": "2.7.0",
    "markdownlint": "0.41.0",
    "markdownlint-cli2": "0.23.0",
    "npm-run-all2": "9.0.2",
    "prettier": "3.9.4",
    "prettier-plugin-organize-imports": "4.3.0",
    "prettier-plugin-packagejson": "3.0.2",
    "semantic-release": "25.0.5",
    "ts-codemod-lib": "2.2.1",
    "ts-data-forge": "7.1.1",
    "ts-fortress": "8.5.1",
    "ts-repo-utils": "10.1.2",
    "tslib": "2.8.1",
    "tsx": "4.22.4",
    "typedoc": "0.28.19",
    "typedoc-github-theme": "0.4.0",
    "typescript": "6.0.3",
    "typescript-native": "npm:typescript@7.0.1-rc",
    "vite": "8.1.3"
  },
  "packageManager": "pnpm@11.10.0+sha512.0b7f8b98060031904c017e3a41eb187a16d40eeb829b95c4f8cb03681761fc4ab53dd219115b9b447f4dce1a05a214764461e7d3703392a9f32f9511ce8c86c8",
  "engines": {
    "node": ">=22.22.2",
    "pnpm": ">=9.0.0"
  },
  "volta": {
    "node": "26.3.1"
  }
}
