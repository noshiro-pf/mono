{
  "extends": "../../../tools/configs/tsconfig/tsconfig.build.json",
  "compilerOptions": {
    // The published declarations must not depend on any standard library:
    // `strict-ts-lib-v*` imports ts-type-forge, so this package is the root
    // of that type dependency graph and must not depend on a lib back (and
    // certainly not on the DOM shapes the shared config would pull in). With
    // no lib files loaded, ./minimal-lib.d.mts (in `include` below) supplies
    // the global types the compiler requires and the lib utility types the
    // source references — see the header comment there.
    "lib": [],
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "outDir": "../dist",
    "declarationDir": "../dist",
    "rootDir": "../src"
  },
  "include": ["../src", "./minimal-lib.d.mts"],
  "exclude": ["../src/**/*.test.mts"]
}
