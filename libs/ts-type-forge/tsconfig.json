{
  "extends": ["../../tools/configs/tsconfig/tsconfig.type-check.json"],
  "compilerOptions": {
    // This is the dev-side program only (type tests, samples, scripts); what
    // the package publishes is checked by configs/tsconfig.build.json, which
    // sets `lib: []` so the published declarations depend on no standard
    // library at all — see the comment there and configs/minimal-lib.d.mts.
    //
    // Here a real lib is needed: the type tests assert against Node globals
    // (e.g. DeepReadonly<URL>) and the scripts run under Node. It is ESNext
    // without DOM because pulling in the DOM lib resolves those globals to
    // the DOM shapes instead and breaks the assertions.
    "lib": ["ESNext"],

    // Deliberately opted OUT of the strict standard library, and stated here
    // rather than left to the default so that moving `libReplacement` into the
    // shared config does not quietly opt this package in.
    //
    // The strict library depends on this package: 18 of its 107 declaration
    // files import `ts-type-forge`, for roughly 25 types. Opting in would make
    // that dependency mutual. Worse, it would not even be this copy — pnpm
    // resolves the strict library's `ts-type-forge` from the registry, so the
    // package would be type-checked against a published snapshot of itself.
    //
    // `Math.abs` is what that looks like in practice: the strict library
    // declares it `abs<N extends number>(x: N): AbsoluteValue<N>`, and
    // `AbsoluteValue` is defined over number *literals*, so a branded
    // `NegativeNumber` comes back still typed negative. It cannot be fixed in
    // `AbsoluteValue` either — `ts-data-forge`'s `Int8.abs` depends on that
    // pass-through. See docs/strict-typescript-lib-integration.md.
    "libReplacement": false,

    "paths": {
      "ts-type-forge": ["./src/entry-point.mts"],
      "ts-type-forge/global": ["./src/global.mts"]
    }
  },
  "include": ["./src", "./samples", "./scripts", "./configs"],
  // configs/minimal-lib.d.mts belongs to the `lib: []` build program only:
  // its type aliases (Readonly, Record, ...) would be duplicate identifiers
  // against the real lib this program loads.
  "exclude": ["src/global.mts", "configs/minimal-lib.d.mts"]
}
