{
  "extends": ["../../tools/configs/tsconfig/tsconfig.type-check.json"],
  "compilerOptions": {
    // ts-type-forge asserts exact type equality against Node types (e.g.
    // DeepReadonly<URL>); pulling in the DOM lib resolves those globals to the
    // DOM shapes instead and breaks the assertions.
    "lib": ["ESNext"],
    "paths": {
      // The strict standard library. Every built-in library lives inside the
      // one `strict-ts-lib-v7.0` package, so this wildcard is what points
      // `libReplacement` at it. `paths` is replaced — not merged — by a config
      // that `extends` another, so a package defining any `paths` of its own
      // has to repeat this one; `check:root:tsconfig-lib-paths` enforces that,
      // because a missing entry disables the replacement with no diagnostic.
      "@typescript/lib-*": ["../../node_modules/strict-ts-lib-v7.0/libs/*"],
      "ts-type-forge": ["./src/entry-point.mts"],
      "ts-type-forge/global": ["./src/global.mts"]
    }
  },
  "include": ["./src", "./samples", "./scripts", "./configs"],
  "exclude": ["src/global.mts"]
}
