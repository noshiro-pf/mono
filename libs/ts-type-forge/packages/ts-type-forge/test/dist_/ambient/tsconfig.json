{
  // Type-checks the built `dist/global.d.mts` output through the real
  // package.json `exports['./global']` entry, referenced the same way the
  // README instructs consumers to load the ambient globals
  // (`/// <reference types="ts-type-forge/global" />`):
  // `scripts/cmd/build.mts` materializes a minimal
  // `test/dist_/node_modules/ts-type-forge` package (package.json + dist), so
  // the reference resolves exactly like an external consumer's.
  //
  // Kept strictly separate from ../named/ (own tsconfig, own directory): the
  // ambient globals loaded here would break the "non-imported names are not
  // reachable" assertions of the named-import program.
  //
  // Deliberately self-contained (no `extends`, no test-library dependencies)
  // and conservative, so that older TypeScript versions can run it in the
  // compatibility matrix
  // (.github/workflows/typescript-version-compatibility.yml).
  // `types: []` prevents auto-inclusion of node_modules/@types: the
  // repository's @types/node requires a recent TypeScript and would produce
  // unrelated lib-conflict errors on the older compilers in the matrix.
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ESNext",
    "lib": ["ESNext", "DOM"],
    "types": [],
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": false
  },
  "include": ["./*.mts"]
}
