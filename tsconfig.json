{
  "extends": [
    "./tools/configs/tsconfig/tsconfig.type-check.json",
    "./tools/configs/tsconfig/tsconfig.vite.json"
  ],
  "compilerOptions": {
    // Opted into the strict standard library like every workspace member
    // (`check:root:tsconfig-lib-replacement` holds each to stating it);
    // `tools/scripts/strict-lib-active.mts` is this program's probe.
    "libReplacement": true
  },
  "include": [
    "./tools/**/*",
    "./**/eslint.config*.mts",
    "./**/configs/**/*.mts",
    "./**/configs/**/*.ts",
    "./**/vite.config.mts",
    "./.markdownlint-cli2.mjs"
  ],
  "exclude": [
    "node_modules",
    "**/node_modules",
    "**/dist",
    // `./**/configs/**` means a package's `configs/`, not a `src/configs/`
    // (eslint-config-typed, @sumi-lang/cli) that the package's own
    // `check:types` already checks under its own settings.
    "**/src",
    // Legacy monorepo contents, outside the pnpm workspace. Its dependencies
    // are never installed, so the `./**/configs/**/*.ts` include above would
    // otherwise surface hundreds of unresolvable-import errors.
    "experimental",
    // Checked against the generated strict library by the harnesses'
    // `tsconfig.lib-check*.json`; their assertions (`globalThis.NaN` is an
    // error there) fail against the stock library this program loads.
    "strict-lib/configs/tsconfig/lib-check-entry*.ts"
  ]
}
