{
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "target": "ESNext",
    "module": "NodeNext",
    "moduleResolution": "nodenext",
    "noEmit": true,
    "skipLibCheck": false,
    "libReplacement": true,
    "paths": {
      "@typescript/lib-*": ["./node_modules/strict-ts-lib-v7.0/libs/*"]
    }
  },
  "include": ["strict-ts-lib-v7.0.mts"]
}
