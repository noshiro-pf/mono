{
  "name": "@sumi-lang/cli",
  "version": "0.0.3",
  "private": true,
  "description": "The `sumi` command (D-46): `sumi check` runs the whole Sumi lint check in one go (locked compilerOptions validation, native tsc, the oxlint preset), and the package exports the base tsconfig plus the ESLint / oxlint fragments that turn off what `sumi check` already covers. See languages/sumi/docs/decisions.md.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/noshiro-pf/mono.git",
    "directory": "languages/sumi/cli"
  },
  "license": "Apache-2.0",
  "author": "noshiro-pf <noshiro.pf@gmail.com>",
  "sideEffects": [
    "./dist/cmd/*.mjs"
  ],
  "type": "module",
  "exports": {
    ".": "./src/entry-point.mts",
    "./tsconfig.base.json": "./tsconfig.base.json",
    "./oxlint-config-off": "./oxlint-config-off.json"
  },
  "bin": {
    "sumi": "./dist/cmd/sumi.mjs"
  },
  "files": [
    "dist",
    "tsconfig.base.json",
    "oxlint-config-off.json"
  ],
  "scripts": {
    "build": "node ../../../node_modules/typescript-native/bin/tsc -p ./configs/tsconfig.build.json",
    "check:cspell": "cspell \"**\" --gitignore --gitignore-root ../../../ --no-progress",
    "check:lint": "eslint .",
    "check:test": "pnpm run z:vitest:node run",
    "check:types": "node ../../../node_modules/typescript-native/bin/tsc --noEmit",
    "fix:codemod": "tsx --tsconfig ../../../tools/configs/tsconfig.tsx.json ../../../libs/ts-codemod-cli/src/cmd/ts-codemod.mts --uncommitted --transformer append-as-const --transformer convert-to-readonly '{src,scripts,test}/**/*.mts' && pnpm run fix:fmt",
    "fix:codemod:full": "tsx --tsconfig ../../../tools/configs/tsconfig.tsx.json ../../../libs/ts-codemod-cli/src/cmd/ts-codemod.mts --transformer append-as-const --transformer convert-to-readonly '{src,scripts,test}/**/*.mts' && pnpm run fix:fmt",
    "fix:fmt": "tsx --tsconfig ../../../tools/configs/tsconfig.tsx.json ../../../libs/ts-repo-utils/src/cmd/format-uncommitted.mts --cwd .",
    "fix:fmt:diff": "tsx --tsconfig ../../../tools/configs/tsconfig.tsx.json ../../../libs/ts-repo-utils/src/cmd/format-diff-from.mts origin/main --cwd .",
    "fix:fmt:full": "prettier --write .",
    "fix:lint": "eslint . --fix",
    "fmt": "pnpm run fix:fmt",
    "gen": "run-s gen:index gen:oxlint-config-off",
    "gen:index": "pnpm run gen:index:src && pnpm run fix:fmt",
    "gen:index:src": "tsx --tsconfig ../../../tools/configs/tsconfig.tsx.json ../../../libs/ts-repo-utils/src/cmd/gen-index-ts.mts ./src --index-ext .mts --export-ext .mjs --target-ext .mts --exclude entry-point.mts --exclude 'cmd/*'",
    "gen:oxlint-config-off": "tsx --tsconfig ../../../tools/configs/tsconfig.tsx.json ./scripts/cmd/gen-oxlint-config-off.mts && pnpm run fix:fmt",
    "sumi": "tsx --tsconfig ../../../tools/configs/tsconfig.tsx.json ./src/cmd/sumi.mts",
    "sumi:demo": "pnpm run sumi check ./demo/violations",
    "sumi:demo:options": "pnpm run sumi check ./demo/unlocked-options",
    "test": "pnpm run check:test",
    "watch:test": "pnpm run z:vitest:node watch",
    "z:vitest": "vitest --config ./configs/vitest.config.mts",
    "z:vitest:node": "pnpm run z:vitest --project='Node.js'"
  },
  "dependencies": {
    "@sumi-lang/checker": "workspace:*",
    "@sumi-lang/oxlint-config": "workspace:*",
    "cmd-ts": "^0.15.0",
    "ts-data-forge": "workspace:*",
    "typescript-native": "npm:typescript@7.0.2"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "cspell": "catalog:",
    "dedent": "catalog:",
    "eslint": "catalog:",
    "eslint-config-typed": "workspace:*",
    "jiti": "catalog:",
    "prettier": "catalog:",
    "prettier-plugin-organize-imports": "catalog:",
    "prettier-plugin-packagejson": "catalog:",
    "ts-type-forge": "workspace:~",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=22.22.2",
    "pnpm": ">=9.0.0"
  },
  "volta": {
    "node": "26.8.2"
  }
}
