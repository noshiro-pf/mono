{
  // The compilerOptions the fixtures are type-checked under by the engines
  // that need type information (oxlint-tsgolint discovers this file per
  // fixture). It is the Sumi base tsconfig draft (docs/sumi/spec/
  // compiler-options.md, D-40): the locked options verbatim, and the free
  // ones at their defaults.
  "compilerOptions": {
    // ---- type-checking strictness (locked) ----
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": false,
    "noImplicitReturns": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noPropertyAccessFromIndexSignature": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "allowUnusedLabels": false,
    "allowUnreachableCode": false,

    // ---- subset constraints (locked) ----
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": false,
    "rewriteRelativeImportExtensions": false,
    "experimentalDecorators": false,
    "emitDecoratorMetadata": false,
    "allowJs": false,
    "checkJs": false,

    // ---- module resolution (locked) ----
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "moduleDetection": "force",

    // ---- standard library (locked) ----
    "libReplacement": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "useDefineForClassFields": true,
    "jsx": "react-jsx",

    // ---- environment (free) ----
    "lib": ["esnext"],
    "types": [],
    "target": "esnext",

    // ---- output (free) ----
    "noEmit": true
  },
  "include": ["**/*.mts"]
}
