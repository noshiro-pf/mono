{
  // Emits the sumi JS plugin to dist/: oxlint loads it through Node, which
  // resolves `.mjs` specifiers only against real files, so the plugin cannot
  // be loaded from the `.mts` sources the way jiti / vite resolve them.
  "extends": "../../../../tools/configs/tsconfig/tsconfig.build.json",
  "compilerOptions": {
    "rootDir": "../src",
    "outDir": "../dist",
    "declaration": true,
    "types": ["node"]
  },
  "include": ["../src"]
}
