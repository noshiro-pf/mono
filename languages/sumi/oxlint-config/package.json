{
  "name": "@sumi-lang/oxlint-config",
  "version": "0.0.3",
  "private": true,
  "description": "oxlint preset for Sumi lint: the fixed rule set, the sumi JS plugin (rules oxlint has no native equivalent for), and the neutral rule-ID mapping the conformance corpus runs against. See languages/sumi/docs/enforcement-map.md.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/noshiro-pf/mono.git",
    "directory": "languages/sumi/oxlint-config"
  },
  "license": "Apache-2.0",
  "author": "noshiro-pf <noshiro.pf@gmail.com>",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": "./src/entry-point.mts"
  },
  "files": [
    "dist",
    "oxlintrc.jsonc"
  ],
  "scripts": {
    "build": "node ../../../node_modules/typescript-native/bin/tsc -p ./configs/tsconfig.build.json",
    "check:cspell": "cspell \"**\" --gitignore --gitignore-root ../../../ --no-progress",
    "check:lint": "eslint .",
    "check:test": "pnpm run z:vitest:node run",
    "check:types": "node ../../../node_modules/typescript-native/bin/tsc --noEmit",
    "fix:codemod": "tsx --tsconfig ../../../tools/configs/tsconfig.tsx.json ../../../libs/ts-codemod-cli/src/cmd/ts-codemod.mts --uncommitted --transformer append-as-const --transformer convert-to-readonly '{src,scripts,test}/**/*.mts' && pnpm run fix:fmt",
    "fix:codemod:full": "tsx --tsconfig ../../../tools/configs/tsconfig.tsx.json ../../../libs/ts-codemod-cli/src/cmd/ts-codemod.mts --transformer append-as-const --transformer convert-to-readonly '{src,scripts,test}/**/*.mts' && pnpm run fix:fmt",
    "fix:fmt": "tsx --tsconfig ../../../tools/configs/tsconfig.tsx.json ../../../libs/ts-repo-utils/src/cmd/format-uncommitted.mts --cwd .",
    "fix:fmt:diff": "tsx --tsconfig ../../../tools/configs/tsconfig.tsx.json ../../../libs/ts-repo-utils/src/cmd/format-diff-from.mts origin/main --cwd .",
    "fix:fmt:full": "prettier --write .",
    "fix:lint": "eslint . --fix",
    "fmt": "pnpm run fix:fmt",
    "gen": "run-s gen:index",
    "gen:index": "pnpm run gen:index:src && pnpm run fix:fmt",
    "gen:index:src": "tsx --tsconfig ../../../tools/configs/tsconfig.tsx.json ../../../libs/ts-repo-utils/src/cmd/gen-index-ts.mts ./src --index-ext .mts --export-ext .mjs --target-ext .mts --exclude entry-point.mts --preserve 'plugin/index.mts'",
    "test": "pnpm run check:test",
    "watch:test": "pnpm run z:vitest:node watch",
    "z:vitest": "vitest --config ./configs/vitest.config.mts",
    "z:vitest:node": "pnpm run z:vitest --project='Node.js'"
  },
  "dependencies": {
    "@typescript-eslint/utils": "^8.70.0",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "ts-data-forge": "workspace:*",
    "typescript": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "cspell": "catalog:",
    "eslint": "catalog:",
    "eslint-config-typed": "workspace:*",
    "jiti": "catalog:",
    "prettier": "catalog:",
    "prettier-plugin-organize-imports": "catalog:",
    "prettier-plugin-packagejson": "catalog:",
    "ts-type-forge": "workspace:~",
    "tsx": "catalog:",
    "typescript-native": "npm:typescript@7.0.2",
    "vitest": "catalog:"
  },
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=22.22.2",
    "pnpm": ">=9.0.0"
  },
  "volta": {
    "node": "26.9.0"
  }
}
