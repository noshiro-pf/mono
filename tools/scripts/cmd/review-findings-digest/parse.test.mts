// cspell:ignore xhigh
import dedent from 'dedent';
import type { FixedLengthTuple } from 'ts-type-forge';
import {
  extractReviewSection,
  levelsIn,
  parseReview,
  roundsIn,
  type Finding,
} from './parse.mjs';

// The fixtures are shortened from real descriptions of merged pull requests
// in this repository; each keeps the shape it exercises.

const summary = (
  findings: readonly Finding[],
): readonly FixedLengthTuple<2, string>[] =>
  findings.map(({ disposition, text }) => [disposition, text] as const);

describe('extractReviewSection', () => {
  test('stops at the next section, the trailers and the footer', () => {
    const body = dedent`
      ## What changes

      Something.

      ## Review (\`/code-review xhigh\`, two rounds)

      - **Fixed**: a thing.

      ### Not a section end

      ## Checks run locally

      \`fmt\`.
    `;

    assert.deepStrictEqual(extractReviewSection(body), {
      heading: 'Review (`/code-review xhigh`, two rounds)',
      lines: ['', '- **Fixed**: a thing.', '', '### Not a section end', ''],
    });

    for (const end of [
      'Claude-Session: [title](https://claude.ai/code/session_x)',
      'Merge-After: #1',
      '---',
      '🤖 Generated with [Claude Code](https://claude.com/claude-code)',
      '_Generated by [Claude Code](https://claude.ai/code)_',
    ]) {
      assert.deepStrictEqual(
        extractReviewSection(`## Review\n\nOne round.\n\n${end}\n\ntail`)
          ?.lines,
        ['', 'One round.', ''],
      );
    }
  });

  test('reads CRLF bodies, and is undefined without a section', () => {
    assert.deepStrictEqual(
      extractReviewSection('## Review\r\nOne round.\r\n## Next'),
      { heading: 'Review', lines: ['One round.'] },
    );

    assert.isUndefined(extractReviewSection('## Reviewing\n\nNo.'));

    assert.isUndefined(extractReviewSection('Body without sections.'));
  });
});

describe('levelsIn', () => {
  test('lists each level once, in order', () => {
    assert.deepStrictEqual(
      levelsIn(
        'Seven `/code-review xhigh` rounds; three `/code-review high` rounds; one more `/code-review xhigh`.',
      ),
      ['xhigh', 'high'],
    );

    assert.deepStrictEqual(levelsIn('No level here.'), []);
  });
});

describe('roundsIn', () => {
  test.each([
    ['`/code-review high` ran six rounds.', 6],
    ['`/code-review high`, two rounds. The second round found nothing new.', 2],
    ['I ran `/code-review high` for seven rounds.', 7],
    ['One round, no findings.', 1],
    ['I ran `/code-review high` three times. I did not run a fourth round.', 3],
    ['I ran `/code-review high` twice.', 2],
    ['`/code-review xhigh` ran twice. The first round found six problems.', 2],
    ['Ran five rounds of `/code-review xhigh`.', 5],
    [
      'Seven `/code-review xhigh` rounds before opening. Three `/code-review high` rounds on the amend.',
      10,
    ],
    ['It ran six rounds on the filters. After that, it ran twice more.', 8],
    ['`/code-review high` ran 11 rounds.', 11],
    [
      'I ran `/code-review high` three times: two rounds before opening and one round on the amend.',
      3,
    ],
    ['Two rounds of `/code-review high`. I ran `pnpm run fmt` once more.', 2],
    [
      '`/code-review high`, one round. I ran the flaky test 5 times to be sure.',
      1,
    ],
    [
      'Two rounds of `/code-review high`. The second of the two rounds found nothing.',
      2,
    ],
    ['One round. Fixed: the fetch makes two round trips.', 1],
    ['Two rounds. Fixed: the hook ran 3 times per commit.', 2],
  ] as const)('%s → %d', (text, expected) => {
    assert.strictEqual(roundsIn(text), expected);
  });

  test.each([
    '`/code-review high` for several rounds.',
    '`/code-review xhigh` on each revision until a round found nothing new.',
    'The first round found six problems; the last round’s four findings were fixed.',
  ])('states no count: %s', (text) => {
    assert.isUndefined(roundsIn(text));
  });
});

describe('parseReview', () => {
  test('a sentence each for the fixed and the dismissed', () => {
    const review = parseReview(dedent`
      ## Review

      \`/code-review high\`, two rounds. Fixed: \`paths\` resolved from the working directory; no test through the real tsconfig reader; the changeset overstating that the old path "matched no \`module\` pattern" (a glob can match an absolute path). Dismissed: "a \`baseUrl\` still set is ignored without a warning" — TypeScript 6 already reports \`baseUrl\` as deprecated, the changeset says what to write instead. The second round found nothing new.

      Claude-Session: [x](https://claude.ai/code/session_x)
    `);

    assert.deepStrictEqual(review?.levels, ['high']);

    assert.strictEqual(review?.rounds, 2);

    assert.deepStrictEqual(summary(review?.findings ?? []), [
      ['fixed', '`paths` resolved from the working directory'],
      ['fixed', 'no test through the real tsconfig reader'],
      [
        'fixed',
        'the changeset overstating that the old path "matched no `module` pattern" (a glob can match an absolute path)',
      ],
      ['dismissed', '"a `baseUrl` still set is ignored without a warning"'],
    ]);
  });

  test('bold labels as bullets, with the findings nested under them', () => {
    const review = parseReview(dedent`
      ## Review (\`/code-review xhigh\`, two rounds)

      - **Fixed**:
        - A read still in flight at stop used to write its result after the stop.
        - The throttle tests' waits were short.
      - **Dismissed**: a finding that the fetch subscription is now registered after the page stores'.
      - **Deferred, existing behavior**: the dialog stays waiting, with its spinner on. A separate issue: #2652.

      ## Checks run locally
    `);

    assert.deepStrictEqual(review?.levels, ['xhigh']);

    assert.strictEqual(review?.rounds, 2);

    assert.deepStrictEqual(review?.findings, [
      {
        disposition: 'fixed',
        text: 'A read still in flight at stop used to write its result after the stop.',
        issues: [],
      },
      {
        disposition: 'fixed',
        text: "The throttle tests' waits were short.",
        issues: [],
      },
      {
        disposition: 'dismissed',
        text: "a finding that the fetch subscription is now registered after the page stores'.",
        issues: [],
      },
      {
        disposition: 'deferred',
        text: 'the dialog stays waiting, with its spinner on. A separate issue: #2652.',
        issues: [2652],
      },
    ]);
  });

  test('"fixed except", with items that name their own disposition', () => {
    const review = parseReview(dedent`
      ## Review

      \`/code-review high\`, five rounds; each finding fixed except:

      - Two \`mapBindable\` calls over \`remaining\` in the sample. Kept: the second sits in \`CharactersLeft\`.
      - The pre-existing sentence about constants. Wording predates this change; left alone.
      - Nothing checks the in-page fragment links. Deferred: #2693.
    `);

    assert.strictEqual(review?.rounds, 5);

    assert.deepStrictEqual(
      review?.findings.map(({ disposition, issues }) => [disposition, issues]),
      [
        ['dismissed', []],
        ['dismissed', []],
        ['deferred', [2693]],
      ],
    );
  });

  test('a running list of fixes, then the dismissed as bullets', () => {
    const review = parseReview(dedent`
      ## Review

      I ran \`/code-review high\` four times and fixed most of what it found: the \`10.0\` rounding boundary, helper ordering, the legend wording, and the guard for an empty emphasis. I did not act on these:

      - **Tie the "single digits" note to the code with a marker.** The note states the rule, not a number.
      - **Tests for \`worstCaseCell\`.** The app has no test setup for its scripts.
    `);

    assert.strictEqual(review?.rounds, 4);

    assert.deepStrictEqual(summary(review?.findings ?? []), [
      ['fixed', 'the `10.0` rounding boundary'],
      ['fixed', 'helper ordering'],
      ['fixed', 'the legend wording'],
      ['fixed', 'the guard for an empty emphasis'],
      [
        'dismissed',
        '**Tie the "single digits" note to the code with a marker.** The note states the rule, not a number.',
      ],
      [
        'dismissed',
        '**Tests for `worstCaseCell`.** The app has no test setup for its scripts.',
      ],
    ]);
  });

  test('a list of fixes that ends with "are fixed"', () => {
    const review = parseReview(dedent`
      ## Review

      \`/code-review high\`: helper order, \`forEachChild\` over \`getChildren\` and the docs wording are fixed. Dismissed:

      - generic fragments matching another query: stated as a limit above.
    `);

    assert.deepStrictEqual(summary(review?.findings ?? []), [
      ['fixed', 'helper order'],
      ['fixed', '`forEachChild` over `getChildren` and the docs wording'],
      [
        'dismissed',
        'generic fragments matching another query: stated as a limit above.',
      ],
    ]);
  });

  test('a heading that says the findings were not fixed, and an item that says it was kept', () => {
    const review = parseReview(dedent`
      ## Review findings not fixed

      From \`/code-review high\`:

      - Cleanup cannot delete a protected answer. Dismissed: only someone holding the secret id could create one.
      - A missing secret fails each test separately. Kept: this happens once.
    `);

    assert.isUndefined(review?.rounds);

    assert.deepStrictEqual(
      review?.findings.map(({ disposition }) => disposition),
      ['dismissed', 'dismissed'],
    );
  });

  test('a deferred sentence is one finding, commas and all', () => {
    const review = parseReview(dedent`
      ## Review (\`/code-review xhigh\`)

      Fixed here:

      - No test covered \`start()\` after \`stop()\` → added.

      Deferred: after a room switch, actions played before the new room's first snapshot are written to the previous room, and the game state is not reset either (pre-existing).

      A second review round over the \`stop()\` change found nothing new.
    `);

    assert.deepStrictEqual(summary(review?.findings ?? []), [
      ['fixed', 'No test covered `start()` after `stop()` → added.'],
      [
        'deferred',
        "after a room switch, actions played before the new room's first snapshot are written to the previous room, and the game state is not reset either (pre-existing)",
      ],
    ]);
  });

  test('a "Deferred to #N" paragraph label, and "deferred or dismissed"', () => {
    const review = parseReview(dedent`
      ## Review

      Deferred to #2616. This change makes these gaps reachable, but they predate it:

      - no check that the room is full

      Deferred or dismissed:

      - **Rule enforcing \`mut_\` on immer recipe parameters**: deferred to #2674.
      - **The guard reads the \`dist/\`**: CI builds before testing.
    `);

    assert.deepStrictEqual(
      review?.findings.map(({ disposition, issues }) => [disposition, issues]),
      [
        ['deferred', [2616]],
        ['deferred', [2674]],
        ['dismissed', []],
      ],
    );
  });

  test('a bullet with nested detail is one finding', () => {
    const review = parseReview(dedent`
      ## Review

      Dismissed by design:

      - **Name-only matching.** Some cases are not recognized:
        - \`DeepMutable<T>\`;
        - \`typeof this.mut_x\`.

        These are documented.
      - **Conservative skip.** It never breaks compilation.
    `);

    assert.deepStrictEqual(summary(review?.findings ?? []), [
      [
        'dismissed',
        '**Name-only matching.** Some cases are not recognized: `DeepMutable<T>`; `typeof this.mut_x`. These are documented.',
      ],
      ['dismissed', '**Conservative skip.** It never breaks compilation.'],
    ]);
  });

  test('numbered rounds that list their findings in running text', () => {
    const review = parseReview(dedent`
      ## Review

      The rule was applied to this pull request: three \`/code-review xhigh\` rounds.

      1. 9 findings. 8 were fixed: how the loop ends, generated output, and a duplicated sentence. 1 was dismissed: "raise the budget instead". The user asked for this addition here.
      2. No findings.
    `);

    assert.strictEqual(review?.rounds, 3);

    assert.deepStrictEqual(summary(review?.findings ?? []), [
      ['fixed', 'how the loop ends'],
      ['fixed', 'generated output'],
      ['fixed', 'a duplicated sentence'],
      ['dismissed', '"raise the budget instead"'],
    ]);
  });

  test('a dash ends each item, not the list', () => {
    const review = parseReview(dedent`
      ## Review

      Fixed: the README — it was stale, the barrel, and the order. Dismissed: the cast — it is checked above; the order — it matches the file.
    `);

    assert.deepStrictEqual(summary(review?.findings ?? []), [
      ['fixed', 'the README'],
      ['fixed', 'the barrel'],
      ['fixed', 'the order'],
      ['dismissed', 'the cast'],
      ['dismissed', 'the order'],
    ]);
  });

  test('a code fence neither ends the section nor holds findings', () => {
    const review = parseReview(dedent`
      ## Review

      Fixed:

      \`\`\`sh
      # run this
      - not a finding
      \`\`\`

      - a real one
    `);

    assert.deepStrictEqual(summary(review?.findings ?? []), [
      ['fixed', 'a real one'],
    ]);
  });

  test('a finding that opens with the verb "Fixed" keeps its subject', () => {
    const review = parseReview(dedent`
      ## Review

      - Fixed the stale README: it now names the flag.
      - Deferred to #7: the rest.
    `);

    assert.deepStrictEqual(review?.findings, [
      {
        disposition: 'unknown',
        text: 'Fixed the stale README: it now names the flag.',
        issues: [],
      },
      { disposition: 'deferred', text: 'the rest', issues: [7] },
    ]);
  });

  test('"…: a and b were fixed: …" is one list', () => {
    const review = parseReview(dedent`
      ## Review

      \`/code-review high\`: the README and the test were fixed: both now pass.
    `);

    assert.deepStrictEqual(summary(review?.findings ?? []), [
      ['fixed', 'the README and the test'],
    ]);
  });

  test('a label that names no disposition goes back to the section default', () => {
    const review = parseReview(dedent`
      ## Review

      Round 1, dismissed:

      - a

      ### Round 2

      - b

      - Round 3:
        - c
        - d
    `);

    assert.deepStrictEqual(summary(review?.findings ?? []), [
      ['dismissed', 'a'],
      ['unknown', 'b'],
      ['unknown', 'c'],
      ['unknown', 'd'],
    ]);
  });

  test('a bracket never closed does not carry the list into the next sentence', () => {
    const review = parseReview(dedent`
      ## Review

      Fixed: a (see #12, b. Dismissed: c — reason.
    `);

    assert.deepStrictEqual(summary(review?.findings ?? []), [
      ['fixed', 'a (see #12, b'],
      ['dismissed', 'c'],
    ]);
  });

  test('a review heading inside a code fence is not the section', () => {
    const review = parseReview(dedent`
      Summary

      \`\`\`md
      ## Review
      - Fixed: template
      \`\`\`

      ## Review

      Fixed: real one.
    `);

    assert.deepStrictEqual(summary(review?.findings ?? []), [
      ['fixed', 'real one'],
    ]);
  });

  test('a round that found nothing is not a finding', () => {
    const review = parseReview(dedent`
      ## Review

      1. Round 1: the README.
      2. Round 2: nothing new.
    `);

    assert.deepStrictEqual(summary(review?.findings ?? []), [
      ['unknown', 'Round 1: the README.'],
    ]);
  });

  test('a paragraph that opens with the verb "Fixed" is not a list', () => {
    const review = parseReview(dedent`
      ## Review

      Fixed the stale README: it said y. Deferred to #9: the rest.

      Fixed in this pull request:

      - the barrel
    `);

    assert.deepStrictEqual(
      review?.findings.map(({ disposition, text, issues }) => [
        disposition,
        text,
        issues,
      ]),
      [
        ['deferred', 'the rest', [9]],
        ['fixed', 'the barrel', []],
      ],
    );
  });

  test('labels with more between the cue and the colon', () => {
    const review = parseReview(dedent`
      ## Review

      Dismissed as out of scope: the README wording; the cast in foo.

      Deferred to #2700 and #2701: the barrel order; the stale doc.

      Fixed (round 2): a, b.
    `);

    assert.deepStrictEqual(
      review?.findings.map(({ disposition, text, issues }) => [
        disposition,
        text,
        issues,
      ]),
      [
        ['dismissed', 'the README wording', []],
        ['dismissed', 'the cast in foo', []],
        ['deferred', 'the barrel order', [2700, 2701]],
        ['deferred', 'the stale doc', [2700, 2701]],
        ['fixed', 'a', []],
        ['fixed', 'b', []],
      ],
    );
  });

  test('a cue in a code span or inside a list opens no list of its own', () => {
    const review = parseReview(dedent`
      ## Review

      Fixed: the \`kept: true\` flag, the README.

      Dismissed: x and y were fixed upstream.
    `);

    assert.deepStrictEqual(summary(review?.findings ?? []), [
      ['fixed', 'the `kept: true` flag'],
      ['fixed', 'the README'],
      ['dismissed', 'x and y were fixed upstream'],
    ]);
  });

  test('a fence closes only on its own marker', () => {
    const review = parseReview(dedent`
      ## Review

      \`\`\`sh
      ~~~
      ## not a heading
      \`\`\`

      Fixed: a.
    `);

    assert.deepStrictEqual(summary(review?.findings ?? []), [['fixed', 'a']]);
  });

  test('a bullet label that names no disposition keeps the one above it', () => {
    const review = parseReview(dedent`
      ## Review

      Fixed:

      - Round 1:
        - a stale README
        - the cast
    `);

    assert.deepStrictEqual(summary(review?.findings ?? []), [
      ['fixed', 'a stale README'],
      ['fixed', 'the cast'],
    ]);
  });

  test('a deferred item keeps the issue named in its reason', () => {
    const review = parseReview(dedent`
      ## Review

      Deferred: the legend overlap — tracked in #77.
    `);

    assert.deepStrictEqual(review?.findings, [
      { disposition: 'deferred', text: 'the legend overlap', issues: [77] },
    ]);
  });

  test('one round with no findings', () => {
    assert.deepStrictEqual(
      parseReview(dedent`
        ## Review (\`/code-review xhigh\`)

        One round, no findings.

        ## Checks run locally
      `),
      { levels: ['xhigh'], rounds: 1, findings: [] },
    );
  });

  test('a description without a review section', () => {
    assert.isUndefined(parseReview('## What changes\n\nA dependency bump.'));
  });
});
