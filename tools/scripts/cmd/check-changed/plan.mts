import { Arr, isRecord, isString } from 'ts-data-forge';
import type { ReadonlyRecord, StrictPick } from 'ts-type-forge';
import { entryPointTargets } from '../assert-deps-built.mjs';
// The gate's own matcher, so that what check-changed calls prose is what CI
// skips. It lives in the gate's script rather than tools/scripts/lib/ because
// that script runs under plain `node`, which resolves an import by the name
// written, and the imports here name `.mjs` files that only tsx maps to `.mts`
// (assert-deps-built.mts above is shared the same way, for the same reason).
import { ignoredBy } from '../workflow-steps.mjs';
/**
 * Which commands a set of changed paths needs: the pure half of
 * `check-changed`, which `main.mts` feeds with what git and the manifests say.
 */

/**
 * Sorts the changed paths into the packages they belong to and the
 * repository-wide areas they touch.
 *
 * A path belongs to the workspace member whose directory is its longest prefix.
 * Under a package, a path the code gate ignores (`proseGate`, the `code` list
 * of `tools/configs/gate-ignore-lists.json` that `code-check.yml` gates on, its
 * `!` exceptions included) touches the package's documents only: its generators
 * run, its type check and tests do not, as CI's would not. `strict-lib/` is an
 * area of its own whatever member a path is in, because its harnesses are
 * checked and generated by the root `strict-lib:*` scripts rather than their
 * own, with `strict-lib-output` beside it for a path the generators read or
 * write; `experimental/` is outside everything.
 */
export const classifyChanges = ({
  files,
  packages,
  proseGate,
}: Readonly<{
  /** Repository-relative, `/`-separated. */
  files: readonly string[];
  packages: readonly PackageInfo[];
  proseGate: readonly string[];
}>): Classification => {
  const mut_touched = new Map<
    string,
    { pkg: PackageInfo; code: boolean; emitted: boolean }
  >();

  const mut_areas = new Set<Area>();

  const mut_ignored: string[] = [];

  const byDepth = packages.toSorted((a, b) => b.dir.length - a.dir.length);

  const isProse = ignoredBy(proseGate);

  for (const file of files) {
    if (file.startsWith('experimental/')) {
      mut_ignored.push(file);

      continue;
    }

    const prose = isProse(file);

    // CI runs `check:root` on every diff its code gate lets through, and the
    // guards in it read package files too (`check:root:example-coverage` reads
    // `src/`, `check:root:tsconfig-paths` every tsconfig), so any such change
    // asks for them. The root program's own type check, lint and tests are
    // slower and read only what the root `tsconfig.json` takes in.
    if (!prose) {
      mut_areas.add('root-guards');
    }

    // `.markdownlint-cli2.mjs` is the one file the gate counts as prose that
    // the root program also type-checks.
    if (
      isRootProgramFile(file) &&
      (!prose || file === '.markdownlint-cli2.mjs')
    ) {
      mut_areas.add('root');
    }

    // A config that decides other files' verdicts asks for the whole check.
    if (SPELL_CONFIG.test(file)) {
      mut_areas.add('spell-config');
    }

    if (FORMAT_CONFIG.has(file)) {
      mut_areas.add('format-config');
    }

    if (MANIFEST_FILES.has(basename(file))) {
      mut_areas.add('manifest');
    }

    if (readsGeneratorInput(file, ROOT_GENERATORS['gen:deps-graph'].inputs)) {
      mut_areas.add('deps-graph');
    }

    if (
      readsGeneratorInput(file, ROOT_GENERATORS['gen:license-files'].inputs) ||
      basename(file) === 'LICENSE'
    ) {
      mut_areas.add('license');
    }

    // What `check:published-deps` lints: the published packages' `src/` and
    // every tracked `eslint.config.mts`.
    if (PUBLISHED_DEPS_INPUT.test(file)) {
      mut_areas.add('published-source');
    }

    // Its tooling's checks for any file under it; its generators, as
    // `strict-lib-gen.yml` runs them, for what they read or write.
    if (file.startsWith('strict-lib/')) {
      mut_areas.add('strict-lib');

      if (STRICT_LIB_GENERATOR_INPUT.test(file)) {
        mut_areas.add('strict-lib-output');
      }

      continue;
    }

    // A page an app builds (`!apps/*/src/`), or a document a unit test reads
    // (`check:root:test-documents`), is code to the gate, and still Markdown,
    // which `check:md` reads unless its `ignores` leave it out. Code, a
    // document a test reads is planned as a change to its package's code (lint,
    // type check, the codemod, its dependents' generators) where its tests are
    // all it needs: that would take a kind of change of its own.
    if (prose || file.endsWith('.md')) {
      mut_areas.add('prose');
    }

    if (file.startsWith('tools/configs/')) {
      mut_areas.add('shared-config');
    }

    if (file.startsWith('.changeset/')) {
      mut_areas.add('changeset');

      continue;
    }

    if (file.startsWith('repo-settings/')) {
      mut_areas.add('repo-settings');

      continue;
    }

    const pkg = byDepth.find(({ dir }) => file.startsWith(`${dir}/`));

    if (pkg === undefined) {
      continue;
    }

    const entry = mut_touched.get(pkg.dir) ?? {
      pkg,
      code: false,
      emitted: false,
    };

    mut_touched.set(pkg.dir, {
      pkg,
      code: entry.code || !prose,
      emitted: entry.emitted || (!prose && isBuildInput(pkg.dir, file)),
    });
  }

  const codeChanged: ReadonlySet<string> = new Set<string>(
    Array.from(mut_touched.values())
      .filter(({ code }) => code)
      .map(({ pkg }) => pkg.name),
  );

  return {
    packages: Array.from(mut_touched.values()).toSorted((a, b) =>
      a.pkg.dir.localeCompare(b.pkg.dir),
    ),
    dependents: packages
      .filter((pkg) =>
        Array.from(pkg.workspaceDependencies).some(
          (name) => name !== pkg.name && codeChanged.has(name),
        ),
      )
      .toSorted((a, b) => a.dir.localeCompare(b.dir)),
    members: packages,
    areas: mut_areas,
    ignored: mut_ignored,
  };
};

/**
 * The commands for a {@link Classification}, in the order they run.
 *
 * - **Format first**, so that what the generators' own `fix:fmt` would do to
 *   a hand-edited file is not later blamed on the generator.
 * - **Generators next**; `main.mts` fails the run when one changes the tree,
 *   naming the generator and the files. The strict-lib generators first, for
 *   `strict-lib-output`; then one package at a time, those of the touched
 *   packages and then those of every member that declares one whose code
 *   changed, which is built first when they read its `dist/`, with the changed
 *   packages it is built against; then the root ones.
 * - **Then the fixers**: the codemod, the formatter over what it reprinted,
 *   and `fix:lint` over the result; then the checks, and the formatter once
 *   more for what the fixers wrote (`fix:fmt:full` instead when Prettier's own
 *   config changed).
 *
 * The codemod is in the plan because no lint rule stands behind it:
 * `prefer-as-const` rewrites `as 'foo'` and says nothing about an `as const`
 * that is missing, so `code-check (fix:codemod:affected)` is otherwise the
 * first thing to mention it.
 *
 * What CI runs that no plan does is `CI_ONLY` in `reach.mts`, and
 * `check:root:check-changed-reach` fails on anything else CI runs that no plan
 * reaches.
 */
export const buildPlan = ({
  classification,
  base,
  rootScripts,
  coverage,
  spellChecked,
}: Readonly<{
  classification: Classification;
  /** The commit the diff is taken from (a merge base). */
  base: string;
  rootScripts: readonly string[];
  coverage: boolean;
  /** The changed files that still exist and are not ignored, for cspell. */
  spellChecked: readonly string[];
}>): readonly Step[] => {
  const { packages, dependents, areas, members } = classification;

  const code = packages.filter(({ code: isCode }) => isCode);

  const dependentGenerators = dependents.filter(({ scripts }) =>
    scripts.has('gen'),
  );

  const changed = code.map(({ pkg }) => pkg);

  const builtForGenerators = changedBuildsFor(
    changed.filter((pkg) =>
      dependentGenerators.some(({ workspaceDependencies }) =>
        workspaceDependencies.has(pkg.name),
      ),
    ),
    changed,
    members,
  );

  const forgottenExportsRead = changed.filter(
    ({ forgottenExportsRead: read }) => read,
  );

  const linted = lintedPackages(code, members);

  const builtForForgottenExports = changedBuildsFor(
    forgottenExportsRead,
    changed,
    members,
  );

  return [
    formatStep('format the diff (before)', base),

    // As `strict-lib-gen.yml` runs them: the series one by one, then the diffs
    // between consecutive series, which read all of them. About two and a half
    // minutes for all twelve, which is why a diff that reaches neither the
    // converter nor its output does not run them; all twelve whatever harness
    // the diff touches, as the workflow runs them, since the diffs read the
    // series beside a regenerated one.
    //
    // Before every other generator, so that one that reads what they write
    // reads it current when the plan runs it: `gen:verify-npm-packages` copies
    // the bundles' manifests, and the synstate-dom packages' `gen` reads the
    // strict `lib.dom` and each harness's `temp/copied/`. The synstate-dom
    // packages' `gen` runs only when the diff touches its package or changes
    // the code of one it declares, since check-changed knows a package
    // generator's inputs only as those; a diff confined to `strict-lib/` leaves
    // it to CI's `ws:gen`. The converter imports some packages' sources, but a
    // package generator that rewrites one fails the run itself, whichever runs
    // first.
    ...(areas.has('strict-lib-output')
      ? [
          rootStep('generate', 'strict-lib:gen:with-codemod-fixed'),
          rootStep('generate', 'strict-lib:gen:version-diff'),
        ]
      : []),

    ...packages.flatMap(({ pkg }) => packageStep(pkg, 'generate', 'gen')),

    // A generator can read a package it declares: the docs measure its bundle
    // and embed its JSDoc, the hooks packages re-export what it exports. Those
    // that read its build output read it rebuilt, with the changed packages it
    // is built against, and a dependent the diff touches runs its generator
    // again for that reason.
    ...builtForGenerators.flatMap((pkg) => packageStep(pkg, 'build', 'build')),

    ...dependentGenerators.map(
      (pkg) =>
        ({
          title: `${pkg.name}: gen (declares ${code
            .map(({ pkg: { name } }) => name)
            .filter((name) => pkg.workspaceDependencies.has(name))
            .join(', ')})`,
          kind: 'generate',
          cwd: pkg.dir,
          args: ['run', 'gen'],
        }) as const,
    ),

    ...(areas.has('manifest') || areas.has('deps-graph')
      ? [rootStep('generate', 'gen:deps-graph')]
      : []),

    // Every published package's LICENSE is written from the license its
    // manifest declares, which `style-check.yml` regenerates and then asserts a
    // clean tree on.
    ...(areas.has('manifest') || areas.has('license')
      ? [rootStep('generate', 'gen:license-files')]
      : []),

    // Its committed `local/` copies are written from `smoke/`, the manifests,
    // the generator and the libraries it calls, which no list here would keep
    // up with; it only writes files, so it runs for any change that is not
    // prose alone. CI's dirty-tree check finds them stale otherwise, naming no
    // generator.
    ...(areas.has('root-guards')
      ? [rootStep('generate', 'gen:verify-npm-packages')]
      : []),

    // The codemod before the lint, so that what it rewrites is linted too, and
    // as CI runs it: `fix:codemod:affected` runs it over the diff from
    // `CODEMOD_DIFF_BASE` (which `main.mts` sets to the base), the untracked
    // files included, or over everything when what decides its output changed
    // (the lockfile, a script naming its transformers), which need not be
    // TypeScript.
    ...(areas.has('root-guards')
      ? [
          rootStep('fix', 'fix:codemod:affected'),
          // The codemod parenthesizes what it reprints and leaves the formatter
          // to take the parentheses off, and a lint rule can judge them
          // meanwhile: oxlint's `no-invalid-void-type` rejects
          // `() => (Promise<void> | void)`, on a line nobody changed (#2998).
          // CI lints only the formatted tree. `fix:codemod:affected` formats
          // once it is done, but not when the codemod fails; the root checks'
          // `eslint --fix` lints too, so this runs whether or not a package has
          // a `fix:lint`.
          formatStep('format what the codemod reprinted', base),
        ]
      : []),

    // A package's `fix:lint` loads from `dist/` what its config imports, and
    // what that runs with, so a change there can fail a package the diff does
    // not touch, as CI's `ws:fix:lint` finds after `ws:build`. As there, the
    // changed ones are built first (after the codemod, which can rewrite them),
    // and then the packages whose configs import them linted with the other
    // changed ones, one step each as every package step here, so that each
    // failure is reported and names its package (`ws:fix:lint` is
    // `pnpm --recursive`, which stops at the first). A fix the lint makes to a
    // package built here is left in the tree, which `main.mts` names, as CI
    // would. A failed build is reported as a failure of its own, ahead of what
    // the lint then reads.
    ...linted.builds.flatMap((pkg) => packageStep(pkg, 'build', 'build')),

    ...linted.packages.flatMap((pkg) => packageStep(pkg, 'fix', 'fix:lint')),

    ...code.flatMap(({ pkg }) => [
      ...packageStep(pkg, 'check', 'check:types'),
      // `check:test` with coverage turned on rather than `check:test:cov`,
      // which in some packages runs the browser project as well. A
      // `check:test:cov` is what says the package's Vitest has coverage set up,
      // and that its `check:test` ends in `vitest`.
      ...packageStep(
        pkg,
        'check',
        'check:test',
        coverage && pkg.scripts.has('check:test:cov')
          ? { coverage: { packageDir: pkg.dir } }
          : {},
      ),
      ...packageStep(pkg, 'check', 'check:sumi'),
    ]),

    // `check:forgotten-exports` reads the built declarations, so each changed
    // package it reads is built here, with the changed packages it is built
    // against, in build order. That is after the fixers, which can rewrite a
    // declaration (a build for the generators above ran before them). Then the
    // check reads the read packages alone. CI runs it over every package after
    // `ws:build`, so a public type left unexported was otherwise first found on
    // the queue layer. It runs for any code change of the package, a test's
    // included, and the build type-checks `src/` again after `check:types`:
    // that is what reading `dist/` costs, and telling a declaration's change
    // from the rest would be a second build system. A failed build is reported
    // as a failure of its own, ahead of whatever the check then reads. A
    // package built for the lint above is built again here when a read package
    // reaches it, as `fix:lint` ran in between and can rewrite it.
    ...(Arr.isNonEmpty(forgottenExportsRead)
      ? Arr.toPushed(
          builtForForgottenExports.flatMap((pkg) =>
            packageStep(pkg, 'build', 'build'),
          ),
          {
            title: `check:forgotten-exports (${forgottenExportsRead
              .map(({ name }) => name)
              .join(', ')})`,
            kind: 'check',
            cwd: '.',
            // The script asserts every member's links built
            // (`assert-deps-built.mts --workspace`): that is the
            // `ws:build:deps` the README says check-changed needs before it
            // starts, and what every package's own checks here assume.
            args: [
              'run',
              'check:forgotten-exports',
              ...forgottenExportsRead.map(({ dir }) => dir),
            ],
            narrows: 'check:forgotten-exports',
          } as const,
        )
      : []),

    // Every file in a package counts, a document included: CI runs it in
    // `style-check.yml`, whose gate drops nothing but `experimental/`.
    ...packages.flatMap(({ pkg }) => packageStep(pkg, 'check', 'check:ext')),

    // The root program loads the same (its `eslint.config.mts`) and type-checks
    // every member's config, so such a change asks for the root's own checks:
    // its lint, and its type check, which reads what the configs import. Its
    // tests come with them, as the area runs the three together. For any such
    // change: the root manifest is not among the members a plan reads, and what
    // the root does not load costs these checks alone.
    ...rootSteps({
      areas: linted.lintInputChanged
        ? new Set<Area>([...areas, 'root'])
        : areas,
      rootScripts,
      coverage,
    }),

    // strict-lib's config loads the same toolchain, and CI lints it on every
    // run. For any such change, as for the root's checks above. Its config's
    // imports are not read, as it is not a member: a package it alone imports
    // would not count as one a config imports.
    ...(linted.lintInputChanged && !areas.has('strict-lib')
      ? [rootStep('check', 'strict-lib:check:lint')]
      : []),

    ...(areas.has('strict-lib')
      ? [
          rootStep('check', 'strict-lib:check:types'),
          rootStep('check', 'strict-lib:check:lint'),
          rootStep('fix', 'strict-lib:fix:fmt'),
        ]
      : []),

    // As CI runs it, for any change its code gate lets through: knip reads
    // modules of every kind, tsconfig `types` and the workflows, so removing a
    // dependency's last use leaves it unused with no manifest in the diff
    // (#3042), and no list of file kinds here would keep up with its plugins.
    ...(areas.has('manifest') || areas.has('root-guards')
      ? [rootStep('check', 'check:knip')]
      : []),

    // Only for what it lints: an import added to `src/` can name what the
    // package does not publish, with no manifest in the diff.
    ...(areas.has('manifest') || areas.has('published-source')
      ? [rootStep('check', 'check:published-deps')]
      : []),

    ...(areas.has('prose') ? [rootStep('check', 'check:md')] : []),

    // Buildless and quick, and some of its guards read code too
    // (`check:prose:dependent-releases` reads `src/` for re-exports).
    rootStep('check', 'check:prose'),

    // `check:cspell` reads the whole repository; the changed files are what can
    // have changed its verdict. Given paths, cspell still finds each file's
    // nearest `cspell.config.yaml`.
    ...(areas.has('spell-config')
      ? [rootStep('check', 'check:cspell')]
      : spellChecked.some(isSpellCheckedByCi)
        ? [
            {
              title: 'cspell over the changed files',
              kind: 'check',
              cwd: '.',
              narrows: 'check:cspell',
              args: [
                'exec',
                'cspell',
                '--no-progress',
                '--no-must-find-files',
                '--gitignore',
                ...spellChecked
                  .filter(isSpellCheckedByCi)
                  .map((file) => `./${file}`),
              ],
            } as const,
          ]
        : []),

    ...(areas.has('changeset') && !areas.has('spell-config')
      ? [rootStep('check', 'check:cspell:changeset')]
      : []),

    areas.has('format-config')
      ? rootStep('fix', 'fix:fmt:full')
      : formatStep('format the diff (after)', base),
  ];
};

/**
 * What every step runs with.
 *
 * - `CI=true`, as GitHub Actions sets it, since some tools read it:
 *   typescript-estree then parses a linted file from disk rather than the text
 *   it was given, and Vitest refuses `.only`. A test can pass without it and
 *   fail in CI.
 * - The base, so that what reads a diff reads this one: the codemod
 *   (`fix:codemod:affected`) and the `check:prose` guards (`resolveDiffBase`)
 *   otherwise fall back to the merge base with origin/main, which on a stacked
 *   branch takes in the layer below.
 */
export const stepEnvironment = (base: string): ReadonlyRecord<string, string> =>
  ({
    CI: 'true',
    CODEMOD_DIFF_BASE: base,
    PROSE_DIFF_BASE: base,
  }) as const;

/**
 * Whether `check:cspell` reads a path: its glob takes in everything but
 * dot-directories and dotfiles, `.github/` excepted. A changeset is
 * `check:cspell:changeset`'s, under the config of the package it names, and
 * would be judged under the wrong one here.
 */
export const isSpellCheckedByCi = (file: string): boolean =>
  file.startsWith('.github/') ||
  file.split('/').every((segment) => !segment.startsWith('.'));

/**
 * Whether a member is part of the ESLint toolchain a package's `fix:lint`
 * loads: a shareable config (`eslint-config-*`), a plugin (`eslint-plugin-*`)
 * or what rules are written with (`eslint-rule-*`), scoped or not, by the names
 * npm gives them, which a new one takes too. What one is built against is
 * loaded with it; a package a config imports under another name
 * (`@sumi-lang/cli`, `ts-data-forge`) is loaded alone.
 */
export const isLintToolchain = (name: string): boolean => {
  const unscoped = name.startsWith('@')
    ? name.slice(name.indexOf('/') + 1)
    : name;

  return LINT_TOOLCHAIN_KINDS.some(
    (kind) =>
      unscoped === `eslint-${kind}` || unscoped.startsWith(`eslint-${kind}-`),
  );
};

export type PackageInfo = Readonly<{
  name: string;
  /** Repository-relative, `/`-separated, no trailing slash. */
  dir: string;
  scripts: ReadonlySet<string>;
  /** `"private": true` in its manifest. */
  isPrivate: boolean;
  /**
   * The workspace members its manifest names in `dependencies`,
   * `devDependencies` or `peerDependencies`.
   */
  workspaceDependencies: ReadonlySet<string>;
  /**
   * The workspace members in `dependencies` and `peerDependencies` alone, the
   * fields `ws:build` orders its stages by.
   */
  buildDependencies: ReadonlySet<string>;
  /** Whether an import of it resolves to its build output (`dist/`). */
  exportsBuild: boolean;
  /**
   * Whether `check:forgotten-exports` reads it (`readsForgottenExports` in
   * `tools/scripts/lib/forgotten-exports-scope.mts`). Read from the manifest
   * when the members are, as `exportsBuild` is, so that the plan stays a
   * function of facts and never parses a manifest itself.
   */
  forgottenExportsRead: boolean;
  /**
   * The packages its `eslint.config*.mts` imports by name (`readLintImports` in
   * `packages.mts`), which its `fix:lint` loads. Read when the members are, so
   * that the plan never reads a file itself.
   */
  lintImports: ReadonlySet<string>;
}>;

/**
 * What {@link PackageInfo} reads from a manifest's dependency fields and entry
 * points. A range counts when it is `workspace:`, the only way a member names
 * another.
 */
export const readManifestDependencies = (
  manifest: unknown,
): StrictPick<
  PackageInfo,
  'workspaceDependencies' | 'buildDependencies' | 'exportsBuild'
> => {
  const membersIn = (fields: readonly string[]): ReadonlySet<string> =>
    new Set(
      isRecord(manifest)
        ? fields.flatMap((field) => {
            const ranges = manifest[field];

            return isRecord(ranges)
              ? Object.entries(ranges)
                  .filter(
                    ([, range]) =>
                      isString(range) && range.startsWith('workspace:'),
                  )
                  .map(([name]) => name)
              : [];
          })
        : [],
    );

  return {
    workspaceDependencies: membersIn([
      'dependencies',
      'devDependencies',
      'peerDependencies',
    ]),
    buildDependencies: membersIn(['dependencies', 'peerDependencies']),
    exportsBuild: entryPointTargets(manifest).some((target) =>
      BUILD_OUTPUT.test(target),
    ),
  };
};

/**
 * The root generators a change to what they read runs: each with its entry
 * file, and the files and directories (ending in `/`) its output depends on —
 * the generator, what it writes (so a hand edit is put back), and the library
 * code it calls (#3336). `generator-inputs.test.mts` holds `inputs` to the
 * import graph of `entry`.
 */
export const ROOT_GENERATORS = {
  'gen:deps-graph': {
    entry: 'tools/scripts/cmd/gen-dependency-graph.mts',
    inputs: [
      'tools/scripts/cmd/gen-dependency-graph.mts',
      'docs/package-dependencies.md',
      'tools/scripts/project-root-path.mts',
      'libs/ts-repo-utils/src/functions/workspace-utils/',
      'libs/ts-repo-utils/src/functions/assert-path-exists.mts',
      'libs/ts-repo-utils/src/functions/diff.mts',
      'libs/ts-repo-utils/src/functions/exec-async.mts',
      'libs/ts-repo-utils/src/functions/format.mts',
      'libs/ts-repo-utils/src/functions/glob.mts',
      'libs/ts-repo-utils/src/functions/is-directly-executed.mts',
    ],
  },
  'gen:license-files': {
    entry: 'tools/scripts/cmd/gen-license-files.mts',
    inputs: [
      'tools/scripts/cmd/gen-license-files.mts',
      'tools/scripts/lib/child-process.mts',
      'tools/scripts/project-root-path.mts',
      'libs/ts-repo-utils/src/functions/is-directly-executed.mts',
    ],
  },
} as const satisfies ReadonlyRecord<
  string,
  Readonly<{ entry: string; inputs: readonly string[] }>
>;

/** Whether `file` is one of `inputs`, or under one ending in `/`. */
export const readsGeneratorInput = (
  file: string,
  inputs: readonly string[],
): boolean =>
  inputs.some((input) =>
    input.endsWith('/') ? file.startsWith(input) : file === input,
  );

/**
 * What a change touches beyond its package. `root` asks for every
 * `check:root:*` (tools/ and the root configuration); `root-guards` for the
 * guards alone, without the root program's own type check, lint and tests.
 * `root-guards` is any change that is not prose alone, and
 * `gen:verify-npm-packages` runs on it for that reason: narrowing it to what
 * the guards read would leave that generator's copies stale. `license` is a
 * `LICENSE` or what `gen:license-files` reads ({@link ROOT_GENERATORS});
 * `gen:license-files` runs on it and on `manifest`, whose `license` and
 * `private` fields decide what it writes. `deps-graph` is what `gen:deps-graph`
 * reads, the document it writes included, which it otherwise regenerates only
 * for a `manifest`. `published-source` is what `check:published-deps` lints
 * (`PUBLISHED_DEPS_INPUT`), which runs on it and on `manifest`.
 * `strict-lib-output` is what the strict-lib generators read or write
 * (`STRICT_LIB_GENERATOR_INPUT`), on which they run; the rest of `strict-lib/`
 * runs only its tooling's checks.
 */
export const AREAS = [
  'root',
  'root-guards',
  'prose',
  'manifest',
  'published-source',
  'license',
  'deps-graph',
  'strict-lib',
  'strict-lib-output',
  'changeset',
  'repo-settings',
  'shared-config',
  'spell-config',
  'format-config',
] as const;

export type Area = (typeof AREAS)[number];

export type Classification = Readonly<{
  packages: readonly Readonly<{
    pkg: PackageInfo;
    code: boolean;
    /**
     * Whether what its build emits can have changed: a file its build reads or
     * its manifest. A manifest edit that emits nothing new, a version bump,
     * counts too: telling the fields apart would be a second reading of what a
     * build depends on.
     */
    emitted: boolean;
  }>[];
  /**
   * The members that declare a package whose code changed, touched by the diff
   * or not.
   */
  dependents: readonly PackageInfo[];
  /**
   * Every workspace member, which `classifyChanges` is given: the build order
   * passes through members the diff does not change. Carried here, with what
   * the diff touches, so that a plan is a function of one classification.
   */
  members: readonly PackageInfo[];
  areas: ReadonlySet<Area>;
  ignored: readonly string[];
}>;

export type StepKind = 'format' | 'generate' | 'build' | 'fix' | 'check';

export type Step = Readonly<{
  title: string;
  kind: StepKind;
  /** Repository-relative directory to run `pnpm` in. */
  cwd: string;
  /** Arguments to `pnpm`. */
  args: readonly string[];
  /**
   * Present on a test step whose coverage is read afterwards; `main.mts`
   * appends the reporter options, which `pnpm run` hands to the script's last
   * command, `vitest`.
   */
  coverage?: Readonly<{ packageDir: string }>;
  /**
   * The root script CI runs over everything that this step runs over the diff
   * alone, for `check-changed-gap.mts` to tell the two apart.
   */
  narrows?: string;
}>;

const LINT_TOOLCHAIN_KINDS = ['config', 'plugin', 'rule'] as const;

const rootStep = (kind: StepKind, script: string): Step =>
  ({
    title: script,
    kind,
    cwd: '.',
    args: ['run', script],
  }) as const;

/**
 * The `check:root:*` scripts the areas need: all of them for `root`, all but
 * the root program's own for `root-guards`. They run in parallel, as
 * `check:root` runs them, but through `run-p --continue-on-error`: `pnpm run
 * '/regex/'` kills the rest when one fails, which leaves the others' verdicts
 * unknown. `check:root:test` runs on its own so that its coverage can be read.
 */
const rootSteps = ({
  areas,
  rootScripts,
  coverage,
}: Readonly<{
  areas: ReadonlySet<Area>;
  rootScripts: readonly string[];
  coverage: boolean;
}>): readonly Step[] => {
  if (!areas.has('root') && !areas.has('root-guards')) {
    return [];
  }

  const scripts = rootScripts
    .filter(
      (script) =>
        ROOT_CHECK.test(script) &&
        (areas.has('root') || !ROOT_PROGRAM_CHECKS.has(script)),
    )
    .toSorted();

  const parallel = scripts.filter((script) => script !== 'check:root:test');

  return [
    ...(Arr.isNonEmpty(parallel)
      ? [
          {
            title: `check:root (${parallel.length} scripts in parallel)`,
            kind: 'check',
            cwd: '.',
            args: [
              'exec',
              'run-p',
              '--continue-on-error',
              '--print-label',
              ...parallel,
            ],
          } as const,
        ]
      : []),
    ...(scripts.includes('check:root:test')
      ? [
          {
            ...rootStep('check', 'check:root:test'),
            ...(coverage ? { coverage: { packageDir: '.' } } : {}),
          },
        ]
      : []),
  ];
};

const formatStep = (title: string, base: string): Step =>
  ({
    title,
    kind: 'format',
    cwd: '.',
    args: ['run', 'z:format-diff-from', base],
    narrows: 'fix:fmt:full',
  }) as const;

const packageStep = (
  pkg: PackageInfo,
  kind: StepKind,
  script: string,
  extra: Readonly<{ coverage?: Step['coverage'] }> = {},
): readonly Step[] =>
  pkg.scripts.has(script)
    ? ([
        {
          title: `${pkg.name}: ${script}`,
          kind,
          cwd: pkg.dir,
          args: ['run', script],
          ...extra,
        },
      ] as const)
    : ([] as const);

/**
 * What has to be built, in an order `ws:build` could build it in, for `targets`
 * to be read against the diff: each package of `changed` that exports its build
 * and that is one of `targets` or that they reach through `buildDependencies`
 * in `members`, through a member the diff does not change too. Each comes after
 * what it reaches. A target that exports its sources is not built, but what it
 * reaches is.
 */
const changedBuildsFor = (
  targets: readonly PackageInfo[],
  changed: readonly PackageInfo[],
  members: readonly PackageInfo[],
): readonly PackageInfo[] => {
  const byName = new Map(members.map((member) => [member.name, member]));

  const wanted = new Set<string>(
    changed.filter(({ exportsBuild }) => exportsBuild).map(({ name }) => name),
  );

  const mut_ordered: PackageInfo[] = [];

  const mut_visited = new Set<string>();

  const visit = (pkg: PackageInfo): void => {
    if (mut_visited.has(pkg.name)) {
      return;
    }

    mut_visited.add(pkg.name);

    for (const name of pkg.buildDependencies) {
      const dependency = byName.get(name);

      if (dependency !== undefined) {
        visit(dependency);
      }
    }

    if (wanted.has(pkg.name)) {
      mut_ordered.push(pkg);
    }
  };

  for (const pkg of targets) {
    visit(pkg);
  }

  return mut_ordered;
};

const basename = (file: string): string =>
  file.slice(file.lastIndexOf('/') + 1);

const ROOT_CHECK = /^check:root:[^:]+$/u;

/**
 * The root program's own checks: what the root `tsconfig.json` includes
 * (tools/, and every package's `configs/` and `eslint.config.mts`), type
 * checked, linted and tested. The slow part of `check:root`, and pointless for
 * a change none of those files see.
 */
const ROOT_PROGRAM_CHECKS: ReadonlySet<string> = new Set<string>([
  'check:root:types',
  'check:root:lint',
  'check:root:test',
]);

/**
 * Whether the root program reads a path: tools/, the root configuration, and
 * what the root `tsconfig.json` includes from anywhere (`configs/`,
 * `eslint.config*.mts`, `vite.config.mts`, `.markdownlint-cli2.mjs`). Taking in
 * too much costs a slower run; too little, a type error CI finds first.
 */
const isRootProgramFile = (file: string): boolean => {
  const name = basename(file);

  return (
    file.startsWith('tools/') ||
    file === '.markdownlint-cli2.mjs' ||
    (!file.includes('/') &&
      (name.endsWith('.json') || name.endsWith('.mts'))) ||
    name === 'vite.config.mts' ||
    (name.startsWith('eslint.config') && name.endsWith('.mts')) ||
    (CONFIGS_SEGMENT.test(file) && TYPESCRIPT_FILE.test(file))
  );
};

/** The cspell configs, root and per package (`check:cspell` reads both). */
const SPELL_CONFIG = /(?:^|\/)\.?cspell\.config\.yaml$/u;

/** Prettier's own config: a change reformats files the diff never touched. */
const FORMAT_CONFIG: ReadonlySet<string> = new Set<string>([
  '.prettierrc',
  '.prettierignore',
]);

const CONFIGS_SEGMENT = /(?:^|\/)configs\//u;

const TYPESCRIPT_FILE = /\.(?:ts|mts|tsx)$/u;

/**
 * What `check:published-deps` lints: TypeScript under the `src/` of a `libs/`
 * or `apps/` member, and every tracked `eslint.config.mts`. The script names
 * the configs by directory, and `eslint.published-deps.test.mts` fails on a
 * tracked one those globs miss, so this matches the name at any depth rather
 * than repeating them (`experimental/` is ignored before this is read).
 */
const PUBLISHED_DEPS_INPUT =
  /^(?:libs|apps)\/[^/]+\/src\/.+\.(?:mts|ts|tsx)$|(?:^|\/)eslint\.config\.mts$/u;

/**
 * What under `strict-lib/` the strict-lib generators read or write, by
 * directory: the converter (`strict-lib/scripts-common/`), the root commands
 * that drive it (`strict-lib/scripts/`), oxfmt's configuration, which formats
 * what they write, and each harness (`strict-lib/v<X.Y>/`) whole — its
 * `scripts/`, the upstream copy under `temp/copied/`, the `output/` written
 * from it, and the `CHANGELOG.md` and `package.json` copied into its bundle. A
 * directory is taken whole, a file in it the generators do not read included
 * (the publish commands, a harness's `tsconfig`): narrower, a file they start
 * reading would leave the output stale with nothing to say so. What is left is
 * the tooling's own (its ESLint and TypeScript configuration, `configs/`,
 * `docs/`, the README).
 *
 * What the generators read outside `strict-lib/` — the libraries they import,
 * `tools/configs/tsconfig.tsx.json`, the oxfmt and TypeScript versions the
 * lockfile pins — is left to `strict-lib-gen.yml`: nearly every diff reaches
 * one of them, and two and a half minutes on each would be paid for the rare
 * one that moves the output.
 */
const STRICT_LIB_GENERATOR_INPUT =
  /^strict-lib\/(?:scripts-common\/|scripts\/|v\d+\.\d+\/|\.oxfmtrc\.json$|\.oxfmtignore$)/u;

const MANIFEST_FILES: ReadonlySet<string> = new Set<string>([
  'package.json',
  'pnpm-lock.yaml',
  'pnpm-workspace.yaml',
]);

const BUILD_OUTPUT = /^(?:\.\/)?dist\//u;

/**
 * The members a member runs with: what its build is ordered by, or, for a
 * toolchain package that exports its sources (`@sumi-lang/eslint-config`),
 * whatever it declares, `devDependencies` included. Not so for any other such
 * member: an app declares the toolchain to lint itself, not to be loaded by a
 * lint.
 */
const runsWith = (pkg: PackageInfo): ReadonlySet<string> =>
  pkg.exportsBuild || !isLintToolchain(pkg.name)
    ? pkg.buildDependencies
    : pkg.workspaceDependencies;

/**
 * The names of `seeds` and of every member of `through` that runs with one of
 * them ({@link runsWith}), through other such members too.
 */
const loadersOf = (
  seeds: readonly PackageInfo[],
  through: readonly PackageInfo[],
): ReadonlySet<string> => {
  const mut_loaded = new Set<string>(seeds.map(({ name }) => name));

  const reach = (): void => {
    const next = through.filter(
      (pkg) =>
        !mut_loaded.has(pkg.name) &&
        Array.from(runsWith(pkg)).some((name) => mut_loaded.has(name)),
    );

    if (!Arr.isNonEmpty(next)) {
      return;
    }

    for (const pkg of next) {
      mut_loaded.add(pkg.name);
    }

    reach();
  };

  reach();

  return mut_loaded;
};

/**
 * What `fix:lint` runs in, and what is built for it. A lint loads from `dist/`
 * the packages a member's config imports (`lintImports`) and what those run
 * with. With no change to that, the packages whose code changed. With one, the
 * `packages` linted are every changed one and every member whose config imports
 * a package that loads a changed one, and the `builds` are the changed packages
 * those imported packages are built against, in build order.
 *
 * What loads a changed package is found walking backwards over what each member
 * runs with ({@link runsWith}) in two passes. From the changed toolchain
 * packages ({@link isLintToolchain}), through any member. From every changed
 * package, through members outside the toolchain alone, so that a change to
 * `@sumi-lang/checker` reaches `@sumi-lang/cli`, which configs import, but a
 * change to `ts-data-forge` does not take in `eslint-config-typed`, which is
 * built against it: that would lint every package for a rule's verdict its
 * helpers seldom change.
 */
const lintedPackages = (
  code: Classification['packages'],
  members: readonly PackageInfo[],
): Readonly<{
  /** Whether a package a config imports changed what a lint loads of it. */
  lintInputChanged: boolean;
  builds: readonly PackageInfo[];
  packages: readonly PackageInfo[];
}> => {
  const changed = code.map(({ pkg }) => pkg);

  const emitted = code
    .filter(({ emitted: isEmitted }) => isEmitted)
    .map(({ pkg }) => pkg);

  const loadedFromToolchain = loadersOf(
    emitted.filter(({ name }) => isLintToolchain(name)),
    members,
  );

  const loaded = new Set<string>([
    ...loadedFromToolchain,
    ...loadersOf(
      emitted,
      members.filter(({ name }) => !isLintToolchain(name)),
    ),
  ]);

  const imported = members.filter(
    ({ name }) =>
      loaded.has(name) &&
      members.some(({ lintImports }) => lintImports.has(name)),
  );

  if (Arr.isEmpty(imported)) {
    return { lintInputChanged: false, builds: [], packages: changed };
  }

  const changedNames = new Set<string>(changed.map(({ name }) => name));

  const importedNames = new Set<string>(imported.map(({ name }) => name));

  const running = members.map((pkg) => ({
    ...pkg,
    buildDependencies: runsWith(pkg),
  }));

  return {
    lintInputChanged: true,
    // What the imported packages run with, a source-exporting one's
    // `devDependencies` included, as their builds are ordered by it.
    builds: changedBuildsFor(
      running.filter(
        ({ name }) => importedNames.has(name) || loadedFromToolchain.has(name),
      ),
      changed,
      running,
    ),
    packages: members
      .filter(
        (pkg) =>
          changedNames.has(pkg.name) ||
          Array.from(pkg.lintImports).some((name) => importedNames.has(name)),
      )
      .toSorted((a, b) => a.dir.localeCompare(b.dir)),
  };
};

/**
 * Whether `file` is one a package's build reads (`configs/tsconfig.build.json`
 * and `scripts/cmd/build.mts`, over `src/` less the `*.test.mts` that
 * configuration excludes), or its manifest: by the convention, not each
 * configuration, so what one includes outside `src/` (`ts-type-forge`'s
 * `minimal-lib.d.mts`) is not counted.
 */
const isBuildInput = (dir: string, file: string): boolean =>
  [
    `${dir}/package.json`,
    `${dir}/configs/tsconfig.build.json`,
    `${dir}/scripts/cmd/build.mts`,
  ].includes(file) ||
  (file.startsWith(`${dir}/src/`) && !file.endsWith('.test.mts'));
