{
  // Resolution map used by `tsx` while running a package's **build**.
  //
  // The library sources import their siblings by package name, and those names
  // resolve to `dist/`, which does not exist yet during a build from a clean
  // checkout. Pointing them at the sources instead lets `tsx` transpile
  // everything on the fly, so `pnpm run ws:build` needs nothing built
  // beforehand and no published copy of our own packages.
  //
  // Passed explicitly: `tsx --tsconfig ../../tools/configs/tsconfig.tsx.json`.
  // Only affects that process; type-checking uses each package's own tsconfig.
  "compilerOptions": {
    "baseUrl": "../..",
    "paths": {
      "ts-type-forge": ["libs/ts-type-forge/src/index.mts"],
      "ts-data-forge": ["libs/ts-data-forge/src/entry-point.mts"],
      "ts-repo-utils": ["libs/ts-repo-utils/src/entry-point.mts"],
      "ts-codemod-lib": ["libs/ts-codemod-lib/src/entry-point.mts"]
    }
  }
}
