{
  // https://www.typescriptlang.org/ja/tsconfig
  "compilerOptions": {
    // Type Checking
    "allowUnreachableCode": false,
    "allowUnusedLabels": false,
    "exactOptionalPropertyTypes": false,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noPropertyAccessFromIndexSignature": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "strict": true,
    // "alwaysStrict": true,                 // enabled by "strict"
    // "strictBindCallApply": true,          // enabled by "strict"
    // "strictFunctionTypes": true,          // enabled by "strict"
    // "strictNullChecks": true,             // enabled by "strict"
    // "strictPropertyInitialization": true, // enabled by "strict"
    // "noImplicitAny": true,                // enabled by "strict"
    // "noImplicitThis": true,               // enabled by "strict"
    // "useUnknownInCatchVariables": true,   // enabled by "strict"

    "noEmit": true,

    // Modules
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "resolveJsonModule": true,

    // Language and Environment
    "target": "ESNext",
    "jsx": "react-jsx",

    // JavaScript Support
    "allowJs": true,
    "checkJs": true,

    // Interop Constraints
    // Note: "allowSyntheticDefaultImports": false was removed because
    // disabling it is deprecated in TypeScript 6.0 (TS5107) and will stop
    // functioning in 7.0 ("esModuleInterop": true implies it anyway).
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": false,

    "erasableSyntaxOnly": false,
    "verbatimModuleSyntax": false,

    // Don't include @types/* by default
    "types": [],

    "lib": ["ESNext", "DOM"],

    // The strict standard library, for packages that define no `paths` of
    // their own. `paths` in an extended config resolves relative to the config
    // that contains it — this file — and a package that sets `paths` replaces
    // this whole object, so it has to repeat the entry.
    "paths": {
      "@typescript/lib-*": ["../../../node_modules/strict-ts-lib-v7.0/libs/*"]
    },

    // Completeness
    "skipLibCheck": true
  }
}
