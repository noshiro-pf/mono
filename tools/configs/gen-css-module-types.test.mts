import dedent from 'dedent';
import * as fs from 'node:fs/promises';
import * as os from 'node:os';
import * as path from 'node:path';
import { Result } from 'ts-data-forge';
import type { ReadonlyRecord } from 'ts-type-forge';
import {
  cssModuleDeclaration,
  cssModuleExports,
  declarationPathOf,
  genCssModuleTypes,
  resolveCssModulesConfig,
} from './gen-css-module-types.mjs';

describe('cssModuleExports', () => {
  test('reports the local classes and keyframes, not what :global() holds', async () => {
    assert.deepStrictEqual(
      await namesOf(dedent`
        .root > .item:not(.selected) :global(.bp-button) {
          animation: spin 1s;
        }

        @keyframes spin {
          to {
            transform: rotate(360deg);
          }
        }

        @keyframes :global(fade) {
        }
      `),
      ['item', 'root', 'selected', 'spin'],
    );
  });

  test('is not misled by comment openers or parentheses inside urls', async () => {
    assert.deepStrictEqual(
      await namesOf(dedent`
        .a {
          background: url(https://x.test/*.png);
        }

        .b {
          background: url("icon(1).png");
        }

        /* .commented */
        .c {
        }
      `),
      ['a', 'b', 'c'],
    );
  });
});

describe('cssModuleDeclaration', () => {
  test('declares each name as a named string export, sorted', () => {
    const declaration = cssModuleDeclaration(
      'button-group.module.css',
      classes('selected', 'group'),
    );

    assert.isTrue(Result.isOk(declaration));

    assert.strictEqual(
      declaration.value,
      `${dedent`
        // Generated by \`gen:css-module-types\` from button-group.module.css; edits here are overwritten.

        export declare const group: string;

        export declare const selected: string;
      `}\n`,
    );
  });

  test('refuses a name that is not a camelCase identifier, naming the file', () => {
    const declaration = cssModuleDeclaration(
      'components/app.module.css',
      classes('button-group'),
    );

    assert.isTrue(Result.isErr(declaration));

    assert.include(declaration.value, 'components/app.module.css:');

    assert.include(declaration.value, "'button-group'");
  });

  test('refuses a reserved word, which `export declare const` cannot declare', () => {
    const declaration = cssModuleDeclaration(
      'app.module.css',
      classes('default'),
    );

    assert.isTrue(Result.isErr(declaration));

    assert.include(declaration.value, "'default'");
  });

  test('refuses an export that is not its own scoped class', () => {
    const declaration = cssModuleDeclaration('app.module.css', {
      root: '_root_x',
      primary: 'red',
    });

    assert.isTrue(Result.isErr(declaration));

    assert.include(declaration.value, "as used by 'primary'");
  });

  test('refuses a stylesheet that exports nothing, which needs no module', () => {
    assert.isTrue(Result.isErr(cssModuleDeclaration('app.module.css', {})));
  });

  test('refuses `composes`, which makes a value several class names', async () => {
    const source = dedent`
      .base {
      }

      .selected {
        composes: base;
      }
    `;

    const declaration = cssModuleDeclaration(
      'components/app.module.css',
      await exportsOf(source),
    );

    assert.isTrue(Result.isErr(declaration));

    assert.include(declaration.value, 'components/app.module.css:');

    assert.include(
      declaration.value,
      "composes, @value and :export are not supported, as used by 'selected'",
    );
  });

  test('refuses `@value` and `:export`, which export values, not classes', async () => {
    for (const source of [
      dedent`
        @value primary: #007bff;
        .root {
        }
      `,
      dedent`
        :export {
          primary: #007bff;
        }
        .root {
        }
      `,
    ]) {
      const declaration = cssModuleDeclaration(
        'app.module.css',
        await exportsOf(source),
      );

      assert.isTrue(Result.isErr(declaration));

      assert.include(declaration.value, "as used by 'primary'");
    }
  });
});

describe('declarationPathOf', () => {
  test('is where TypeScript looks under allowArbitraryExtensions', () => {
    assert.strictEqual(
      declarationPathOf('/a/src/button-group.module.css'),
      '/a/src/button-group.module.d.css.ts',
    );
  });
});

/* eslint-disable security/detect-non-literal-fs-filename -- every path is under a temporary directory the test creates */

describe('genCssModuleTypes', () => {
  test('writes a declaration beside each stylesheet and deletes a stale generated one', async () => {
    const srcDir = await fs.mkdtemp(path.join(os.tmpdir(), 'css-modules-'));

    try {
      await fs.mkdir(path.join(srcDir, 'nested'));

      await fs.writeFile(path.join(srcDir, 'app.module.css'), '.root { }');

      await fs.writeFile(
        path.join(srcDir, 'nested/item.module.css'),
        '.item { }',
      );

      await fs.writeFile(
        path.join(srcDir, 'gone.module.d.css.ts'),
        '// Generated by `gen:css-module-types` from gone.module.css; edits here are overwritten.\n',
      );

      await fs.writeFile(
        path.join(srcDir, 'kept.module.d.css.ts'),
        'export declare const kept: string;\n',
      );

      const result = await genCssModuleTypes({
        srcDir,
        viteConfigFile: await writeViteConfig(srcDir),
      });

      assert.isTrue(Result.isOk(result));

      assert.include(
        await fs.readFile(path.join(srcDir, 'app.module.d.css.ts'), 'utf8'),
        'export declare const root: string;',
      );

      assert.include(
        await fs.readFile(
          path.join(srcDir, 'nested/item.module.d.css.ts'),
          'utf8',
        ),
        'export declare const item: string;',
      );

      await expect(
        fs.access(path.join(srcDir, 'gone.module.d.css.ts')),
      ).rejects.toThrow();

      await fs.access(path.join(srcDir, 'kept.module.d.css.ts'));
    } finally {
      await fs.rm(srcDir, { recursive: true, force: true });
    }
  });

  test('deletes a stale generated declaration without reading the config when no stylesheet is left', async () => {
    const srcDir = await fs.mkdtemp(path.join(os.tmpdir(), 'css-modules-'));

    try {
      await fs.writeFile(
        path.join(srcDir, 'gone.module.d.css.ts'),
        '// Generated by `gen:css-module-types` from gone.module.css; edits here are overwritten.\n',
      );

      const result = await genCssModuleTypes({
        srcDir,
        viteConfigFile: path.join(srcDir, 'missing.config.mjs'),
      });

      assert.isTrue(Result.isOk(result));

      await expect(
        fs.access(path.join(srcDir, 'gone.module.d.css.ts')),
      ).rejects.toThrow();
    } finally {
      await fs.rm(srcDir, { recursive: true, force: true });
    }
  });

  test('moves the declaration of a stylesheet renamed only in case', async () => {
    const srcDir = await fs.mkdtemp(path.join(os.tmpdir(), 'css-modules-'));

    try {
      const viteConfigFile = await writeViteConfig(srcDir);

      await fs.writeFile(path.join(srcDir, 'Item.module.css'), '.item { }');

      assert.isTrue(
        Result.isOk(await genCssModuleTypes({ srcDir, viteConfigFile })),
      );

      await fs.rename(
        path.join(srcDir, 'Item.module.css'),
        path.join(srcDir, 'item.module.css'),
      );

      assert.isTrue(
        Result.isOk(await genCssModuleTypes({ srcDir, viteConfigFile })),
      );

      const files = await fs.readdir(srcDir);

      assert.deepStrictEqual(
        files.filter((file) => file.endsWith('.d.css.ts')),
        ['item.module.d.css.ts'],
      );
    } finally {
      await fs.rm(srcDir, { recursive: true, force: true });
    }
  });

  test('writes nothing when a stylesheet cannot be declared, and names it', async () => {
    const srcDir = await fs.mkdtemp(path.join(os.tmpdir(), 'css-modules-'));

    try {
      await fs.writeFile(path.join(srcDir, 'a.module.css'), '.root { }');

      await fs.writeFile(
        path.join(srcDir, 'bad.module.css'),
        '.button-group { }',
      );

      await fs.writeFile(
        path.join(srcDir, 'gone.module.d.css.ts'),
        '// Generated by `gen:css-module-types` from gone.module.css; edits here are overwritten.\n',
      );

      const result = await genCssModuleTypes({
        srcDir,
        viteConfigFile: await writeViteConfig(srcDir),
      });

      assert.isTrue(Result.isErr(result));

      assert.include(result.value, 'bad.module.css');

      await expect(
        fs.access(path.join(srcDir, 'a.module.d.css.ts')),
      ).rejects.toThrow();

      await fs.access(path.join(srcDir, 'gone.module.d.css.ts'));
    } finally {
      await fs.rm(srcDir, { recursive: true, force: true });
    }
  });

  test('refuses to overwrite a declaration written by hand', async () => {
    const srcDir = await fs.mkdtemp(path.join(os.tmpdir(), 'css-modules-'));

    try {
      await fs.writeFile(path.join(srcDir, 'a.module.css'), '.root { }');

      await fs.writeFile(
        path.join(srcDir, 'a.module.d.css.ts'),
        'export declare const root: string;\n',
      );

      const result = await genCssModuleTypes({
        srcDir,
        viteConfigFile: await writeViteConfig(srcDir),
      });

      assert.isTrue(Result.isErr(result));

      assert.include(result.value, 'a.module.d.css.ts');

      assert.strictEqual(
        await fs.readFile(path.join(srcDir, 'a.module.d.css.ts'), 'utf8'),
        'export declare const root: string;\n',
      );
    } finally {
      await fs.rm(srcDir, { recursive: true, force: true });
    }
  });

  test('refuses an app config that changes the CSS Modules options', async () => {
    for (const css of [
      "modules: { localsConvention: 'camelCaseOnly' }",
      "transformer: 'lightningcss'",
      'postcss: { plugins: [] }',
    ]) {
      const srcDir = await fs.mkdtemp(path.join(os.tmpdir(), 'css-modules-'));

      try {
        await fs.writeFile(path.join(srcDir, 'a.module.css'), '.root { }');

        const result = await genCssModuleTypes({
          srcDir,
          viteConfigFile: await writeViteConfig(srcDir, css),
        });

        assert.isTrue(Result.isErr(result));

        assert.include(
          result.value,
          'css.modules, css.transformer or css.postcss',
        );

        await expect(
          fs.access(path.join(srcDir, 'a.module.d.css.ts')),
        ).rejects.toThrow();
      } finally {
        await fs.rm(srcDir, { recursive: true, force: true });
      }
    }
  });
});

/**
 * An app config rooted at `dir` with the given `css` options, beside an empty
 * PostCSS config so that none above the directory is read.
 */
const writeViteConfig = async (
  dir: string,
  css: string = '',
): Promise<string> => {
  const file = path.join(dir, 'vite.config.mjs');

  await fs.writeFile(
    path.join(dir, 'postcss.config.mjs'),
    'export default {};\n',
  );

  await fs.writeFile(
    file,
    `export default { root: ${JSON.stringify(dir)}, css: { ${css} } };\n`,
  );

  return file;
};

const exportsOf = async (
  source: string,
): Promise<ReadonlyRecord<string, string>> => {
  const dir = await fs.mkdtemp(path.join(os.tmpdir(), 'css-modules-'));

  try {
    return await cssModuleExports(
      source,
      path.join(dir, 'probe.module.css'),
      await resolveCssModulesConfig(await writeViteConfig(dir)),
    );
  } finally {
    await fs.rm(dir, { recursive: true, force: true });
  }
};

/* eslint-enable security/detect-non-literal-fs-filename */

const namesOf = async (source: string): Promise<readonly string[]> =>
  Object.keys(await exportsOf(source)).toSorted();

const classes = (...names: readonly string[]): ReadonlyRecord<string, string> =>
  Object.fromEntries(names.map((name) => [name, `_${name}_x`]));
