import * as fs from 'node:fs/promises';
import * as path from 'node:path';
import { Arr, unknownToString } from 'ts-data-forge';
import { $, Result } from 'ts-repo-utils';
import type { ReadonlyRecord } from 'ts-type-forge';

/**
 * What the generator reads from a rule. Structural, so that a plugin's rules
 * object (`TSESLint.RuleModule`s) is accepted as it is.
 */
type RuleMeta = Readonly<{
  type: string;
  docs?: Readonly<{ description?: string }>;
  deprecated?: unknown;
  fixable?: string;
  schema?: unknown;
}>;

export type GenEslintPluginRuleTypesOptions = Readonly<{
  /**
   * The plugin's rule prefix (e.g. `'ts-fortress'`). The rules object the
   * generated file imports from `./rules/index.mjs` is named after it
   * (`tsFortressRules`), and so are the exported types
   * (`EslintTsFortressRules`, `EslintTsFortressRulesOption`).
   */
  pluginPrefix: string;
  /**
   * The runtime dependency the generated drift check imports `expectType`
   * from. The build's strip pass removes the call and the import it empties.
   */
  expectTypeFrom: 'ts-data-forge' | 'ts-std-forge';
  /** The plugin's rules, keyed by rule name without the prefix. */
  rules: ReadonlyRecord<string, Readonly<{ meta: RuleMeta }>>;
}>;

/**
 * Writes `src/rule-types.mts` of an ESLint plugin in this repository — one
 * namespace per rule with its metadata as JSDoc, plus the plugin-wide
 * `…Rules` / `…RulesOption` types — and formats it.
 *
 * A plugin's `scripts/cmd/gen-rule-types.mts` is the call site and nothing
 * else; this is the code that was copied into each of them.
 */
export const genEslintPluginRuleTypes = async ({
  packageRoot,
  ...options
}: GenEslintPluginRuleTypesOptions &
  Readonly<{ packageRoot: string }>): Promise<Result<undefined, string>> => {
  const content = generateRuleTypesFileContent(options);

  if (Result.isErr(content)) {
    return content;
  }

  const ruleTypesPath = path.resolve(packageRoot, './src/rule-types.mts');

  try {
    // eslint-disable-next-line security/detect-non-literal-fs-filename
    await fs.writeFile(ruleTypesPath, content.value);
  } catch (error) {
    return Result.err(
      `Failed to write ${ruleTypesPath}: ${unknownToString(error)}`,
    );
  }

  // Normalize import order and line wrapping with the repo's Prettier config.
  const fmtResult = await $(`pnpm run z:prettier "${ruleTypesPath}"`, {
    cwd: packageRoot,
  });

  if (Result.isErr(fmtResult)) {
    return Result.err(
      `Failed to format the generated file: ${fmtResult.value.message}`,
    );
  }

  console.info(
    `Generated ${path.relative(packageRoot, ruleTypesPath)} (${Object.keys(options.rules).length} rules)`,
  );

  return Result.ok(undefined);
};

/** The content of `src/rule-types.mts`, before formatting. */
export const generateRuleTypesFileContent = ({
  pluginPrefix,
  expectTypeFrom,
  rules: rulesObject,
}: GenEslintPluginRuleTypesOptions): Result<string, string> => {
  const missingDescription = Object.entries(rulesObject).find(
    ([, { meta }]) => meta.docs?.description === undefined,
  );

  if (missingDescription !== undefined) {
    return Result.err(
      `Rule "${missingDescription[0]}" has no \`meta.docs.description\`.`,
    );
  }

  const rules = Object.entries(rulesObject).map(([name, { meta }]) =>
    toRuleInfo(name, meta),
  );

  const pascalPrefix = toPascalCase(pluginPrefix);

  const rulesTypeName = `Eslint${pascalPrefix}Rules` as const;

  const rulesOptionTypeName = `Eslint${pascalPrefix}RulesOption` as const;

  const rulesObjectName =
    `${pascalPrefix.slice(0, 1).toLowerCase()}${pascalPrefix.slice(1)}Rules` as const;

  const optionRules = rules.filter((rule) => rule.hasOptions);

  const hasAnyOptions = Arr.isNonEmpty(optionRules);

  return Result.ok(
    [
      '/* cSpell:disable */',
      '',
      '// This file is auto-generated by `pnpm run gen:rule-types`',
      '// (`scripts/cmd/gen-rule-types.mts`). Do not edit it manually.',
      '',
      ...(hasAnyOptions
        ? ["import type { TSESLint } from '@typescript-eslint/utils';"]
        : []),
      "import type { Linter } from 'eslint';",
      `import { expectType } from '${expectTypeFrom}';`,
      // `ReadonlyRecord` is only referenced by the no-option `…RulesOption`
      // form emitted below, so it must not be imported when some rule takes
      // options.
      ...(hasAnyOptions
        ? []
        : ["import type { ReadonlyRecord } from 'ts-type-forge';"]),
      `import type { ${rulesObjectName} } from './rules/index.mjs';`,
      '',
      ...(hasAnyOptions
        ? [
            'type SpreadOptionsIfIsArray<',
            '  T extends readonly [Linter.StringSeverity, unknown],',
            '> = T[1] extends readonly unknown[]',
            '  ? readonly [Linter.StringSeverity, ...T[1]]',
            '  : T;',
            '',
            '/**',
            ' * Extracts the options tuple type of a rule from its TypeScript',
            ' * implementation, so that option types stay in sync with the rule source',
            ' * without converting `meta.schema` (JSON Schema) back into TypeScript types.',
            ' */',
            `type RuleOptionsOf<Name extends keyof typeof ${rulesObjectName}> =`,
            `  (typeof ${rulesObjectName})[Name] extends TSESLint.RuleModule<`,
            '    infer _MessageIds extends string,',
            '    infer Options extends readonly unknown[]',
            '  >',
            '    ? Options',
            '    : never;',
            '',
          ]
        : []),
      ...rules.flatMap((rule) => Arr.toPushed(generateRuleNamespace(rule), '')),
      `export type ${rulesTypeName} = Readonly<{`,
      ...rules.map(
        (rule) =>
          `  '${pluginPrefix}/${rule.name}': ${rule.namespaceName}.RuleEntry;`,
      ),
      '}>;',
      '',
      // `Readonly<{}>` would be an "empty object" type (any non-nullish
      // value), so the no-option case gets an explicitly empty record instead.
      ...(hasAnyOptions
        ? [
            `export type ${rulesOptionTypeName} = Readonly<{`,
            ...optionRules.map(
              (rule) =>
                `  '${pluginPrefix}/${rule.name}': ${rule.namespaceName}.Options;`,
            ),
            '}>;',
          ]
        : [
            `export type ${rulesOptionTypeName} = ReadonlyRecord<never, never>;`,
          ]),
      '',
      '// If this assertion fails to type-check, this generated file has drifted from',
      '// the actual plugin rules — re-run `pnpm run gen:rule-types`.',
      'expectType<',
      `  keyof ${rulesTypeName},`,
      `  \`${pluginPrefix}/\${keyof typeof ${rulesObjectName}}\``,
      ">('=');",
      '',
    ].join('\n'),
  );
};

type RuleInfo = Readonly<{
  /** Rule name without the plugin prefix (e.g. `'prefer-canonical-type'`). */
  name: string;
  /** PascalCase namespace name (e.g. `'PreferCanonicalType'`). */
  namespaceName: string;
  description: string;
  type: string;
  deprecated: boolean;
  fixable: string;
  /** `meta.schema`, embedded as JSON in the `Options` JSDoc. */
  schema: unknown;
  hasOptions: boolean;
}>;

const toRuleInfo = (name: string, meta: RuleMeta): RuleInfo => {
  const { schema } = meta;

  return {
    name,
    namespaceName: toPascalCase(name),
    description: meta.docs?.description ?? '',
    type: meta.type,
    deprecated: meta.deprecated !== undefined && meta.deprecated !== false,
    fixable: meta.fixable ?? 'false',
    schema,
    hasOptions: Arr.isArray(schema)
      ? Arr.isNonEmpty(schema)
      : schema !== undefined && schema !== false,
  };
};

const generateRuleNamespace = (rule: RuleInfo): readonly string[] =>
  [
    '/**',
    ` * @description ${rule.description}`,
    ' *',
    ...generateMetaTable(rule),
    ' */',
    `namespace ${rule.namespaceName} {`,
    ...(rule.hasOptions
      ? ([
          ...generateSchemaJsdoc(rule.schema),
          `  export type Options = NonNullable<RuleOptionsOf<'${rule.name}'>[0]>;`,
          '',
          '  export type RuleEntry =',
          "    | 'off'",
          '    | Linter.Severity',
          '    | SpreadOptionsIfIsArray<readonly [Linter.StringSeverity, Options]>;',
        ] as const)
      : (['  export type RuleEntry = Linter.StringSeverity;'] as const)),
    '}',
  ] as const;

const generateMetaTable = (rule: RuleInfo): readonly string[] => {
  const rows = [
    ['type', rule.type],
    ['deprecated', rule.deprecated.toString()],
    ['fixable', rule.fixable],
  ] as const;

  const keyWidth = Math.max('key'.length, ...rows.map(([key]) => key.length));

  const valueWidth = Math.max(
    'value'.length,
    ...rows.map(([, value]) => value.length),
  );

  return [
    ' *  ```md',
    ` *  | ${'key'.padEnd(keyWidth)} | ${'value'.padEnd(valueWidth)} |`,
    ` *  | :${'-'.repeat(keyWidth - 1)} | :${'-'.repeat(valueWidth - 1)} |`,
    ...rows.map(
      ([key, value]) =>
        ` *  | ${key.padEnd(keyWidth)} | ${value.padEnd(valueWidth)} |`,
    ),
    ' *  ```',
  ];
};

const generateSchemaJsdoc = (schema: unknown): readonly string[] =>
  [
    '  /**',
    '   * ### schema',
    '   *',
    '   * ```json',
    ...JSON.stringify(schema, undefined, 2)
      .split('\n')
      .map((line) => `   * ${line}`.trimEnd()),
    '   * ```',
    '   */',
  ] as const;

const toPascalCase = (kebabCase: string): string =>
  kebabCase
    .split('-')
    .map((word) => `${word.slice(0, 1).toUpperCase()}${word.slice(1)}`)
    .join('');
