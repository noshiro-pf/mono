# GitHub Personal Access Token (optional)
# Create a token at https://github.com/settings/tokens
# Only needed if you hit API rate limits
VITE_GITHUB_TOKEN=ghp_ABCDEFGHIJKLMNOPQRSTUVWXYZ1234567890abcdef

# Additional repositories to display (optional)
# Format: owner/repo1,owner/repo2,owner/repo3
# These repositories will be added after the default ones
# Example for company/private repositories:
# VITE_ADDITIONAL_REPOS=mycompany/private-repo1,mycompany/private-repo2,anotherorg/project
VITE_ADDITIONAL_REPOS=microsoft/vscode,vercel/next.js
