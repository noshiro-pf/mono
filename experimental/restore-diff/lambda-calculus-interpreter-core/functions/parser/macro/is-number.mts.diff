index a414f8336..f49a3879e 100644
--- experimental/packages/apps/lambda-calculus-interpreter-core/src/functions/parser/macro/is-number.mts
+++ apps/lambda-calculus-interpreter-core/src/functions/parser/macro/is-number.mts
@@ -11,18 +11,27 @@ export const isNumber = (
 ): term is NumberTerm<Variable, Variable> => {
   // 2 = ['lambda', 's', ['lambda', 'z', ['s', ['s', 'z'] ] ] ]
   if (!isAbstraction(term)) return false;
+
   if (!isAbstraction(term[2])) return false;
+
   const s = term[1];
+
   const z = term[2][1];
+
   if (s === z) return false;
+
   const body = term[2][2];
+
   const sub = (t: LambdaTerm): boolean => {
     if (isVariable(t)) return t === z;
+
     if (isApplication(t)) {
       return t[0] === s && sub(t[1]);
     }
+
     return false;
   };
+
   // ToDo
   return sub(body);
 };
