{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": ["mcp__claude-code-remote__add_repo"]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$CLAUDE_PROJECT_DIR/tools/scripts/cmd/claude-code-claude-md-sync.mts\"; [ ! -f \"$f\" ] || node \"$f\"",
            "timeout": 20
          }
        ]
      },
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "[ \"$CLAUDE_CODE_REMOTE\" = true ] || exit 0; f=/etc/profile.d/claude-cloud-node.sh; [ ! -f \"$f\" ] || { . \"$f\"; [ -z \"${CLAUDE_ENV_FILE:-}\" ] || grep -qxF \". $f\" \"$CLAUDE_ENV_FILE\" 2>/dev/null || echo \". $f\" >> \"$CLAUDE_ENV_FILE\"; }; log=/tmp/claude-cloud-pnpm-install.log; cd \"$CLAUDE_PROJECT_DIR\" && pnpm install --frozen-lockfile --prefer-offline > \"$log\" 2>&1 || echo \"pnpm install failed; see $log\"",
            "timeout": 600
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$CLAUDE_PROJECT_DIR/tools/scripts/cmd/claude-code-claude-md-sync.mts\"; [ ! -f \"$f\" ] || node \"$f\"",
            "timeout": 20
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$CLAUDE_PROJECT_DIR/tools/scripts/cmd/claude-code-post-edit.mts\"; [ ! -f \"$f\" ] || node \"$f\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
