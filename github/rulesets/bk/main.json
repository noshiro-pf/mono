{
  "id": 4847294,
  "name": "main",
  "target": "branch",
  "enforcement": "active",
  "bypass_actors": [
    {
      "actor_id": 5,
      "actor_type": "RepositoryRole",
      "bypass_mode": "always"
    }
  ],
  "conditions": {
    "ref_name": {
      "exclude": [],
      "include": ["refs/heads/main", "~DEFAULT_BRANCH"]
    }
  },
  "rules": [
    {
      "type": "deletion"
    },
    {
      "type": "non_fast_forward"
    },
    {
      "type": "required_linear_history"
    },
    {
      "type": "pull_request",
      "parameters": {
        "required_approving_review_count": 0,
        "dismiss_stale_reviews_on_push": true,
        "required_reviewers": [],
        "require_code_owner_review": false,
        "require_last_push_approval": false,
        "required_review_thread_resolution": true,
        "allowed_merge_methods": ["squash", "rebase"]
      }
    },
    {
      "type": "creation"
    },
    {
      "type": "required_status_checks",
      "parameters": {
        "strict_required_status_checks_policy": true,
        "do_not_enforce_on_create": true,
        "required_status_checks": [
          {
            "context": "lint-test-type-check (run ws:gi)",
            "integration_id": 15368
          },
          {
            "context": "lint-test-type-check (run ws:lint:fix)",
            "integration_id": 15368
          },
          {
            "context": "lint-test-type-check (run ws:test)",
            "integration_id": 15368
          },
          {
            "context": "lint-test-type-check (run ws:type-check)",
            "integration_id": 15368
          }
        ]
      }
    }
  ]
}
