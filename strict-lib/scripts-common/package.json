{
  "name": "strict-ts-lib-scripts-common",
  "version": "0.0.1",
  "private": true,
  "description": "Shared scripts for generating strict-ts-lib-vX.Y-* packages",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    "./commands/gen": "./src/commands/gen.mts",
    "./commands/gen-full": "./src/commands/gen-full.mts",
    "./commands/gen-lib-files": "./src/commands/gen-lib-files.mts",
    "./commands/gen-packages": "./src/commands/gen-packages.mts",
    "./commands/gen-with-codemod-fixed": "./src/commands/gen-with-codemod-fixed.mts",
    "./context": "./src/context.mts"
  },
  "scripts": {
    "check:test": "node ../../tools/scripts/cmd/assert-deps-built.mts && pnpm run z:vitest:node run",
    "check:test:cov": "node ../../tools/scripts/cmd/assert-deps-built.mts && pnpm run z:vitest:node run --coverage",
    "test": "pnpm run check:test",
    "watch:test": "pnpm run z:vitest:node watch",
    "z:vitest": "vitest --config ./configs/vitest.config.mts",
    "z:vitest:node": "pnpm run z:vitest --project='Node.js'"
  },
  "devDependencies": {
    "@vitest/coverage-istanbul": "catalog:",
    "dedent": "catalog:",
    "ts-data-forge": "workspace:*",
    "ts-fortress": "workspace:*",
    "ts-repo-utils": "workspace:*",
    "ts-type-forge": "workspace:*",
    "typescript": "6.0.3",
    "vitest": "catalog:"
  }
}
