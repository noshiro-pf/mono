{
  "$schema": "../libs/pr-merge-queue/src/unblock-prs/config.schema.json",
  "translation": { "heading": "日本語" },
  "autoFix": {
    "ignore": ["^[\\w-]+-result / result$"],
    "before": ["pnpm install --frozen-lockfile"],
    "prepare": [
      {
        "context": "^code-check \\(|^style-check \\(z:ci:style-check:checks-and-generators\\)$",
        "run": "pnpm run ws:build"
      }
    ],
    "fixers": [
      {
        "context": "^(?:code-check|style-check) \\(((?:(?:ws|strict-lib):)?(?:fix:)?gen(?::[^)]*)?)\\)$",
        "run": "pnpm run $1",
        "stage": 0
      },
      {
        "context": "^(?:code-check|style-check) \\(((?:(?:ws|strict-lib):)?fix:fmt(?::[^)]*)?)\\)$",
        "run": "pnpm run $1",
        "stage": 2
      },
      {
        "context": "^(?:code-check|style-check) \\(((?:(?:ws|strict-lib):)?fix(?::[^)]*)?)\\)$",
        "run": "pnpm run $1",
        "stage": 1
      },
      {
        "context": "^style-check \\((z:ci:style-check:checks-and-generators)\\)$",
        "run": "pnpm run $1",
        "stage": -1
      },
      {
        "context": "^style-check \\(z:ci:style-check:format-and-doc\\)$",
        "run": "pnpm run fix:fmt:full",
        "stage": 2
      }
    ],
    "after": ["pnpm run fix:fmt:diff"],
    "notFixableAnnotation": "command failed"
  },
  "regenerate": {
    "before": ["pnpm install --frozen-lockfile"],
    "generators": [
      {
        "path": "^docs/package-dependencies\\.md$",
        "run": "pnpm run gen:deps-graph"
      },
      {
        "path": "^((?:apps|libs)/[^/]+)/src/.*(?<=/)index\\.mts$",
        "run": "pnpm --dir $1 run gen:index"
      }
    ]
  },
  "speculate": {
    "workflows": [
      "code-check.yml",
      "style-check.yml",
      "strict-lib-gen.yml",
      "node-version-compatibility.yml",
      "verify-published-packages.yml",
      "synstate-benchmark.yml"
    ],
    "depth": 2
  },
  "generatedBranches": [
    {
      "branch": "chore/pnpm-update",
      "rebuild": "pnpm run rebuild-pnpm-update -- <number> --by <claimant>"
    }
  ]
}
