// cspell:ignore foldl
{
  "$schema": "https://unpkg.com/knip@6/schema.json",

  // ESLint (`import-x/no-extraneous-dependencies`, with `packageDirs` set to
  // the package itself) fails on an import a package does not declare. knip
  // covers the other direction — a declared dependency nothing imports — plus
  // the imports ESLint cannot see, such as the ones in `samples/`.
  //
  // Run with `pnpm run knip`.

  // The CI gate is `dependencies,unlisted,binaries,unresolved,catalog,
  // catalogReferences` — the issue types that are about what a package
  // declares. Everything about whether code is reachable stays out of it;
  // `pnpm exec knip` with no arguments reports those.
  //
  // - `files` and `exports`: an export nothing imports yet is what unfinished
  //   work looks like, and failing CI for it makes the check something to work
  //   around. knip also cannot see every use: `run-benchmark-deep-chain.mts`
  //   reaches the throughput adapters through `await import(<computed path>)`
  //   assigned to `any`, so `createRxJSThroughputAdapter` reads as unused
  //   while being the RxJS row of that benchmark.
  // - `duplicates`: 21 hits, every one an alias this repository publishes on
  //   purpose (`combine`/`combineLatest`, `foldl`/`reduce`, …).
  // - `types`: the hits are types a `types.mts` exports as the vocabulary of
  //   its directory — `AdapterCallbacks` is the parameter type of
  //   `Adapter.setup`, so anyone writing an adapter wants to name it. Removing
  //   the `export` to satisfy the report would make the code worse.

  "ignore": [
    // Legacy monorepo contents, outside the pnpm workspace. Nothing here is
    // installed, built or linted.
    "experimental/**",
    // Fixtures the codemod reads through `fs.glob('test-code/**')` at run
    // time, so nothing imports them by name.
    "libs/ts-codemod-lib/test-code/**",
  ],

  "ignoreDependencies": [
    // The strict standard library. Nothing imports it: both the type check
    // (`typescript-native`, 7.x) and the lint (the `typescript` module, 6.x,
    // which is what typescript-eslint imports) find it by resolving
    // `@typescript/lib-*` as package names, and the root `prepare` script runs
    // this package's linker to supply those names.
    "strict-ts-lib-v7.0",
    // The same, from the other side. Each `strict-lib/vX.Y` harness declares
    // `file:output/lib/libs/<group>` under the name TypeScript asks for, so
    // that its own `lib-check` resolves the generated library **by name** —
    // the only way TypeScript 6 and earlier find a replacement, their lib
    // resolution being a fixed Node10 lookup that ignores `paths`. tsc reads
    // these; no source file imports them.
    "@typescript/lib-decorators",
    "@typescript/lib-dom",
    "@typescript/lib-es2015",
    "@typescript/lib-es2016",
    "@typescript/lib-es2017",
    "@typescript/lib-es2018",
    "@typescript/lib-es2019",
    "@typescript/lib-es2020",
    "@typescript/lib-es2021",
    "@typescript/lib-es2022",
    "@typescript/lib-es2023",
    "@typescript/lib-es2024",
    "@typescript/lib-es2025",
    "@typescript/lib-es5",
    "@typescript/lib-es6",
    "@typescript/lib-esnext",
    "@typescript/lib-scripthost",
    "@typescript/lib-webworker",
    // Used through `pnpm exec zenn preview` only; see the Zenn section of
    // CLAUDE.md.
    "zenn-cli",
    // Named as strings in the root `.prettierrc`. Every package runs `fmt`
    // with its own directory as cwd, so each has to resolve them itself; knip
    // only sees the root config.
    "prettier-plugin-organize-imports",
    "prettier-plugin-packagejson",
  ],

  // Invoked by `libs/synstate/scripts/cmd/generate-sample-diffs.mts`. A system
  // binary, not something to install.
  "ignoreBinaries": ["diff"],

  "workspaces": {
    // The conformance corpus of the tsubu language project. `fixtures/`
    // holds deliberate rule violations that the runner reads as text — not
    // project files.
    "languages/tsubu/conformance": {
      "entry": ["test/**/*.test.mts"],
      "project": ["src/**/*.mts", "test/**/*.mts"],
    },

    // The Tsubu v1 ESLint preset. Consumed by other packages'
    // eslint.config.mts through the package entry point.
    "languages/tsubu/eslint-config": {
      "entry": ["src/entry-point.mts", "test/**/*.test.mts"],
      "project": ["src/**/*.mts", "test/**/*.mts"],
    },

    // The strict standard library's generator. Its entry points are the
    // per-version `scripts/`, which the root `strict-lib:gen*` commands drive;
    // `output*/` holds generated declarations that nothing imports by path.
    "strict-lib/scripts-common": {
      "entry": ["src/**/*.mts"],
      "project": ["src/**/*.mts"],
    },

    "strict-lib/v*": {
      "entry": ["scripts/**/*.mts"],
      "project": ["scripts/**/*.mts"],

      // Declared for tsc, not for a source file. `lib-check` type-checks the
      // generated declarations, which reference `import('ts-type-forge')`, and
      // `getTsTypeForgeRange` reads this very declaration to write the range
      // the published package carries.
      "ignoreDependencies": ["ts-type-forge"],
    },

    "strict-lib/v*/output/lib": {
      // The published package. Its `.d.ts` files reference
      // `import('ts-type-forge')`, so a consumer must have it installed — but
      // they are generated output, not part of any knip project.
      "ignoreDependencies": ["ts-type-forge"],
    },

    ".": {
      // `strict-lib/scripts/` and its ESLint config are not a package, so what
      // they import is declared by the root manifest and belongs to the root
      // project.
      "entry": [
        "tools/scripts/cmd/*.mts",
        "tools/configs/*.mts",
        "strict-lib/scripts/cmd/*.mts",
        "strict-lib/eslint.config.mts",
      ],
      "project": ["tools/**/*.mts", "strict-lib/{scripts,configs}/**/*.mts"],
    },

    "libs/*": {
      "entry": [
        "src/entry-point.mts",
        "src/index.mts",
        "src/cmd/*.mts",
        "scripts/**/*.mts",
        "configs/*.{mts,mjs}",
        "test/**/*.{mts,tsx}",
        "samples/**/*.{mts,tsx}",
        "**/*.test.mts",
      ],
      "project": ["**/*.{mts,ts,tsx,mjs}"],

      // These live under `configs/`, not where each plugin looks by default.
      "rollup": { "config": ["configs/rollup.config.mts"] },
      "vitest": {
        "config": ["configs/vitest.config.mts", "configs/vite.doc.config.mts"],
      },
      "typedoc": { "config": ["configs/typedoc.config.mjs"] },
    },

    // Same as `libs/*` — knip replaces a workspace config rather than merging
    // it, so the shared settings are repeated — plus one exception.
    "libs/eslint-config-typed": {
      "entry": [
        "src/entry-point.mts",
        "src/index.mts",
        "src/cmd/*.mts",
        "scripts/**/*.mts",
        "configs/*.{mts,mjs}",
        "test/**/*.{mts,tsx}",
        "samples/**/*.{mts,tsx}",
        "**/*.test.mts",
      ],
      "project": ["**/*.{mts,ts,tsx,mjs}"],
      "rollup": { "config": ["configs/rollup.config.mts"] },
      "vitest": {
        "config": ["configs/vitest.config.mts", "configs/vite.doc.config.mts"],
      },
      "typedoc": { "config": ["configs/typedoc.config.mjs"] },
      "ignoreDependencies": [
        // Its own `eslint.config.mts` lints the package with the config the
        // package defines. knip does not follow that self-reference.
        "eslint-config-typed",
      ],
    },

    // Not an Astro site like the entry below assumes: a Vite React app whose
    // entry is the module `index.html` loads.
    "apps/event-schedule-app": {
      "entry": ["src/main.tsx"],
      "project": ["**/*.{mts,ts,tsx}"],
    },

    // Not an Astro site like the entry below assumes: plain TypeScript with a
    // single entry point.
    "apps/event-schedule-app-shared": {
      "entry": ["src/index.mts", "scripts/**/*.mts", "configs/*.mts"],
      "project": ["**/*.mts"],
    },

    // Not an Astro site like the entry below assumes: a single entry point.
    "apps/numeric-input-utils": {
      "entry": ["src/index.mts"],
      "project": ["**/*.mts"],
    },

    "apps/tiny-router-observable": {
      "entry": ["src/index.mts"],
      "project": ["**/*.mts"],
    },

    // Not an Astro site like the entry below assumes: a single entry point.
    "apps/resize-observer-react-hooks": {
      "entry": ["src/index.mts"],
      "project": ["**/*.mts"],
    },

    "apps/tiny-router-react-hooks": {
      "entry": ["src/index.mts"],
      "project": ["**/*.mts"],
    },

    // Not an Astro site like the entry below assumes: a single entry point.
    "apps/better-preact-use-state": {
      "entry": ["src/index.mts"],
      "project": ["**/*.mts"],
    },

    // Not an Astro site like the entry below assumes: a single entry point.
    "apps/react-blueprintjs-utils": {
      "entry": ["src/index.mts"],
      "project": ["**/*.{mts,ts,tsx}"],
    },

    // Not an Astro site like the entry below assumes: a single entry point.
    "apps/react-utils-styled": {
      "entry": ["src/index.mts"],
      "project": ["**/*.{mts,tsx}"],
    },

    // Not an Astro site like the entry below assumes: a single entry point.
    "apps/react-utils": {
      "entry": ["src/index.mts"],
      "project": ["**/*.{mts,tsx}"],
    },

    // Not an Astro site like the entry below assumes: plain TypeScript with a
    // single entry point.
    "apps/ts-fortress-types": {
      "entry": ["src/index.mts", "scripts/**/*.mts", "configs/*.mts"],
      "project": ["**/*.mts"],
    },

    "apps/*": {
      "entry": [
        "src/pages/**/*.{astro,mts,ts,tsx}",
        "scripts/**/*.mts",
        "configs/*.mts",
      ],
      "project": ["**/*.{mts,ts,tsx,mjs,astro,mdx}"],
    },

    // Not an Astro site like the entry above assumes: plain TypeScript with a
    // single entry point.
    "apps/lambda-calculus-interpreter-core": {
      "entry": ["src/index.mts", "scripts/**/*.mts", "configs/*.mts"],
      "project": ["**/*.mts"],
    },

    // Not an Astro site like the entry above assumes: a Vite React app whose
    // entry is the module `index.html` would load, as `event-schedule-app` is.
    "apps/lambda-calculus-interpreter-react": {
      "entry": ["src/main.tsx"],
      "project": ["**/*.{mts,tsx}"],
    },

    "apps/housing-loan-calculator-app": {
      "entry": ["src/main.tsx", "configs/*.mts"],
      "project": ["**/*.{mts,tsx}"],
    },

    "apps/cant-stop-probability-app": {
      "entry": ["src/main.tsx", "configs/*.mts"],
      "project": ["**/*.{mts,tsx}"],
    },

    "apps/blueprintjs-playground-styled": {
      "entry": ["src/main.tsx"],
      "project": ["**/*.{mts,tsx}"],
    },

    // Not an Astro site like the entry above assumes: a Node program with a
    // single entry point.
    "apps/poll-discord-app": {
      "entry": ["src/index.mts", "scripts/**/*.mts"],
      "project": ["**/*.mts"],
    },
  },
}
