# --------------------------------------------------------------------------
# mono-specific
#
# This is the only .gitignore under libs/ and apps/. Keep it that way: Prettier
# reads .gitignore and .prettierignore from the repository root and nowhere
# else, so a pattern in a package-level .gitignore would keep git quiet while
# `fmt:full` went on reformatting the generated files anyway.
# --------------------------------------------------------------------------

# TypeDoc output, generated by `pnpm run doc` in the packages that have
# configs/typedoc.config.mjs. libs/eslint-config-typed/docs and
# libs/synstate/docs hold hand-written prose and stay tracked.
/libs/ts-codemod-lib/docs/
/libs/ts-data-forge/docs/
/libs/ts-fortress/docs/
/libs/ts-repo-utils/docs/
/libs/ts-type-forge/docs/

# Build output of the legacy code parked under experimental/
experimental/**/build
experimental/**/lib
experimental/**/esm
experimental/**/cjs
experimental/**/config/**/*.js
experimental/**/scripts/**/*.js
!**/react-app-env.d.ts
!**/vite-env.d.ts
!**/globals.d.ts

# Firebase (experimental/packages/apps/*)
.firebase/
firebase-debug.log*
firebase-debug.*.log*

# wireit (legacy build runner, experimental/ only)
**/.wireit

# ReScript (experimental/)
.bsb.lock
.merlin
*.bs.js
*.bs.ts
*_bs.ts

rollup.config-*.mjs

*.local

