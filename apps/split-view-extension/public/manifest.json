{
  "manifest_version": 3,
  "name": "Split View",
  "description": "Splits one tab into a grid of web pages.",
  "version": "0.1.0",
  "key": "",
  "minimum_chrome_version": "116",
  "action": {
    "default_title": "Open Split View"
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["storage", "favicon", "declarativeNetRequestWithHostAccess"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "all_frames": true,
      "run_at": "document_start",
      "js": ["frame-agent.js"]
    }
  ]
}
