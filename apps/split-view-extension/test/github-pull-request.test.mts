import { pullRequestSplitViewSearch } from 'split-view-link';
import type { StrictOmit } from 'ts-type-forge';
import {
  asGitHubMessage,
  claudeSessionUrlOfBody,
  computeGeometry,
  githubMessageTag,
  issueUrlOf,
  parseLayoutSpec,
  pullRequestOf,
  pullRequestTitleOf,
  pullRequestWorkspace,
  removePaneAt,
  type LayoutNode,
} from '../src/index.mjs';

describe('pullRequestOf', () => {
  test('reads the conversation tab', () => {
    assert.deepStrictEqual(
      pullRequestOf('https://github.com/noshiro-pf/mono/pull/2085'),
      {
        number: 2085,
        url: 'https://github.com/noshiro-pf/mono/pull/2085',
      },
    );
  });

  test('reads every tab below it, and drops the query and the fragment', () => {
    for (const address of [
      'https://github.com/noshiro-pf/mono/pull/2085/files',
      'https://github.com/noshiro-pf/mono/pull/2085/files?w=1#diff-abc',
      'https://github.com/noshiro-pf/mono/pull/2085/changes',
      'https://github.com/noshiro-pf/mono/pull/2085/commits/0123abc',
      'https://github.com/noshiro-pf/mono/pull/2085/',
      'https://github.com/noshiro-pf/mono/pull/2085#issuecomment-1',
    ]) {
      assert.deepStrictEqual(pullRequestOf(address), {
        number: 2085,
        url: 'https://github.com/noshiro-pf/mono/pull/2085',
      });
    }
  });

  test('accepts the characters GitHub allows in an owner and a repository', () => {
    assert.deepStrictEqual(
      pullRequestOf('https://github.com/some-org/my.repo_name-2/pull/7'),
      {
        number: 7,
        url: 'https://github.com/some-org/my.repo_name-2/pull/7',
      },
    );
  });

  test('refuses what is not a pull request', () => {
    for (const address of [
      'https://github.com/noshiro-pf/mono',
      'https://github.com/noshiro-pf/mono/pulls',
      'https://github.com/noshiro-pf/mono/pull/new/main',
      'https://github.com/noshiro-pf/mono/pull/12abc',
      'https://github.com/noshiro-pf/mono/issues/2079',
      'https://gist.github.com/noshiro-pf/mono/pull/1',
      'http://github.com/noshiro-pf/mono/pull/1',
      'https://github.com.example.com/noshiro-pf/mono/pull/1',
      'not a url',
    ]) {
      assert.isUndefined(pullRequestOf(address));
    }
  });
});

describe('issueUrlOf', () => {
  test('reads an issue, in this repository or another', () => {
    assert.deepStrictEqual(
      issueUrlOf('https://github.com/noshiro-pf/mono/issues/2079'),
      'https://github.com/noshiro-pf/mono/issues/2079',
    );

    assert.deepStrictEqual(
      issueUrlOf('https://github.com/other/repo/issues/3#issuecomment-9'),
      'https://github.com/other/repo/issues/3',
    );
  });

  test('refuses what is not an issue on GitHub', () => {
    for (const address of [
      'https://github.com/noshiro-pf/mono/pull/2079',
      'https://github.com/noshiro-pf/mono/issues',
      'https://example.com/noshiro-pf/mono/issues/1',
      'mailto:someone@example.com',
      '',
    ]) {
      assert.isUndefined(issueUrlOf(address));
    }
  });
});

describe('claudeSessionUrlOfBody', () => {
  const session = 'https://claude.ai/code/session_015uv2FbmANuoW3w5XCgPMhW';

  test('reads a linked trailer', () => {
    assert.deepStrictEqual(
      claudeSessionUrlOfBody(
        [
          '## Summary',
          '',
          'Does the thing.',
          '',
          `Claude-Session: [Widen diff when middle pane closes](${session})`,
          '',
          `Generated by [Claude Code](${session})`,
        ].join('\n'),
      ),
      session,
    );
  });

  test('takes the first of several', () => {
    assert.deepStrictEqual(
      claudeSessionUrlOfBody(
        [
          `Claude-Session: [First](${session})`,
          'Claude-Session: [Second](https://claude.ai/code/session_second)',
        ].join('\n'),
      ),
      session,
    );
  });

  test('is undefined for a body without one', () => {
    assert.isUndefined(claudeSessionUrlOfBody(''));

    assert.isUndefined(claudeSessionUrlOfBody(`Generated by ${session}`));
  });
});

describe('pullRequestTitleOf', () => {
  test("takes the title out of GitHub's tab title", () => {
    assert.deepStrictEqual(
      pullRequestTitleOf(
        "feat(unblock-prs): stamp log lines with the machine's local time by noshiro-pf · Pull Request #2085 · noshiro-pf/mono · GitHub",
      ),
      "feat(unblock-prs): stamp log lines with the machine's local time",
    );
  });

  test('keeps a " by " that is part of the title', () => {
    assert.deepStrictEqual(
      pullRequestTitleOf(
        'Sort by date by someone · Pull Request #1 · owner/repo · GitHub',
      ),
      'Sort by date',
    );
  });

  test('reads it with the number another extension put in front', () => {
    assert.deepStrictEqual(
      pullRequestTitleOf(
        '#2085 Fix the thing by noshiro-pf · Pull Request #2085 · noshiro-pf/mono · GitHub',
      ),
      'Fix the thing',
    );
  });

  test('reads it without the trailing site name', () => {
    assert.deepStrictEqual(
      pullRequestTitleOf(
        'Fix the thing by noshiro-pf · Pull Request #2085 · noshiro-pf/mono',
      ),
      'Fix the thing',
    );
  });

  test('gives up on a title of another shape', () => {
    assert.isUndefined(pullRequestTitleOf('GitHub'));

    assert.isUndefined(
      pullRequestTitleOf('Issue title · Issue #1 · owner/repo · GitHub'),
    );
  });
});

describe('pullRequestSplitViewSearch, from GitHub', () => {
  const pullRequest = {
    number: 2085,
    url: 'https://github.com/noshiro-pf/mono/pull/2085',
  } as const;

  test('opens the saved split view of pull requests opened from GitHub', () => {
    // The layout, the panes and the zoom are `split-view-link`'s, and tested
    // there.
    const params = paramsFor({
      pullRequest,
      title: 'Fix the thing',
      issueUrl: undefined,
      sessionUrl: undefined,
    });

    assert.deepStrictEqual(
      {
        ws: params.get('ws'),
        name: params.get('name'),
        title: params.get('title'),
      },
      {
        ws: 'github-pull-request',
        name: 'GitHub pull request',
        title: '#2085 Fix the thing',
      },
    );
  });

  test('holds the diff and the conversation at their widths on a wide window', () => {
    const root = threeColumnRoot();

    for (const width of [1440, 1920, 2560, 3840]) {
      const [diffWidth, conversationWidth, issueWidth] = widthsOf(root, width);

      assert.deepStrictEqual(
        [diffWidth, conversationWidth, issueWidth],
        [737, 577, width - 737 - 577 - 2 * gutter],
      );
    }
  });

  test('gives the right column the width of the conversation when it is closed', () => {
    const root = threeColumnRoot();

    const withoutConversation = removePaneAt(root, 1);

    assert.isDefined(withoutConversation);

    const [diffWidth = 0, conversationWidth = 0, issueWidth = 0] = widthsOf(
      root,
      1920,
    );

    assert.deepStrictEqual(widthsOf(withoutConversation, 1920), [
      diffWidth,
      conversationWidth + gutter + issueWidth,
    ]);
  });
});

describe('asGitHubMessage', () => {
  test('accepts a request to open a pull request', () => {
    assert.deepStrictEqual(
      asGitHubMessage({
        tag: githubMessageTag,
        kind: 'open',
        url: 'https://github.com/noshiro-pf/mono/pull/2085',
        title: 'Fix the thing',
        issueUrl: 'https://github.com/noshiro-pf/mono/issues/2079',
        sessionUrl: 'https://claude.ai/code/session_015uv2Fb',
        active: false,
        closeOpener: false,
        extra: true,
      }),
      {
        tag: githubMessageTag,
        kind: 'open',
        url: 'https://github.com/noshiro-pf/mono/pull/2085',
        title: 'Fix the thing',
        issueUrl: 'https://github.com/noshiro-pf/mono/issues/2079',
        sessionUrl: 'https://claude.ai/code/session_015uv2Fb',
        active: false,
        closeOpener: false,
      },
    );
  });

  test('reads a missing title, issue or session as unknown', () => {
    assert.deepStrictEqual(
      asGitHubMessage({
        tag: githubMessageTag,
        kind: 'open',
        url: 'https://github.com/noshiro-pf/mono/pull/2085',
        active: true,
        closeOpener: true,
      }),
      {
        tag: githubMessageTag,
        kind: 'open',
        url: 'https://github.com/noshiro-pf/mono/pull/2085',
        title: undefined,
        issueUrl: undefined,
        sessionUrl: undefined,
        active: true,
        closeOpener: true,
      },
    );
  });

  test('accepts a request to look a pull request up first', () => {
    assert.deepStrictEqual(
      asGitHubMessage({
        tag: githubMessageTag,
        kind: 'look-up',
        url: 'https://github.com/noshiro-pf/mono/pull/2085',
      }),
      {
        tag: githubMessageTag,
        kind: 'look-up',
        url: 'https://github.com/noshiro-pf/mono/pull/2085',
      },
    );
  });

  test('refuses anything else', () => {
    for (const value of [
      undefined,
      'open',
      { tag: 'other', kind: 'open', url: 'x', active: true, closeOpener: true },
      {
        tag: githubMessageTag,
        kind: 'open',
        url: 1,
        active: true,
        closeOpener: true,
      },
      { tag: githubMessageTag, kind: 'open', url: 'x', closeOpener: true },
      { tag: githubMessageTag, kind: 'open', url: 'x', active: true },
      {
        tag: githubMessageTag,
        kind: 'open',
        url: 'x',
        active: true,
        closeOpener: 1,
      },
      {
        tag: githubMessageTag,
        kind: 'open',
        url: 'x',
        active: true,
        closeOpener: true,
        title: 1,
      },
      {
        tag: githubMessageTag,
        kind: 'open',
        url: 'x',
        active: true,
        closeOpener: true,
        sessionUrl: 1,
      },
      { tag: githubMessageTag, kind: 'close', url: 'x' },
    ]) {
      assert.isUndefined(asGitHubMessage(value));
    }
  });
});

const gutter = 6;

/** The query the extension's own button opens a pull request with. */
const paramsFor = (
  args: StrictOmit<
    Parameters<typeof pullRequestSplitViewSearch>[0],
    'workspace'
  >,
): URLSearchParams =>
  new URLSearchParams(
    pullRequestSplitViewSearch({ workspace: pullRequestWorkspace, ...args }),
  );

/** The tree of the split view a pull request that closes an issue opens. */
const threeColumnRoot = (): LayoutNode => {
  const params = paramsFor({
    pullRequest: {
      number: 2085,
      url: 'https://github.com/noshiro-pf/mono/pull/2085',
    },
    title: undefined,
    issueUrl: 'https://github.com/noshiro-pf/mono/issues/2084',
    sessionUrl: undefined,
  });

  const root = parseLayoutSpec(params.get('layout') ?? '');

  assert.isDefined(root);

  return root;
};

/** Each pane's width, in pane order, on a page `width` pixels wide. */
const widthsOf = (root: LayoutNode, width: number): readonly number[] =>
  computeGeometry(
    root,
    { left: 0, top: 0, width, height: 800 },
    gutter,
  ).panes.map(({ rect }) => rect.width);
