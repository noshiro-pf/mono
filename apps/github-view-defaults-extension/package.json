{
  "name": "github-view-defaults-extension",
  "version": "0.0.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/noshiro-pf/mono.git",
    "directory": "apps/github-view-defaults-extension"
  },
  "license": "Apache-2.0",
  "author": "noshiro-pf <noshiro.pf@gmail.com>",
  "type": "module",
  "scripts": {
    "build": "vite build --config ./configs/vite.config.mts",
    "check:lint": "eslint .",
    "check:test": "vitest --config ./configs/vitest.config.mts run",
    "check:types": "node ../../node_modules/typescript-native/bin/tsc --noEmit",
    "fix:fmt": "pnpm run z:format-uncommitted --cwd .",
    "fix:fmt:diff": "pnpm run z:format-diff-from origin/main --cwd .",
    "fix:fmt:full": "prettier --write .",
    "fix:lint": "eslint . --fix",
    "fmt": "pnpm run fix:fmt",
    "gen": "run-s gen:index gen:icons",
    "gen:icons": "tsx --tsconfig ../../tools/configs/tsconfig.tsx.json ./scripts/gen-icons.mts",
    "gen:index": "run-s gen:index:src fix:fmt",
    "gen:index:src": "pnpm run z:gen-index-ts ./src --index-ext .mts --export-ext .mjs --target-ext .mts --min-depth 1",
    "pack": "run-s build z:pack",
    "pack:crx": "run-s build z:pack-crx",
    "smoke": "tsx --tsconfig ../../tools/configs/tsconfig.tsx.json ./scripts/smoke.mts",
    "test": "pnpm run check:test",
    "watch:test": "vitest --config ./configs/vitest.config.mts watch",
    "z:format-diff-from": "tsx --tsconfig ../../tools/configs/tsconfig.tsx.json ../../libs/ts-repo-utils/src/cmd/format-diff-from.mts",
    "z:format-uncommitted": "tsx --tsconfig ../../tools/configs/tsconfig.tsx.json ../../libs/ts-repo-utils/src/cmd/format-uncommitted.mts",
    "z:gen-index-ts": "tsx --tsconfig ../../tools/configs/tsconfig.tsx.json ../../libs/ts-repo-utils/src/cmd/gen-index-ts.mts",
    "z:pack": "tsx --tsconfig ../../tools/configs/tsconfig.tsx.json ./scripts/pack.mts",
    "z:pack-crx": "tsx --tsconfig ../../tools/configs/tsconfig.tsx.json ./scripts/pack-crx.mts"
  },
  "dependencies": {
    "ts-data-forge": "workspace:*"
  },
  "devDependencies": {
    "@playwright/test": "catalog:",
    "eslint": "catalog:",
    "eslint-config-typed": "workspace:*",
    "eslint-plugin-ts-data-forge": "workspace:*",
    "npm-run-all2": "catalog:",
    "prettier": "catalog:",
    "prettier-plugin-organize-imports": "catalog:",
    "prettier-plugin-packagejson": "catalog:",
    "ts-type-forge": "workspace:*",
    "tsx": "catalog:",
    "vite": "catalog:"
  }
}
