{
  "manifest_version": 3,
  "name": "GitHub View Defaults",
  "description": "Opens GitHub PR diffs with whitespace hidden and viewed files collapsed, branches as the full list, and numbers PR and issue tabs.",
  "key": "",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["contextMenus"],
  "content_scripts": [
    {
      "matches": ["https://github.com/*"],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN",
      "js": ["content.js"]
    },
    {
      "matches": ["https://github.com/*"],
      "run_at": "document_idle",
      "all_frames": true,
      "js": ["pull-request-buttons.js"]
    }
  ]
}
