            "type": "object",
            "properties": {
              "id": {
                "type": "number"
              },
              "name": {
                "type": "string"
              },
              "month": {
                "type": "string"
              },
              "amount": {
                "type": "number"
              }
            },
            "required": ["id", "name", "month", "amount"]
          }
