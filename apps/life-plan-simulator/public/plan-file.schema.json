            "installmentAge60To64": {
              "type": "number"
            },
            "installmentAge65To68": {
              "type": "number"
            },
            "lumpSumToNisa": {
              "type": "number"
            },
            "lumpSumRestToTaxable": {
              "type": "boolean"
