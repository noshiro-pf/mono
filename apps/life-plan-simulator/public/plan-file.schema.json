{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "input": {
      "type": "object",
      "properties": {
        "profile": {
          "type": "object",
          "properties": {
            "birth": {
              "type": "string"
            },
            "start": {
              "type": "string"
            },
            "endAge": {
              "type": "number"
            }
          },
          "required": ["birth", "start", "endAge"]
        },
        "assumptions": {
          "type": "object",
          "properties": {
            "retirementAge": {
              "type": "number"
            },
            "pensionStartAge": {
              "type": "number"
            },
            "dcLumpSumAge": {
              "type": "number"
            },
            "livingCostInflationRate": {
              "type": "number"
            },
            "yieldWorking": {
              "type": "number"
            },
            "yieldRetired": {
              "type": "number"
            },
            "yieldSwitchAge": {
              "type": "number"
            },
            "initialCash": {
              "type": "number"
            },
            "cashThreshold": {
              "type": "number"
            },
            "cashThresholdCheckFrom": {
              "type": "string"
