              "id": {
                "type": "number"
              },
              "start": {
                "type": "string"
              },
              "annualBase": {
                "type": "number"
              },
              "companyDcMonthly": {
                "type": "number"
              },
              "idecoMonthly": {
                "type": "number"
              },
              "annualBonus": {
                "type": "number"
              }
            },
            "required": [
              "id",
              "start",
              "annualBase",
              "companyDcMonthly",
              "idecoMonthly",
              "annualBonus"
            ]
          }
        },
        "livingCosts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "number"
              },
              "category": {
                "type": "string"
              },
              "name": {
                "type": "string"
