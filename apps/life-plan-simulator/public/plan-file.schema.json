            "start": {
              "type": "string"
            },
            "initialRate": {
              "type": "number"
            },
            "rateIncreasePer5Years": {
              "type": "number"
            },
            "maxRate": {
              "type": "number"
            },
            "houseType": {
              "enum": ["long-life", "zeh", "energy-efficient", "other"]
            },
            "houseCondition": {
              "enum": ["new", "used"]
            },
            "childRearing": {
              "type": "boolean"
