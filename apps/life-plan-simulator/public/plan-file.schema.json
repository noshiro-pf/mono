          "required": [
            "retirementAge",
            "pensionStartAge",
            "dcLumpSumAge",
            "livingCostInflationRate",
            "yieldWorking",
            "yieldRetired",
            "yieldSwitchAge",
            "initialCash",
            "cashThreshold",
            "cashThresholdCheckFrom"
