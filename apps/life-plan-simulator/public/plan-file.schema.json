              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "number"
                  },
                  "name": {
                    "type": "string"
                  },
                  "month": {
                    "type": "string"
                  },
                  "amount": {
                    "type": "number"
                  }
                },
                "required": ["id", "name", "month", "amount"]
              }
            },
            "regularWithdrawals": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "number"
                  },
                  "start": {
                    "type": "string"
                  },
                  "amount": {
                    "type": "number"
                  }
                },
                "required": ["id", "start", "amount"]
              }
            },
            "oneOffWithdrawals": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "number"
                  },
                  "name": {
                    "type": "string"
                  },
                  "month": {
                    "type": "string"
                  },
                  "amount": {
                    "type": "number"
                  }
                },
                "required": ["id", "name", "month", "amount"]
              }
