{
  "extends": [
    "../../tools/configs/tsconfig/tsconfig.type-check.json",
    "../../tools/configs/tsconfig/tsconfig.vite.json"
  ],
  "compilerOptions": {
    "libReplacement": true,

    // Every code block on the site is a file in `samples/`, checked as a
    // consumer would write it: against synstate-dom-next's types.
    "jsx": "react-jsx",
    "jsxImportSource": "synstate-dom-next"
  },
  "include": ["./astro.config.mjs", "./samples", "./scripts", "./test"],
  // It imports `astro:content`, a module only Astro's own type generation
  // declares, so `tsc` cannot resolve it.
  "exclude": ["./src/content.config.ts"]
}
