rules_version = '2';

// Deployed by `deploy-firestore.yml` when a push to main changes this file
// (docs/firestore-deploy.md), on the same push that deploy-pages.yml
// publishes the app with. `pnpm run test:rules` runs nowhere in CI, so run it
// before merging a change here.
//
// Layout:
//   projects/{projectId}                        { name, ownerUid, memberUids, createdAt }
//   projects/{projectId}/tasks/{taskId}         a task, without its id
//   projects/{projectId}/milestones/{milestoneId}
//   projects/{projectId}/groups/{groupId}       a group of nodes, without its id
//   projects/{projectId}/settings/dagLayout     the DAG's direction and node positions
//
// Each user has one personal project, whose id is their uid. Membership is a
// list so that shared projects can come later without moving any data.
//
// The rules decide who may touch a project, and little more: a document's
// shape is checked by the app when it reads it (`src/repository/converters.mts`),
// and the rules and the app are deployed by separate jobs, so for a while one
// may run ahead of the other.
service cloud.firestore {
  match /databases/{database}/documents {
    // Google is the only provider the app offers (README: Firebase の手作業).
    // A token from any other provider — enabled in the console by mistake,
    // or used straight against the Auth REST API with the public config —
    // grants nothing.
    function signedIn() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'google.com';
    }

    // One's own personal project needs no lookup — and so is reachable
    // before `projects/{uid}` exists, which lets the first sign-in's
    // offline writes through. Any other project costs one read of its
    // document per request, and the batched delete in the app makes one
    // write per node whose dependencies it removes.
    function canAccess(projectId) {
      return signedIn()
        && (projectId == request.auth.uid || isMember(projectId));
    }

    function isMember(projectId) {
      return request.auth.uid in get(/databases/$(database)/documents/projects/$(projectId)).data.memberUids;
    }

    match /projects/{projectId} {
      // A user may read their own personal project before it exists (the app
      // checks for it on sign-in), and any project they are a member of.
      allow get: if signedIn()
        && (projectId == request.auth.uid
            || (resource != null
                && request.auth.uid in resource.data.memberUids));

      // Only one's own personal project, owned by oneself, with oneself as
      // the only member.
      allow create: if signedIn()
        && projectId == request.auth.uid
        && request.resource.data.keys().hasOnly(['name', 'ownerUid', 'memberUids', 'createdAt'])
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.memberUids == [request.auth.uid];

      match /tasks/{taskId} {
        allow read, write: if canAccess(projectId);
      }

      match /milestones/{milestoneId} {
        allow read, write: if canAccess(projectId);
      }

      match /groups/{groupId} {
        allow read, write: if canAccess(projectId);
      }

      match /settings/{docId} {
        allow read, write: if canAccess(projectId);
      }
    }

    // Everything else — listing projects, updating or deleting one, any
    // other collection — is denied.
  }
}
