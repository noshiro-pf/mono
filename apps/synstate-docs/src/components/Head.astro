---
import Default from '@astrojs/starlight/components/Head.astro';
import { toOgImageSlug } from '../lib/og-image-slug.mjs';

const route = Astro.locals.starlightRoute;

const ogSlug = toOgImageSlug(route.entry.id);
const ogImageUrl = new URL(`${import.meta.env.BASE_URL}og/${ogSlug}.png`, Astro.site);

const imageAlt = route.entry.data.description ?? `${route.entry.data.title} — SynState`;
---

<Default><slot /></Default>
<meta property="og:image" content={ogImageUrl.href} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:type" content="image/png" />
<meta property="og:image:alt" content={imageAlt} />
<meta name="twitter:image" content={ogImageUrl.href} />
<meta name="twitter:image:alt" content={imageAlt} />
