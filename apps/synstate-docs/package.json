{
  "name": "@synstate/docs",
  "version": "0.0.12",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/noshiro-pf/mono.git",
    "directory": "apps/synstate-docs"
  },
  "type": "module",
  "scripts": {
    "build": "run-s doc build:astro",
    "build:astro": "astro build",
    "check:lint": "eslint .",
    "check:types": "tsc --noEmit",
    "dev": "astro dev",
    "doc": "run-s gen:bundle-size gen:jsdoc-examples gen:jsdoc gen:readme fix:fmt",
    "fix:fmt": "tsx --tsconfig ../../tools/configs/tsconfig.tsx.json ../../libs/ts-repo-utils/src/cmd/format-uncommitted.mts --cwd .",
    "fix:fmt:diff": "tsx --tsconfig ../../tools/configs/tsconfig.tsx.json ../../libs/ts-repo-utils/src/cmd/format-diff-from.mts origin/main --cwd .",
    "fix:fmt:full": "pnpm run z:prettier .",
    "fix:lint": "eslint . --fix",
    "fmt": "pnpm run fix:fmt",
    "gen": "run-s gen:bundle-size gen:jsdoc-examples gen:jsdoc gen:readme gen:benchmark-doc fix:fmt",
    "gen:benchmark-doc": "tsx --tsconfig ../../tools/configs/tsconfig.tsx.json ./scripts/embed-benchmark.mts",
    "gen:bundle-size": "tsx --tsconfig ../../tools/configs/tsconfig.tsx.json ./scripts/embed-bundle-size.mts",
    "gen:jsdoc": "tsx --tsconfig ../../tools/configs/tsconfig.tsx.json ./scripts/embed-jsdoc-descriptions.mts",
    "gen:jsdoc-examples": "tsx --tsconfig ../../tools/configs/tsconfig.tsx.json ./scripts/embed-jsdoc-examples.mts",
    "gen:readme": "tsx --tsconfig ../../tools/configs/tsconfig.tsx.json ./scripts/embed-examples.mts",
    "preview": "astro preview",
    "watch:types": "tsc --noEmit --watch",
    "z:prettier": "prettier --config ../../.prettierrc --ignore-path ../../.prettierignore --ignore-path ../../.gitignore --ignore-unknown --no-error-on-unmatched-pattern --write"
  },
  "dependencies": {
    "@astrojs/preact": "^6.0.5",
    "@astrojs/react": "^6.0.5",
    "@astrojs/starlight": "^0.42.0",
    "@fontsource/noto-sans-jp": "^5.3.0",
    "@preact/signals": "^2.11.2",
    "@resvg/resvg-js": "^2.6.2",
    "astro": "^7.3.1",
    "preact": "^10.29.8",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "satori": "^0.33.4",
    "synstate": "workspace:*",
    "synstate-preact-hooks": "workspace:*",
    "synstate-preact-signals": "workspace:*",
    "synstate-react-hooks": "workspace:*"
  },
  "devDependencies": {
    "@astrojs/markdown-remark": "7.3.0",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "esbuild": "catalog:",
    "eslint-config-typed": "workspace:*",
    "eslint-plugin-ts-data-forge": "workspace:*",
    "eslint-plugin-ts-fortress": "workspace:*",
    "eslint-plugin-ts-type-forge": "workspace:*",
    "jotai": "catalog:",
    "mobx": "catalog:",
    "prettier": "catalog:",
    "prettier-plugin-organize-imports": "catalog:",
    "prettier-plugin-packagejson": "catalog:",
    "rxjs": "catalog:",
    "ts-data-forge": "workspace:*",
    "ts-repo-utils": "workspace:*"
  }
}
