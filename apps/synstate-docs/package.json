{
  "name": "@synstate/docs",
  "version": "0.0.6",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/noshiro-pf/mono.git",
    "directory": "apps/synstate-docs"
  },
  "type": "module",
  "scripts": {
    "build": "run-s doc type-check build:astro",
    "build:astro": "astro build",
    "dev": "astro dev",
    "doc": "run-s doc:embed:bundle-size doc:embed:jsdoc-examples doc:embed:jsdoc doc:embed fmt",
    "doc:embed": "tsx --tsconfig ../../tools/configs/tsconfig.tsx.json ./scripts/embed-examples.mts",
    "doc:embed:benchmark": "tsx --tsconfig ../../tools/configs/tsconfig.tsx.json ./scripts/embed-benchmark.mts",
    "doc:embed:bundle-size": "tsx --tsconfig ../../tools/configs/tsconfig.tsx.json ./scripts/embed-bundle-size.mts",
    "doc:embed:jsdoc": "tsx --tsconfig ../../tools/configs/tsconfig.tsx.json ./scripts/embed-jsdoc-descriptions.mts",
    "doc:embed:jsdoc-examples": "tsx --tsconfig ../../tools/configs/tsconfig.tsx.json ./scripts/embed-jsdoc-examples.mts",
    "fmt": "tsx --tsconfig ../../tools/configs/tsconfig.tsx.json ../../libs/ts-repo-utils/src/cmd/format-uncommitted.mts --cwd .",
    "fmt:diff": "tsx --tsconfig ../../tools/configs/tsconfig.tsx.json ../../libs/ts-repo-utils/src/cmd/format-diff-from.mts origin/main --cwd .",
    "fmt:full": "pnpm run z:prettier .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "preview": "astro preview",
    "tsc": "tsc --noEmit",
    "tscw": "tsc --noEmit --watch",
    "type-check": "tsc --noEmit",
    "z:prettier": "prettier --config ../../.prettierrc --ignore-path ../../.prettierignore --ignore-path ../../.gitignore --ignore-unknown --no-error-on-unmatched-pattern --write"
  },
  "dependencies": {
    "@astrojs/preact": "^6.0.2",
    "@astrojs/react": "^6.0.2",
    "@astrojs/starlight": "^0.41.6",
    "@fontsource/noto-sans-jp": "^5.3.0",
    "@preact/signals": "^2.10.1",
    "@resvg/resvg-js": "^2.6.2",
    "astro": "^7.1.6",
    "preact": "^10.29.8",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "satori": "^0.29.0",
    "synstate": "workspace:*",
    "synstate-preact-hooks": "workspace:*",
    "synstate-preact-signals": "workspace:*",
    "synstate-react-hooks": "workspace:*"
  },
  "devDependencies": {
    "@astrojs/markdown-remark": "7.2.2",
    "@types/react": "catalog:",
    "@types/react-dom": "19.2.4",
    "esbuild": "catalog:",
    "eslint-config-typed": "workspace:*",
    "eslint-plugin-ts-data-forge": "workspace:*",
    "eslint-plugin-ts-fortress": "workspace:*",
    "eslint-plugin-ts-type-forge": "workspace:*",
    "jotai": "catalog:",
    "mobx": "catalog:",
    "prettier": "catalog:",
    "prettier-plugin-organize-imports": "catalog:",
    "prettier-plugin-packagejson": "catalog:",
    "rxjs": "catalog:",
    "ts-data-forge": "workspace:*",
    "ts-repo-utils": "workspace:*"
  }
}
