{
  "name": "event-schedule-app",
  "version": "0.0.40",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/noshiro-pf/mono.git",
    "directory": "apps/event-schedule-app"
  },
  "license": "Apache-2.0",
  "author": "noshiro-pf <noshiro.pf@gmail.com>",
  "type": "module",
  "scripts": {
    "build": "vite build --config ./configs/vite.config.mts",
    "check:e2e": "playwright test --config ./configs/playwright.config.mts",
    "check:e2e:emulators": "pnpm --dir ../event-schedule-app-functions run build && firebase emulators:exec --project demo-event-schedule-app --only auth,functions,firestore,pubsub \"playwright test --config ./configs/playwright.emulators.config.mts\"",
    "check:e2e:production": "playwright test --config ./configs/playwright.production.config.mts",
    "check:lint": "node ../../tools/scripts/cmd/assert-deps-built.mts && oxlint . && eslint .",
    "check:test": "node ../../tools/scripts/cmd/assert-deps-built.mts && vitest --config ./configs/vitest.config.mts run",
    "check:test:rules": "node ../../tools/scripts/cmd/assert-deps-built.mts && firebase emulators:exec --only firestore --project demo-event-schedule-app \"vitest --config ./configs/vitest.rules.config.mts run\"",
    "check:types": "node ../../tools/scripts/cmd/assert-deps-built.mts && node ../../node_modules/typescript-native/bin/tsc --noEmit",
    "dev": "vite --config ./configs/vite.config.mts",
    "emulators": "pnpm --dir ../event-schedule-app-functions run build && firebase emulators:start --project demo-event-schedule-app --only auth,functions,firestore,pubsub --import ./emulator-data --export-on-exit",
    "fix:fmt": "pnpm run z:format-uncommitted --cwd .",
    "fix:fmt:diff": "pnpm run z:format-diff-from origin/main --cwd .",
    "fix:fmt:full": "tsx --tsconfig ../../tools/configs/tsconfig.tsx.json ../../tools/scripts/cmd/format-package.mts",
    "fix:lint": "node ../../tools/scripts/cmd/assert-deps-built.mts && oxlint . --fix && eslint . --fix",
    "fmt": "pnpm run fix:fmt",
    "gen": "run-s gen:index gen:css-module-types",
    "gen:css-module-types": "tsx --tsconfig ../../tools/configs/tsconfig.tsx.json ./scripts/cmd/gen-css-module-types.mts",
    "gen:index": "run-s gen:index:src fix:fmt",
    "gen:index:src": "pnpm run z:gen-index-ts ./src --index-ext .mts --export-ext .mjs --target-ext .mts --target-ext .tsx --min-depth 1 --exclude 'assets/**' --preserve 'utils-ported/index.mts'",
    "preview": "vite preview --config ./configs/vite.config.mts",
    "test": "pnpm run check:test",
    "watch:test": "vitest --config ./configs/vitest.config.mts watch",
    "watch:types": "node ../../node_modules/typescript-native/bin/tsc --noEmit --watch -p ./tsconfig.json",
    "z:format-diff-from": "tsx --tsconfig ../../tools/configs/tsconfig.tsx.json ../../libs/ts-repo-utils/src/cmd/format-diff-from.mts",
    "z:format-uncommitted": "tsx --tsconfig ../../tools/configs/tsconfig.tsx.json ../../libs/ts-repo-utils/src/cmd/format-uncommitted.mts",
    "z:gen-index-ts": "tsx --tsconfig ../../tools/configs/tsconfig.tsx.json ../../libs/ts-repo-utils/src/cmd/gen-index-ts.mts"
  },
  "dependencies": {
    "@blueprintjs/core": "^6.21.0",
    "@blueprintjs/datetime": "^6.3.0",
    "blueprint-synstate": "workspace:*",
    "event-schedule-app-shared": "workspace:*",
    "firebase": "^12.19.0",
    "html2canvas": "^1.4.1",
    "normalize.css": "^8.0.1",
    "synstate": "workspace:*",
    "synstate-dom": "workspace:*",
    "synstate-router": "workspace:*",
    "synstate-router-dom": "workspace:*",
    "ts-data-forge": "workspace:*",
    "ts-fortress": "workspace:*",
    "ts-fortress-types": "workspace:*"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "catalog:",
    "dedent": "catalog:",
    "eslint": "catalog:",
    "eslint-config-typed": "workspace:*",
    "eslint-plugin-ts-data-forge": "workspace:*",
    "eslint-plugin-ts-fortress": "workspace:*",
    "eslint-plugin-ts-type-forge": "workspace:*",
    "firebase-tools": "catalog:",
    "npm-run-all2": "catalog:",
    "prettier-plugin-organize-imports": "catalog:",
    "prettier-plugin-packagejson": "catalog:",
    "ts-type-forge": "workspace:*",
    "tsx": "catalog:",
    "vite": "catalog:"
  }
}
