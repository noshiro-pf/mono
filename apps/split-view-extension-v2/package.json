{
  "name": "split-view-extension-v2",
  "version": "0.9.5",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/noshiro-pf/mono.git",
    "directory": "apps/split-view-extension-v2"
  },
  "license": "Apache-2.0",
  "author": "noshiro-pf <noshiro.pf@gmail.com>",
  "type": "module",
  "scripts": {
    "build": "run-s build:page build:frame-agent build:github-button",
    "build:dev": "run-s build:page:dev build:frame-agent build:github-button",
    "build:frame-agent": "vite build --config ./configs/vite.frame-agent.config.mts",
    "build:github-button": "vite build --config ./configs/vite.github-button.config.mts",
    "build:page": "vite build --config ./configs/vite.config.mts",
    "build:page:dev": "vite build --mode development --config ./configs/vite.config.mts",
    "check:e2e": "playwright test --config ./configs/playwright.config.mts",
    "check:lint": "node ../../tools/scripts/cmd/assert-deps-built.mts && oxlint . && eslint .",
    "check:test": "node ../../tools/scripts/cmd/assert-deps-built.mts && vitest --config ./configs/vitest.config.mts run",
    "check:types": "node ../../tools/scripts/cmd/assert-deps-built.mts && node ../../node_modules/typescript-native/bin/tsc --noEmit",
    "fix:fmt": "pnpm run z:format-uncommitted --cwd .",
    "fix:fmt:diff": "pnpm run z:format-diff-from origin/main --cwd .",
    "fix:fmt:full": "tsx --tsconfig ../../tools/configs/tsconfig.tsx.json ../../tools/scripts/cmd/format-package.mts",
    "fix:lint": "node ../../tools/scripts/cmd/assert-deps-built.mts && oxlint . --fix && eslint . --fix",
    "fmt": "pnpm run fix:fmt",
    "gen": "run-s gen:index gen:icons",
    "gen:icons": "tsx --tsconfig ../../tools/configs/tsconfig.tsx.json ./scripts/gen-icons.mts",
    "gen:index": "run-s gen:index:src fix:fmt",
    "gen:index:src": "pnpm run z:gen-index-ts ./src --index-ext .mts --export-ext .mjs --target-ext .mts --target-ext .tsx --min-depth 1 --exclude '**/main.mts' --exclude '**/main.tsx'",
    "pack": "run-s build z:pack",
    "pack:crx": "run-s build z:pack-crx",
    "screenshots": "run-s build z:screenshots",
    "screenshots:light": "run-s build \"z:screenshots --light\"",
    "test": "pnpm run check:test",
    "watch:test": "vitest --config ./configs/vitest.config.mts watch",
    "watch:types": "node ../../node_modules/typescript-native/bin/tsc --noEmit --watch -p ./tsconfig.json",
    "z:format-diff-from": "tsx --tsconfig ../../tools/configs/tsconfig.tsx.json ../../libs/ts-repo-utils/src/cmd/format-diff-from.mts",
    "z:format-uncommitted": "tsx --tsconfig ../../tools/configs/tsconfig.tsx.json ../../libs/ts-repo-utils/src/cmd/format-uncommitted.mts",
    "z:gen-index-ts": "tsx --tsconfig ../../tools/configs/tsconfig.tsx.json ../../libs/ts-repo-utils/src/cmd/gen-index-ts.mts",
    "z:pack": "tsx --tsconfig ../../tools/configs/tsconfig.tsx.json ./scripts/pack.mts",
    "z:pack-crx": "tsx --tsconfig ../../tools/configs/tsconfig.tsx.json ./scripts/pack-crx.mts",
    "z:screenshots": "tsx --tsconfig ../../tools/configs/tsconfig.tsx.json ./scripts/screenshots.mts"
  },
  "dependencies": {
    "split-view-link": "workspace:*",
    "synstate": "workspace:*",
    "synstate-dom": "workspace:*",
    "ts-data-forge": "workspace:*"
  },
  "devDependencies": {
    "@playwright/test": "catalog:",
    "@types/chrome": "^0.3.6",
    "eslint": "catalog:",
    "eslint-config-typed": "workspace:*",
    "eslint-plugin-ts-data-forge": "workspace:*",
    "npm-run-all2": "catalog:",
    "prettier-plugin-organize-imports": "catalog:",
    "prettier-plugin-packagejson": "catalog:",
    "ts-type-forge": "workspace:*",
    "tsx": "catalog:",
    "vite": "catalog:"
  }
}
