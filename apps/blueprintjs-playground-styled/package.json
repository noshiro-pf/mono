{
  "name": "blueprintjs-playground-styled",
  "version": "0.0.8",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/noshiro-pf/mono.git",
    "directory": "apps/blueprintjs-playground-styled"
  },
  "license": "Apache-2.0",
  "author": "noshiro-pf <noshiro.pf@gmail.com>",
  "type": "module",
  "scripts": {
    "build": "vite build --config ./configs/vite.config.mts",
    "check:e2e": "playwright test --config ./configs/playwright.config.mts",
    "check:lint": "eslint .",
    "check:types": "node ../../node_modules/typescript-native/bin/tsc --noEmit",
    "dev": "vite --config ./configs/vite.config.mts",
    "fix:fmt": "pnpm run z:format-uncommitted --cwd .",
    "fix:fmt:diff": "pnpm run z:format-diff-from origin/main --cwd .",
    "fix:fmt:full": "prettier --write .",
    "fix:lint": "eslint . --fix",
    "fmt": "pnpm run fix:fmt",
    "gen": "run-s gen:index",
    "gen:index": "run-s gen:index:src fix:fmt",
    "gen:index:src": "pnpm run z:gen-index-ts ./src --index-ext .mts --export-ext .mjs --target-ext .mts --target-ext .tsx --min-depth 1",
    "preview": "vite preview --config ./configs/vite.config.mts",
    "watch:types": "node ../../node_modules/typescript-native/bin/tsc --noEmit --watch -p ./tsconfig.json",
    "z:format-diff-from": "tsx --tsconfig ../../tools/configs/tsconfig.tsx.json ../../libs/ts-repo-utils/src/cmd/format-diff-from.mts",
    "z:format-uncommitted": "tsx --tsconfig ../../tools/configs/tsconfig.tsx.json ../../libs/ts-repo-utils/src/cmd/format-uncommitted.mts",
    "z:gen-index-ts": "tsx --tsconfig ../../tools/configs/tsconfig.tsx.json ../../libs/ts-repo-utils/src/cmd/gen-index-ts.mts"
  },
  "dependencies": {
    "@blueprintjs/core": "^6.19.0",
    "@blueprintjs/icons": "^6.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "normalize.css": "^8.0.1",
    "react-blueprintjs-utils": "workspace:*",
    "react-utils": "workspace:*"
  },
  "devDependencies": {
    "@playwright/test": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "eslint": "catalog:",
    "eslint-config-typed": "workspace:*",
    "eslint-plugin-ts-data-forge": "workspace:*",
    "eslint-plugin-ts-type-forge": "workspace:*",
    "npm-run-all2": "catalog:",
    "prettier": "catalog:",
    "prettier-plugin-organize-imports": "catalog:",
    "prettier-plugin-packagejson": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tsx": "catalog:",
    "vite": "catalog:"
  }
}
